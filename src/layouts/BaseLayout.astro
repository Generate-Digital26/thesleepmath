---
import '@/styles/global.css';
import { KIT_FORM_ID, KIT_API_KEY } from '@/config/newsletter';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Free sleep calculators backed by peer-reviewed research. Chronotype quiz, caffeine cutoff, sleep debt tracker, and more.',
  canonical,
} = Astro.props;

const siteUrl = 'https://thesleepmath.com';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;

// Site-wide structured data
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'The Sleep Math',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: 'Free sleep calculators backed by peer-reviewed research.',
  sameAs: [],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'The Sleep Math',
  url: siteUrl,
  description,
  publisher: {
    '@type': 'Organization',
    name: 'The Sleep Math',
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/#calcs`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Sora:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="The Sleep Math" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-C29E2KH48G"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-C29E2KH48G');
    </script>
  </head>
  <body>
    <slot />

    <!-- Kit (ConvertKit) newsletter handler — works on any form with data-kit-form -->
    <script define:vars={{ KIT_FORM_ID, KIT_API_KEY }} is:inline>
      // Expose for pages that need programmatic access (e.g. chronotype quiz)
      window.__KIT_FORM_ID = KIT_FORM_ID;
      window.__KIT_API_KEY = KIT_API_KEY;
    </script>
    <script define:vars={{ KIT_FORM_ID, KIT_API_KEY }} is:inline>
      (function () {
        var API = 'https://api.convertkit.com/v3/forms/' + KIT_FORM_ID + '/subscribe';

        document.addEventListener('submit', function (e) {
          var form = e.target.closest('[data-kit-form]');
          if (!form) return;
          e.preventDefault();

          var input = form.querySelector('input[type="email"]');
          var btn = form.querySelector('button[type="submit"]');
          var note = form.querySelector('[data-kit-note]');
          var email = (input && input.value || '').trim();
          if (!email) return;

          // Loading state
          if (btn) { btn.disabled = true; btn.dataset.origText = btn.textContent; btn.textContent = 'Subscribing…'; }
          if (note) { note.textContent = ''; note.className = note.className.replace(/\s*kit-(success|error)/g, ''); }

          fetch(API, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ api_key: KIT_API_KEY, email: email }),
          })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
            .then(function (res) {
              if (res.ok && res.data.subscription) {
                if (note) { note.textContent = 'You’re in! Check your inbox to confirm.'; note.classList.add('kit-success'); }
                if (input) input.value = '';
                // GA4 event
                if (typeof gtag === 'function') gtag('event', 'newsletter_subscribe', { method: 'kit' });
              } else {
                throw new Error(res.data.message || 'Subscription failed');
              }
            })
            .catch(function (err) {
              if (note) { note.textContent = err.message || 'Something went wrong — try again.'; note.classList.add('kit-error'); }
            })
            .finally(function () {
              if (btn) { btn.disabled = false; btn.textContent = btn.dataset.origText || 'Subscribe'; }
            });
        });
      })();
    </script>
  </body>
</html>

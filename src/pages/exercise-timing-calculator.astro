</style>

<script is:inline>
(function () {

  /* ===== CHRONOTYPE DATA ===== */
  /* Each chronotype: cortisol peak hour, melatonin onset hour, typical bedtime, typical wake time */
  var CHRONO = {
    lion:    { name: 'Lion',    cortisolPeak: 6,  melatoninOnset: 20, bedtime: 21.5, wake: 5.5,  phase: 'early'   },
    bear:    { name: 'Bear',    cortisolPeak: 8,  melatoninOnset: 22, bedtime: 23,   wake: 7,    phase: 'mid'     },
    wolf:    { name: 'Wolf',    cortisolPeak: 10, melatoninOnset: 24, bedtime: 24.5, wake: 8.5,  phase: 'late'    },
    dolphin: { name: 'Dolphin', cortisolPeak: 8,  melatoninOnset: 22, bedtime: 23.5, wake: 6.5,  phase: 'variable'},
  };

  /* ===== EXERCISE TYPE DATA ===== */
  /* Each type: intensity (0-1), min buffer before bed (min), recovery multiplier */
  var EXTYPE = {
    cardio:   { name: 'Cardio',   intensity: 0.65, minBuffer: 60,  label: 'Moderate cardio'   },
    strength: { name: 'Strength', intensity: 0.60, minBuffer: 60,  label: 'Strength training' },
    yoga:     { name: 'Yoga',     intensity: 0.20, minBuffer: 20,  label: 'Yoga / stretching'  },
    hiit:     { name: 'HIIT',     intensity: 0.90, minBuffer: 90,  label: 'HIIT'               },
  };

  /* FITNESS multiplier on recovery time */
  var FITNESS_MULT = { beginner: 1.25, intermediate: 1.0, advanced: 0.8 };

  /* ===== STATE ===== */
  var state = {
    chronotype: 'bear',
    extype: 'cardio',
    duration: 45,
    fitness: 'intermediate',
    bedtimeMinutes: 23 * 60,
  };

  /* ===== DOM ===== */
  var chronoGrid   = document.getElementById('chrono-grid');
  var typeToggle   = document.getElementById('type-toggle');
  var durationSel  = document.getElementById('duration');
  var fitnessSel   = document.getElementById('fitness');
  var bedtimeInput = document.getElementById('bedtime');
  var resultsSummary = document.getElementById('results-summary');
  var windowsGrid  = document.getElementById('windows-grid');
  var dayTimeline  = document.getElementById('day-timeline');
  var impactCard   = document.getElementById('impact-card');
  var tipText      = document.getElementById('tip-text');

  /* ===== HELPERS ===== */
  function mod24(h) { return ((h % 24) + 24) % 24; }

  function fmt12h(decimalHour) {
    var h = mod24(decimalHour);
    var hr = Math.floor(h);
    var min = Math.round((h - hr) * 60);
    if (min === 60) { hr++; min = 0; hr = hr % 24; }
    var period = hr >= 12 ? 'PM' : 'AM';
    var hh = hr % 12; if (hh === 0) hh = 12;
    return hh + ':' + (min < 10 ? '0' : '') + min + ' ' + period;
  }

  function parseTimeInput(val) {
    /* "HH:MM" -> decimal hours */
    var parts = val.split(':').map(Number);
    return parts[0] + parts[1] / 60;
  }

  /* ===== CORE CALCULATION ===== */
  function calcWindows() {
    var ch  = CHRONO[state.chronotype];
    var ex  = EXTYPE[state.extype];
    var dur = state.duration / 60; /* hours */
    var bedH = state.bedtimeMinutes / 60;
    var mult = FITNESS_MULT[state.fitness];

    /* Effective buffer (minutes) based on intensity and fitness */
    var effectiveBufferH = (ex.minBuffer * mult) / 60;

    /* Latest SAFE end time for exercise */
    var latestEndH = bedH - effectiveBufferH;

    /* Latest safe START time */
    var latestStartH = latestEndH - dur;

    /* Define three exercise windows for this chronotype */
    /* Window 1: Morning — around cortisol peak */
    var morningStart = ch.cortisolPeak - 0.5;
    var morningEnd   = morningStart + dur;

    /* Window 2: Afternoon — body temp peak zone (2-4 hrs before temp drop / ~4-6pm universal, shifted by chrono) */
    var tempPeakH    = ch.cortisolPeak + 8; /* body temp peaks ~8h after cortisol */
    var afternoonStart = tempPeakH - 1;
    var afternoonEnd   = afternoonStart + dur;

    /* Window 3: Evening — close to bed buffer */
    var eveningStart = latestStartH;
    var eveningEnd   = eveningStart + dur;

    /* Score each window */
    function scoreWindow(startH, endH) {
      var midH = (startH + endH) / 2;
      var endFromBed = bedH - endH; /* hours before bed that exercise ends */

      /* Core temp bonus: peaking near ch temp peak is good */
      var tempScore = Math.max(0, 1 - Math.abs(midH - tempPeakH) / 4);

      /* Buffer penalty: if finishing too close to bed */
      var bufferScore = endFromBed >= effectiveBufferH
        ? 1
        : Math.max(0, endFromBed / effectiveBufferH);

      /* Cortisol alignment: morning sessions get testosterone bonus for strength */
      var cortisolBonus = (state.extype === 'strength' && Math.abs(midH - ch.cortisolPeak) < 2) ? 0.15 : 0;

      /* Wolf/dolphin evening resilience bonus */
      var eveningBonus = (state.chronotype === 'wolf' && endFromBed >= 1.5) ? 0.1 : 0;

      var raw = (tempScore * 0.45 + bufferScore * 0.55 + cortisolBonus + eveningBonus);
      return Math.min(1, raw);
    }

    var windows = [
      {
        id: 'morning',
        startH: morningStart,
        endH: morningEnd,
        score: scoreWindow(morningStart, morningEnd),
        label: 'Morning',
        reason: morningReason(ch),
      },
      {
        id: 'afternoon',
        startH: afternoonStart,
        endH: afternoonEnd,
        score: scoreWindow(afternoonStart, afternoonEnd),
        label: 'Afternoon',
        reason: afternoonReason(ch, ex),
      },
      {
        id: 'evening',
        startH: eveningStart,
        endH: eveningEnd,
        score: scoreWindow(eveningStart, eveningEnd),
        label: 'Evening',
        reason: eveningReason(ch, ex, effectiveBufferH, bedH),
      },
    ];

    /* Sort by score descending */
    windows.sort(function(a, b) { return b.score - a.score; });

    /* Classify */
    windows.forEach(function(w) {
      if (w.score >= 0.70)      { w.rating = 'optimal';    w.ratingLabel = 'Optimal';    }
      else if (w.score >= 0.45) { w.rating = 'acceptable'; w.ratingLabel = 'Acceptable'; }
      else                      { w.rating = 'avoid';      w.ratingLabel = 'Avoid';      }
    });

    return {
      windows: windows,
      latestEndH: latestEndH,
      latestStartH: latestStartH,
      effectiveBufferH: effectiveBufferH,
      tempPeakH: tempPeakH,
      ch: ch,
      ex: ex,
      dur: dur,
      bedH: bedH,
    };
  }

  function morningReason(ch) {
    var map = {
      lion:    'Aligns with your early cortisol peak — highest energy and testosterone for the day.',
      bear:    'Cortisol is rising. Good for moderate sessions; aerobic output is solid by 8 AM.',
      wolf:    'Your cortisol is still low in early morning. Expect reduced power output.',
      dolphin: 'Variable arousal. May feel sluggish early; monitor HRV before committing to intensity.',
    };
    return map[state.chronotype];
  }

  function afternoonReason(ch, ex) {
    if (ex.intensity >= 0.8) {
      return 'Body temp near daily peak — ideal for HIIT performance. Large buffer before bed.';
    }
    if (ex.intensity <= 0.3) {
      return 'Yoga here is excellent; temperature rise aids flexibility and parasympathetic recovery follows.';
    }
    return 'Body temperature near peak for your chronotype — optimal muscle function, reaction time, and VO2 max.';
  }

  function eveningReason(ch, ex, bufH, bedH) {
    var bufMin = Math.round(bufH * 60);
    if (ex.intensity >= 0.8) {
      return 'HIIT close to bed carries disruption risk. Ensure ' + bufMin + ' min between end and lights-out.';
    }
    if (ex.intensity <= 0.3) {
      return 'Gentle evening yoga can shorten sleep onset. This window works well for your chronotype.';
    }
    return 'Acceptable if you finish ' + bufMin + ' min before bed and keep intensity moderate.';
  }

  /* ===== RENDER ===== */
  function render() {
    var data = calcWindows();
    renderSummary(data);
    renderWindows(data);
    renderTimeline(data);
    renderImpact(data);
    updateTip(data);
  }

  function renderSummary(data) {
    var best = data.windows[0];
    var html = '';
    html += '<div class="summary-label">Top recommendation for ' + CHRONO[state.chronotype].name + ' chronotype</div>';
    html += '<div class="summary-main">' + best.label + ' workout ' + fmt12h(best.startH) + '–' + fmt12h(best.endH) + '</div>';
    html += '<div class="summary-sub">' + EXTYPE[state.extype].name + ' · ' + state.duration + ' min · Finish ' + Math.round(data.effectiveBufferH * 60) + ' min before bed</div>';
    resultsSummary.innerHTML = html;
  }

  function renderWindows(data) {
    var html = '';
    data.windows.forEach(function(w) {
      var badgeClass = 'badge-' + w.rating;
      var cardClass  = 'w-' + w.rating;
      html += '<div class="window-card ' + cardClass + '">';
      html += '<div class="window-badge ' + badgeClass + '">';
      html += '<svg viewBox="0 0 8 8" fill="currentColor"><circle cx="4" cy="4" r="3"/></svg>';
      html += w.ratingLabel;
      html += '</div>';
      html += '<div class="window-time">' + fmt12h(w.startH) + '</div>';
      html += '<div class="window-range">' + w.label + ' · until ' + fmt12h(w.endH) + '</div>';
      html += '<div class="window-reason">' + w.reason + '</div>';
      html += '</div>';
    });
    windowsGrid.innerHTML = html;
  }

  function renderTimeline(data) {
    /* 24-hour bar from 0 to 24 */
    /* Each segment is a portion of the 24h bar */
    /* We show: sleep window (purple), exercise windows (color-coded), rest (light) */
    var bedH  = data.bedH;
    var wakeH = CHRONO[state.chronotype].wake;

    /* Build segments array: {startH, endH, color, label} */
    var segs = [];

    /* Sleep block */
    if (wakeH < bedH) {
      /* Sleep crosses midnight: 0 -> wakeH, bedH -> 24 */
      segs.push({ s: 0,     e: wakeH, color: '#c4b5fd', label: 'Sleep' });
      segs.push({ s: wakeH, e: bedH,  color: '#f0eef5', label: 'Awake' });
      segs.push({ s: bedH,  e: 24,    color: '#c4b5fd', label: 'Sleep' });
    } else {
      /* Normal day: wakeH -> bedH awake */
      segs.push({ s: 0,     e: wakeH, color: '#c4b5fd', label: 'Sleep' });
      segs.push({ s: wakeH, e: bedH,  color: '#f0eef5', label: 'Awake' });
      segs.push({ s: bedH,  e: 24,    color: '#c4b5fd', label: 'Sleep' });
    }

    /* Overlay exercise windows */
    var winColors = { optimal: '#10b981', acceptable: '#f59e0b', avoid: '#ff6b52' };

    data.windows.forEach(function(w) {
      /* Clamp to 0-24 */
      var s = Math.max(0, w.startH);
      var e = Math.min(24, w.endH);
      if (s < e) {
        segs.push({ s: s, e: e, color: winColors[w.rating], label: w.label + ' (' + w.ratingLabel + ')' });
      }
    });

    /* Sort and build bar */
    segs.sort(function(a, b) { return a.s - b.s; });

    /* Flatten overlapping segments: later segs (exercise) override earlier (background) */
    /* Simple approach: build 2880 quarter-minute slots, fill, then compress */
    var slots = new Array(1440);
    var defaultColor = '#f0eef5';
    for (var i = 0; i < 1440; i++) {
      slots[i] = { color: defaultColor, label: 'Awake' };
    }

    /* Fill sleep first */
    if (wakeH <= bedH) {
      for (var i = 0; i < Math.round(wakeH * 60); i++) slots[i] = { color: '#c4b5fd', label: 'Sleep' };
      for (var i = Math.round(bedH * 60); i < 1440; i++) slots[i] = { color: '#c4b5fd', label: 'Sleep' };
    } else {
      for (var i = Math.round(wakeH * 60); i < Math.round(bedH * 60); i++) slots[i] = { color: '#c4b5fd', label: 'Sleep' };
    }

    /* Overlay exercise windows */
    data.windows.forEach(function(w) {
      var s = Math.max(0, Math.round(w.startH * 60));
      var e = Math.min(1440, Math.round(w.endH * 60));
      var c = winColors[w.rating];
      var lbl = w.label + ' (' + w.ratingLabel + ') ' + fmt12h(w.startH) + '–' + fmt12h(w.endH);
      for (var i = s; i < e; i++) slots[i] = { color: c, label: lbl };
    });

    /* Compress into runs */
    var runs = [];
    var cur = slots[0];
    var runLen = 1;
    for (var i = 1; i < 1440; i++) {
      if (slots[i].color === cur.color) {
        runLen++;
      } else {
        runs.push({ pct: (runLen / 1440 * 100).toFixed(3), color: cur.color, label: cur.label });
        cur = slots[i];
        runLen = 1;
      }
    }
    runs.push({ pct: (runLen / 1440 * 100).toFixed(3), color: cur.color, label: cur.label });

    /* Build HTML */
    var html = '<div class="dt-bar-wrap">';
    runs.forEach(function(r) {
      html += '<div class="dt-seg" style="flex:' + parseFloat(r.pct) + ';background:' + r.color + '" title="' + r.label + '">';
      html += '<span class="dt-tooltip">' + r.label + '</span>';
      html += '</div>';
    });
    html += '</div>';

    /* Time labels: 12 AM, 6 AM, 12 PM, 6 PM, 12 AM */
    html += '<div class="dt-labels">';
    ['12 AM', '6 AM', '12 PM', '6 PM', '12 AM'].forEach(function(t) {
      html += '<span>' + t + '</span>';
    });
    html += '</div>';

    dayTimeline.innerHTML = html;
  }

  function renderImpact(data) {
    var ex = EXTYPE[state.extype];
    var ch = CHRONO[state.chronotype];
    var best = data.windows[0];
    var worstScore = Math.min.apply(null, data.windows.map(function(w) { return w.score; }));

    /* Compute impact metrics based on best window */
    var sleepOnset    = Math.round((1 - best.score * 0.4) * 25 + 5);   /* minutes to fall asleep */
    var swsBoost      = Math.round(best.score * 18);                     /* % improvement in slow-wave */
    var remQuality    = Math.round(50 + best.score * 40);               /* % of optimal REM */
    var nextDayAlert  = Math.round(55 + best.score * 35);               /* % next-day alertness */

    var html = '<div class="impact-title">Projected sleep impact — optimal window</div>';
    html += '<div class="impact-rows">';

    var rows = [
      { label: 'Sleep onset latency', val: sleepOnset + ' min', barPct: Math.round((1 - (sleepOnset - 5) / 25) * 100), color: '#7c6aff' },
      { label: 'Slow-wave sleep boost', val: '+' + swsBoost + '%', barPct: swsBoost / 20 * 100, color: '#10b981' },
      { label: 'REM quality index', val: remQuality + '%', barPct: remQuality, color: '#38b6ff' },
      { label: 'Next-day alertness', val: nextDayAlert + '%', barPct: nextDayAlert, color: '#f59e0b' },
    ];

    rows.forEach(function(r) {
      html += '<div class="impact-row">';
      html += '<div class="impact-row-label">' + r.label + '</div>';
      html += '<div class="impact-bar-bg"><div class="impact-bar-fill" style="width:' + Math.min(100, r.barPct) + '%;background:' + r.color + '"></div></div>';
      html += '<div class="impact-val" style="color:' + r.color + '">' + r.val + '</div>';
      html += '</div>';
    });

    html += '</div>';
    impactCard.innerHTML = html;
  }

  function updateTip(data) {
    var bufMin = Math.round(data.effectiveBufferH * 60);
    var ex = EXTYPE[state.extype];
    var tips = {
      hiit:     'Finish HIIT at least ' + bufMin + ' min before ' + fmt12h(data.bedH) + ' to protect sleep onset.',
      cardio:   'End cardio ' + bufMin + ' min before bed. Post-exercise cooling will deepen your slow-wave sleep.',
      strength: 'Strength training ' + bufMin + ' min buffer. Morning sessions also boost testosterone timing.',
      yoga:     'Evening yoga can shorten sleep onset. Gentle flow close to bed is fine for most chronotypes.',
    };
    tipText.textContent = tips[state.extype];
  }

  /* ===== EVENT LISTENERS ===== */
  chronoGrid.addEventListener('click', function(e) {
    var btn = e.target.closest('.chrono-btn');
    if (!btn) return;
    state.chronotype = btn.dataset.type;
    chronoGrid.querySelectorAll('.chrono-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    render();
  });

  typeToggle.addEventListener('click', function(e) {
    var btn = e.target.closest('.type-btn');
    if (!btn) return;
    state.extype = btn.dataset.extype;
    typeToggle.querySelectorAll('.type-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    render();
  });

  durationSel.addEventListener('change', function() {
    state.duration = parseInt(this.value, 10);
    render();
  });

  fitnessSel.addEventListener('change', function() {
    state.fitness = this.value;
    render();
  });

  bedtimeInput.addEventListener('input', function() {
    var h = parseTimeInput(this.value);
    state.bedtimeMinutes = h * 60;
    render();
  });

  /* ===== INIT ===== */
  render();

})();
</script>

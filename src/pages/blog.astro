---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout
  title="Sleep Science Blog — The Sleep Math"
  description="Sleep science deep-dives, calculator guides, and research breakdowns from The Sleep Math. Articles on circadian rhythm, insomnia, and more coming soon."
>
  <Nav />

  <main class="blog-main">
    <div class="container">
      <div class="hero-wrap">

        <!-- Icon -->
        <div class="icon-wrap">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="36"
            height="36"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <!-- Pen nib / article icon (Lucide-style pen-line) -->
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
          </svg>
        </div>

        <!-- Headline -->
        <h1>The Sleep Math Blog</h1>
        <p class="subtitle">
          Research breakdowns, calculator deep-dives, and sleep science updates.
          Coming soon.
        </p>

        <!-- Upcoming articles -->
        <section class="upcoming" aria-label="Upcoming articles">
          <p class="upcoming-label">On the way</p>
          <ul class="article-list">
            <li class="article-item">
              <span class="article-dot" aria-hidden="true"></span>
              <span class="article-title">Why the '8 Hours' Rule Is Wrong</span>
            </li>
            <li class="article-item">
              <span class="article-dot" aria-hidden="true"></span>
              <span class="article-title">Caffeine Half-Life: What Drake et al. Actually Found</span>
            </li>
            <li class="article-item">
              <span class="article-dot" aria-hidden="true"></span>
              <span class="article-title">Sleep Debt Is Real — Here's the Math</span>
            </li>
            <li class="article-item">
              <span class="article-dot" aria-hidden="true"></span>
              <span class="article-title">The Science Behind Your Chronotype</span>
            </li>
          </ul>
        </section>

        <!-- Newsletter CTA -->
        <div class="newsletter-wrap">
          <p class="newsletter-label">Get notified when we publish</p>
          <form class="newsletter-form" onsubmit="handleSubscribe(event)">
            <input
              type="email"
              class="email-input"
              placeholder="your@email.com"
              aria-label="Email address"
              required
            />
            <button type="submit" class="btn btn-fill subscribe-btn">Subscribe</button>
          </form>
          <p class="form-note" id="form-note" aria-live="polite"></p>
        </div>

        <!-- Back link -->
        <a href="/#calcs" class="back-link">
          Browse calculators
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .blog-main {
    min-height: calc(100vh - 130px);
    display: flex;
    align-items: center;
    padding: 5rem 0 4rem;
  }

  .container {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
  }

  /* ===== Hero wrap ===== */
  .hero-wrap {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  /* ===== Icon ===== */
  .icon-wrap {
    width: 68px;
    height: 68px;
    background: var(--primary-soft);
    color: var(--primary);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.75rem;
  }

  /* ===== Headline ===== */
  h1 {
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--text);
    margin-bottom: 0.85rem;
  }

  .subtitle {
    font-size: 1.05rem;
    color: var(--text-mid);
    line-height: 1.6;
    max-width: 420px;
    margin-bottom: 2.5rem;
  }

  /* ===== Upcoming articles ===== */
  .upcoming {
    width: 100%;
    background: var(--bg-tint);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem 1.6rem;
    margin-bottom: 2.25rem;
    text-align: left;
  }

  .upcoming-label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-soft);
    margin-bottom: 1rem;
  }

  .article-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.72rem;
  }

  .article-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .article-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary);
    opacity: 0.45;
    flex-shrink: 0;
  }

  .article-title {
    font-size: 0.93rem;
    font-weight: 500;
    color: var(--text-mid);
    line-height: 1.4;
  }

  /* ===== Newsletter ===== */
  .newsletter-wrap {
    width: 100%;
    margin-bottom: 2rem;
  }

  .newsletter-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-mid);
    margin-bottom: 0.65rem;
  }

  .newsletter-form {
    display: flex;
    gap: 0.5rem;
  }

  .email-input {
    flex: 1;
    padding: 0.72rem 1rem;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--text);
    background: var(--card);
    transition: border-color 0.15s;
    outline: none;
    min-width: 0;
  }

  .email-input::placeholder {
    color: var(--text-soft);
  }

  .email-input:focus {
    border-color: var(--primary);
  }

  .subscribe-btn {
    white-space: nowrap;
    flex-shrink: 0;
  }

  .form-note {
    margin-top: 0.55rem;
    font-size: 0.8rem;
    color: var(--text-soft);
    min-height: 1.2em;
  }

  .form-note.success {
    color: var(--mint);
  }

  /* ===== Back link ===== */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary);
    transition: gap 0.15s, opacity 0.15s;
  }

  .back-link:hover {
    gap: 0.55rem;
    opacity: 0.85;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .blog-main {
      padding: 3.5rem 0 3rem;
      align-items: flex-start;
    }

    .container {
      padding: 0 1.25rem;
    }

    h1 {
      font-size: 1.75rem;
    }

    .newsletter-form {
      flex-direction: column;
    }

    .subscribe-btn {
      width: 100%;
      justify-content: center;
    }

    .upcoming {
      padding: 1.2rem 1.25rem;
    }
  }
</style>

<script is:inline>
  function handleSubscribe(e) {
    e.preventDefault();
    const form = e.target;
    const input = form.querySelector('input[type="email"]');
    const note = document.getElementById('form-note');

    // Basic guard — real integration would POST to an API
    if (!input.value) return;

    note.textContent = "You're on the list. We'll let you know when the first post drops.";
    note.classList.add('success');
    input.value = '';
    input.disabled = true;
    form.querySelector('button').disabled = true;
  }
</script>

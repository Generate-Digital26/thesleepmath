---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout
  title="Sleep Science Blog — The Sleep Math"
  description="Sleep science deep-dives, calculator guides, and research breakdowns from The Sleep Math. Articles on circadian rhythm, insomnia, and more coming soon."
>
  <Nav />

  <main class="blog-main">
    <div class="container">
      <div class="hero-wrap">

        <!-- Icon -->
        <div class="icon-wrap">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="36"
            height="36"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <!-- Pen nib / article icon (Lucide-style pen-line) -->
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
          </svg>
        </div>

        <!-- Headline -->
        <h1>The Sleep Math Blog</h1>
        <p class="subtitle">
          Research breakdowns, calculator deep-dives, and sleep science updates.
        </p>

        <!-- Published articles -->
        <section class="posts-grid" aria-label="Published articles">
          <a href="/blog/ideal-sleep-temperature" class="post-card">
            <div class="post-card-img">
              <img src="/images/blog/ideal-sleep-temperature-hero.jpg" alt="Softly lit bedroom at night with a white duvet and a digital thermostat on the wall showing 67 degrees" loading="lazy" />
            </div>
            <div class="post-card-body">
              <div class="post-card-meta">
                <span class="post-tag">Sleep Science</span>
                <span class="post-date">May 30, 2026</span>
              </div>
              <h2 class="post-card-title">What Is the Ideal Sleep Temperature? The Number, the Mechanism, and the Data</h2>
              <p class="post-card-excerpt">65&#8211;68&#176;F. That's the range backed by 3.75 million nights of sleep data. Here's why the number is that specific &#8212; and what happens to your REM sleep when you miss it.</p>
              <span class="post-card-cta">
                Read article
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
          <a href="/blog/brown-noise-for-sleep" class="post-card">
            <div class="post-card-img">
              <img src="/images/blog/brown-noise-for-sleep-hero.jpg" alt="Person sleeping peacefully in a softly lit bedroom with a small speaker on the nightstand emitting a gentle warm glow" loading="lazy" />
            </div>
            <div class="post-card-body">
              <div class="post-card-meta">
                <span class="post-tag">Sleep Science</span>
                <span class="post-date">May 30, 2026</span>
              </div>
              <h2 class="post-card-title">Brown Noise for Sleep: What the Science Actually Says (And a Calculator to Find Your Optimal Volume)</h2>
              <p class="post-card-excerpt">Brown noise isn&#8217;t magic &#8212; it&#8217;s masking. A 2017 Harvard-affiliated RCT found it cut sleep onset time by 38%, but only for the right kind of sleeper. Here&#8217;s what the science shows, plus a calculator for your optimal volume.</p>
              <span class="post-card-cta">
                Read article
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
          <a href="/blog/blue-light-and-melatonin-what-the-research-actually-shows" class="post-card">
            <div class="post-card-img">
              <img src="/images/blog/blue-light-and-melatonin-what-the-research-actually-shows-hero.jpg" alt="Person in a dark room lit only by the cool glow of a phone screen, soft blue light reflecting off the bedsheets" loading="lazy" />
            </div>
            <div class="post-card-body">
              <div class="post-card-meta">
                <span class="post-tag">Sleep Science</span>
                <span class="post-date">May 28, 2026</span>
              </div>
              <h2 class="post-card-title">Blue Light and Melatonin: What the Research Actually Shows</h2>
              <p class="post-card-excerpt">Your eyes have a hidden photoreceptor tuned to 460 nm. Six studies reveal what blue light actually does to your melatonin — and why those blue-light glasses probably don't help.</p>
              <span class="post-card-cta">
                Read article
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
          <a href="/blog/why-you-wake-up-tired-even-after-8-hours" class="post-card">
            <div class="post-card-img">
              <img src="/images/blog/why-you-wake-up-tired-even-after-8-hours-hero.jpg" alt="A hand reaching from tangled bedsheets to silence an alarm clock in soft grey-blue dawn light" loading="lazy" />
            </div>
            <div class="post-card-body">
              <div class="post-card-meta">
                <span class="post-tag">Sleep Science</span>
                <span class="post-date">May 23, 2026</span>
              </div>
              <h2 class="post-card-title">Why You Wake Up Tired (Even After 8 Hours)</h2>
              <p class="post-card-excerpt">Eight hours in bed does not guarantee eight hours of restoration. Sleep inertia, low sleep efficiency, and fragmented architecture explain why your mornings feel so heavy.</p>
              <span class="post-card-cta">
                Read article
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
          <a href="/blog/the-science-behind-your-chronotype" class="post-card">
            <div class="post-card-img">
              <img src="/images/blog/the-science-behind-your-chronotype-hero.jpg" alt="Split scene showing warm sunrise light through a bedroom window on one side and a cosy desk lamp illuminating a workspace at night on the other" loading="lazy" />
            </div>
            <div class="post-card-body">
              <div class="post-card-meta">
                <span class="post-tag">Sleep Science</span>
                <span class="post-date">May 21, 2026</span>
              </div>
              <h2 class="post-card-title">The Science Behind Your Chronotype</h2>
              <p class="post-card-excerpt">Whether you bounce out of bed at dawn or hit your stride at midnight is not a personality quirk. It is written into your DNA — across 351 gene variants, to be precise.</p>
              <span class="post-card-cta">
                Read article
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
          <a href="/blog/sleep-debt-is-real-heres-the-math" class="post-card">
            <div class="post-card-img">
              <img src="/images/blog/sleep-debt-is-real-heres-the-math-hero.jpg" alt="Rumpled bed sheets in dim early-morning light with a clock on the bedside table" loading="lazy" />
            </div>
            <div class="post-card-body">
              <div class="post-card-meta">
                <span class="post-tag">Sleep Science</span>
                <span class="post-date">May 20, 2026</span>
              </div>
              <h2 class="post-card-title">Sleep Debt Is Real — Here's the Math</h2>
              <p class="post-card-excerpt">You can survive on 6 hours a night. For a while. Then the bill arrives — and a landmark study proved you will not even notice it happening.</p>
              <span class="post-card-cta">
                Read article
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
          <a href="/blog/caffeine-half-life-what-drake-et-al-actually-found" class="post-card">
            <div class="post-card-img">
              <img src="/images/blog/caffeine-half-life-what-drake-et-al-actually-found-hero.jpg" alt="Half-finished cup of coffee on a bedside table in late afternoon light" loading="lazy" />
            </div>
            <div class="post-card-body">
              <div class="post-card-meta">
                <span class="post-tag">Sleep Science</span>
                <span class="post-date">May 19, 2026</span>
              </div>
              <h2 class="post-card-title">Caffeine Half-Life: What Drake et al. Actually Found</h2>
              <p class="post-card-excerpt">That afternoon coffee you swore was "early enough"? A landmark study proved it still costs you an hour of sleep — and you will not even feel it happening.</p>
              <span class="post-card-cta">
                Read article
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
          <a href="/blog/why-8-hours-rule-is-wrong" class="post-card">
            <div class="post-card-img">
              <img src="/images/blog/why-8-hours-rule-is-wrong-hero.jpg" alt="Bedside alarm clock at dawn next to an open notebook" loading="lazy" />
            </div>
            <div class="post-card-body">
              <div class="post-card-meta">
                <span class="post-tag">Sleep Science</span>
                <span class="post-date">May 15, 2026</span>
              </div>
              <h2 class="post-card-title">Why the '8 Hours' Rule Is Wrong</h2>
              <p class="post-card-excerpt">Eight hours isn't a prescription — it's an average. The real number is written into your genes, age, and chronotype. Here is how to find it.</p>
              <span class="post-card-cta">
                Read article
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
          <a href="/blog/5-bedtime-habits-ruining-your-sleep" class="post-card">
            <div class="post-card-img">
              <img src="/images/blog/5-bedtime-habits-hero.jpg" alt="Bedroom with warm lamp lighting at night" loading="lazy" />
            </div>
            <div class="post-card-body">
              <div class="post-card-meta">
                <span class="post-tag">Sleep Hygiene</span>
                <span class="post-date">May 14, 2026</span>
              </div>
              <h2 class="post-card-title">5 Bedtime Habits That Are Ruining Your Sleep</h2>
              <p class="post-card-excerpt">Struggling to fall asleep or waking up exhausted? These 5 common nighttime habits could be the reason — and the science-backed fixes are simpler than you think.</p>
              <span class="post-card-cta">
                Read article
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        </section>

        <!-- Upcoming articles -->
        <section class="upcoming" aria-label="Upcoming articles">
          <p class="upcoming-label">Coming next</p>
          <ul class="article-list">
            <li class="article-item">
              <span class="article-dot" aria-hidden="true"></span>
              <span class="article-title">Alcohol and Sleep: What One Drink Actually Does</span>
            </li>
            <li class="article-item">
              <span class="article-dot" aria-hidden="true"></span>
              <span class="article-title">Napping Science: When It Helps and When It Backfires</span>
            </li>
            <li class="article-item">
              <span class="article-dot" aria-hidden="true"></span>
              <span class="article-title">Exercise and Sleep: What Time You Train Actually Matters</span>
            </li>
            <li class="article-item">
              <span class="article-dot" aria-hidden="true"></span>
              <span class="article-title">Social Jet Lag: The Weekend Sleep Pattern Wrecking Your Week</span>
            </li>
            <li class="article-item">
              <span class="article-dot" aria-hidden="true"></span>
              <span class="article-title">Melatonin: What the Research Actually Says About Dose and Timing</span>
            </li>
          </ul>
        </section>

        <!-- Newsletter CTA -->
        <div class="newsletter-wrap">
          <p class="newsletter-label">Get notified when we publish</p>
          <form class="newsletter-form" data-kit-form>
            <input
              type="email"
              class="email-input"
              placeholder="your@email.com"
              aria-label="Email address"
              required
            />
            <button type="submit" class="btn btn-fill subscribe-btn">Subscribe</button>
          </form>
          <p class="form-note" data-kit-note aria-live="polite"></p>
        </div>

        <!-- Back link -->
        <a href="/#calcs" class="back-link">
          Browse calculators
          <svg
             xmlns="http://www.w3.org/2000/svg"
             width="15"
             height="15"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true"
            >
             <path d="M5 12h14" />
             <path d="m12 5 7 7-7 7" />
            </svg>
        </a>

      </div>
    </div>


  <Footer />
</BaseLayout>

<style>
  .blog-main {
    min-height: calc(100vh - 130px);
    display: flex;
    align-items: center;
    padding: 5rem 0 4rem;
  }

  .container {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
  }

  /* ===== Hero wrap ===== */
  .hero-wrap {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  /* ===== Icon ===== */
  .icon-wrap {
    width: 68px;
    height: 68px;
    background: var(--primary-soft);
    color: var(--primary);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.75rem;
  }

  /* ===== Headline ===== */
  h1 {
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--text);
    margin-bottom: 0.85rem;
  }

  .subtitle {
    font-size: 1.05rem;
    color: var(--text-mid);
    line-height: 1.6;
    max-width: 420px;
    margin-bottom: 2.5rem;
  }

  /* ===== Published posts ===== */
  .posts-grid {
    width: 100%;
    margin-bottom: 2rem;
  }

  .post-card {
    display: flex;
    background: var(--card);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
    text-decoration: none;
    color: inherit;
  }

  .post-card:hover {
    border-color: var(--primary);
    box-shadow: 0 4px 20px rgba(124, 106, 255, 0.08);
  }

  .post-card-img {
    width: 280px;
    min-height: 200px;
    flex-shrink: 0;
    overflow: hidden;
  }

  .post-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .post-card:hover .post-card-img img {
    transform: scale(1.03);
  }

  .post-card-body {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .post-tag {
    background: var(--primary-soft);
    color: var(--primary);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .post-date {
    color: var(--text-soft);
  }

  .post-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--text);
  }

  .post-card-excerpt {
    font-size: 0.86rem;
    color: var(--text-mid);
    line-height: 1.6;
  }

  .post-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary);
    margin-top: 0.25rem;
    transition: gap 0.15s;
  }

  .post-card:hover .post-card-cta {
    gap: 0.55rem;
  }

  /* ===== Upcoming articles ===== */
  .upcoming {
    width: 100%;
    background: var(--bg-tint);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem 1.6rem;
    margin-bottom: 2.25rem;
    text-align: left;
  }

  .upcoming-label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-soft);
    margin-bottom: 1rem;
  }

  .article-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.72rem;
  }

  .article-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .article-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary);
    opacity: 0.45;
    flex-shrink: 0;
  }

  .article-title {
    font-size: 0.93rem;
    font-weight: 500;
    color: var(--text-mid);
    line-height: 1.4;
  }

  /* ===== Newsletter ===== */
  .newsletter-wrap {
    width: 100%;
    margin-bottom: 2rem;
  }

  .newsletter-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-mid);
    margin-bottom: 0.65rem;
  }

  .newsletter-form {
    display: flex;
    gap: 0.5rem;
  }

  .email-input {
    flex: 1;
    padding: 0.72rem 1rem;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--text);
    background: var(--card);
    transition: border-color 0.15s;
    outline: none;
    min-width: 0;
  }

  .email-input::placeholder {
    color: var(--text-soft);
  }

  .email-input:focus {
    border-color: var(--primary);
  }

  .subscribe-btn {
    white-space: nowrap;
    flex-shrink: 0;
  }

  .form-note {
    margin-top: 0.55rem;
    font-size: 0.8rem;
    color: var(--text-soft);
    min-height: 1.2em;
  }

  .form-note.success {
    color: var(--mint);
  }

  /* ===== Back link ===== */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary);
    transition: gap 0.15s, opacity 0.15s;
  }

  .back-link:hover {
    gap: 0.55rem;
    opacity: 0.85;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .blog-main {
      padding: 3.5rem 0 3rem;
      align-items: flex-start;
    }

    .container {
      padding: 0 1.25rem;
    }

    h1 {
      font-size: 1.75rem;
    }

    .newsletter-form {
      flex-direction: column;
    }

    .subscribe-btn {
      width: 100%;
      justify-content: center;
    }

    .upcoming {
      padding: 1.2rem 1.25rem;
    }

    .post-card {
      flex-direction: column;
    }

    .post-card-img {
      width: 100%;
      min-height: 180px;
      max-height: 200px;
    }

    .post-card-body {
      padding: 1.25rem;
    }

    .post-card-title {
      font-size: 1.1rem;
    }
  }
</style>

<!-- Newsletter handled by global Kit script in BaseLayout -->

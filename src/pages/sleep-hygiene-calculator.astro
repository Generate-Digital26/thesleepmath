  }
  .formula-box .formula-main { font-size: 0.98rem; font-weight: 700; margin-bottom: 0.3rem; }
  .formula-box .formula-desc { font-size: 0.73rem; color: #a8a3be; }
  .citation {
    font-size: 0.78rem; color: var(--text-soft); line-height: 1.55;
    padding-left: 0.85rem; border-left: 2px solid var(--border);
  }
  .citation em { color: var(--text-mid); }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .calc-header { padding: 1rem 1.25rem 0; }
    .calc-layout { grid-template-columns: 1fr; padding: 1.25rem; }
    .input-panel { position: static; max-height: none; }
    .science-section { padding: 0 1.25rem 2rem; }
  }
  @media (max-width: 480px) {
    .tt-btn { padding: 0.15rem 0.4rem; font-size: 0.62rem; }
    .three-toggle { gap: 0.15rem; }
  }
</style>

<script is:inline>
(function () {

  // ── Item definitions ────────────────────────────────────────────────────────
  // weight: 1–3 (higher = more impact on score)
  // cat: category key
  var ITEMS = [
    // Environment
    { id: 'dark',        cat: 'env',       weight: 2, label: 'Fully dark bedroom',           action: 'Install blackout curtains or use a sleep mask. Even small LED lights suppress melatonin.', link: null },
    { id: 'cool',        cat: 'env',       weight: 2, label: 'Bedroom temperature 65–68 °F', action: 'Set your thermostat or use a fan. Core temperature must drop 1–2 °F for deep sleep to begin.', link: null },
    { id: 'quiet',       cat: 'env',       weight: 1, label: 'Quiet sleep environment',      action: 'Use a white noise machine or earplugs. Irregular sounds (not constant ones) cause the most arousals.', link: null },
    { id: 'comfortable', cat: 'env',       weight: 1, label: 'Comfortable mattress/pillow',  action: 'Assess whether your mattress is causing morning pain or stiffness — these signal poor pressure relief.', link: null },
    // Timing
    { id: 'schedule',    cat: 'timing',    weight: 3, label: 'Consistent sleep-wake timing', action: 'Fix your wake time first — even on weekends. A stable wake anchor resets your circadian rhythm within days.', link: null },
    { id: 'winddown',    cat: 'timing',    weight: 2, label: '30–60 min wind-down buffer',   action: 'Treat bed as a destination, not a crash landing. Start dimming lights and slowing down 45 min before sleep.', link: null },
    { id: 'naps',        cat: 'timing',    weight: 2, label: 'No late or long naps',         action: 'Keep naps under 20 min and before 2 pm. Late naps drain the sleep pressure that makes falling asleep effortless.', link: null },
    // Substances
    { id: 'caffeine',    cat: 'substances',weight: 3, label: 'Caffeine cutoff 6+ hrs before bed', action: 'Move your last coffee to 1–2 pm for a 9–10 pm bedtime. Even if you feel unaffected, caffeine measurably reduces deep sleep.', link: '/caffeine-cutoff-calculator' },
    { id: 'alcohol',     cat: 'substances',weight: 2, label: 'Alcohol stopped 3+ hrs before bed', action: 'Alcohol fragments REM sleep and causes second-half arousals. If you drink, finish by 7 pm for a 10 pm bedtime.', link: null },
    { id: 'nicotine',    cat: 'substances',weight: 1, label: 'No nicotine in 2 hrs before bed',   action: 'Nicotine is a stimulant. Switch to morning use or use nicotine replacement to avoid evening intake.', link: null },
    // Behavior
    { id: 'screens',     cat: 'behavior',  weight: 2, label: 'Screens off 30+ min before bed',action: 'Replace evening phone time with reading, stretching, or a warm shower. Use Night Shift / night mode if you must use screens.', link: null },
    { id: 'bedsleep',    cat: 'behavior',  weight: 2, label: 'Bed used only for sleep and sex', action: 'Stop working, watching TV, or scrolling in bed. Within 2 weeks this rebuilds the sleep-bed conditioned response.', link: null },
    { id: 'exercise',    cat: 'behavior',  weight: 2, label: 'Regular exercise (not late)',    action: 'Even 20–30 min of moderate walking 5 days a week increases slow-wave sleep. Move workouts to morning or midday.', link: null },
    { id: 'stress',      cat: 'behavior',  weight: 2, label: 'Daytime stress management',     action: 'A brief midday breathing practice or short walk cuts evening cortisol. Stress unaddressed by day becomes pre-sleep rumination.', link: null },
    // Pre-sleep
    { id: 'relaxation',  cat: 'presleep',  weight: 2, label: 'Pre-sleep relaxation technique', action: 'Try 4-7-8 breathing (inhale 4 s, hold 7 s, exhale 8 s) or a 10-minute body scan. Even 5 minutes meaningfully reduces sleep onset time.', link: null },
    { id: 'journal',     cat: 'presleep',  weight: 2, label: 'Worry or to-do journal used',   action: 'Write tomorrow\'s tasks and any worries on paper before bed. This "cognitive offloading" reduces nighttime mind racing.', link: null },
    { id: 'shower',      cat: 'presleep',  weight: 1, label: 'Warm shower 1–2 hrs before bed', action: 'A warm (not hot) bath or shower 1–2 hrs before bed accelerates skin cooling, which triggers rapid sleep onset.', link: null },
    { id: 'reading',     cat: 'presleep',  weight: 1, label: 'Calming pre-sleep activity',    action: 'Physical book reading or light stretching provides a low-arousal wind-down that screens cannot replicate.', link: null },
  ];

  var CAT_META = {
    env:       { label: 'Environment', color: '#7c6aff', scoreId: 'cat-score-env' },
    timing:    { label: 'Timing',      color: '#10b981', scoreId: 'cat-score-timing' },
    substances:{ label: 'Substances',  color: '#ff6b52', scoreId: 'cat-score-substances' },
    behavior:  { label: 'Behavior',    color: '#38b6ff', scoreId: 'cat-score-behavior' },
    presleep:  { label: 'Pre-Sleep',   color: '#f59e0b', scoreId: 'cat-score-presleep' },
  };

  var CAT_ORDER = ['env', 'timing', 'substances', 'behavior', 'presleep'];

  // State: each item starts as 'no' (all toggles default to No / active-no)
  var state = {};
  ITEMS.forEach(function(item) { state[item.id] = 'no'; });

  // ── Scoring helpers ──────────────────────────────────────────────────────────
  function itemPoints(val, weight) {
    if (val === 'yes') return weight;
    if (val === 'sometimes') return weight * 0.5;
    return 0;
  }

  function catMaxPoints(catKey) {
    return ITEMS.filter(function(i) { return i.cat === catKey; })
                .reduce(function(sum, i) { return sum + i.weight; }, 0);
  }

  function catScore(catKey) {
    var earned = ITEMS.filter(function(i) { return i.cat === catKey; })
                      .reduce(function(sum, i) { return sum + itemPoints(state[i.id], i.weight); }, 0);
    var max = catMaxPoints(catKey);
    return max > 0 ? Math.round((earned / max) * 100) : 0;
  }

  function overallScore() {
    var totalEarned = ITEMS.reduce(function(sum, i) { return sum + itemPoints(state[i.id], i.weight); }, 0);
    var totalMax = ITEMS.reduce(function(sum, i) { return sum + i.weight; }, 0);
    return Math.round((totalEarned / totalMax) * 100);
  }

  // ── Grade thresholds ──────────────────────────────────────────────────────
  function gradeData(score) {
    if (score < 40) return { cls: 'grade-poor', label: 'Needs Work', desc: 'Several high-impact habits are missing. Start with the top priorities below — even two changes can meaningfully improve your sleep within two weeks.' };
    if (score < 60) return { cls: 'grade-fair', label: 'Fair',       desc: 'You have some good habits but key gaps remain. Your priorities below identify the highest-leverage improvements available.' };
    if (score < 80) return { cls: 'grade-good', label: 'Good',       desc: 'Solid sleep hygiene with room to improve. Targeting your weakest category will unlock the next level of sleep quality.' };
    return { cls: 'grade-great', label: 'Excellent', desc: 'Outstanding sleep hygiene. Maintain consistency — your habits are aligned with the best practices from sleep medicine research.' };
  }

  // ── Priority items (top 3 lowest-scoring by deficit) ──────────────────────
  function getPriorities() {
    var deficits = ITEMS.map(function(item) {
      var maxPts = item.weight;
      var earnedPts = itemPoints(state[item.id], item.weight);
      return { item: item, deficit: maxPts - earnedPts };
    });
    deficits.sort(function(a, b) { return b.deficit - a.deficit; });
    // Return top 3 with non-zero deficit
    return deficits.filter(function(d) { return d.deficit > 0; }).slice(0, 3);
  }

  // Priority card colors (rank 1, 2, 3)
  var PRIORITY_COLORS = [
    { border: '#ffd0c8', bg: '#fff6f4', rankBg: '#ff6b52', rankColor: '#fff' },
    { border: '#fde68a', bg: '#fffbeb', rankBg: '#f59e0b', rankColor: '#fff' },
    { border: '#bfdbfe', bg: '#eff6ff', rankBg: '#3b82f6', rankColor: '#fff' },
  ];

  // ── Radar chart (plain canvas, no libraries) ──────────────────────────────
  function drawRadar(scores) {
    var canvas = document.getElementById('radar-canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var W = canvas.width;
    var H = canvas.height;
    ctx.clearRect(0, 0, W, H);

    var cx = W / 2;
    var cy = H / 2 + 10;
    var r = Math.min(W, H) * 0.38;
    var n = CAT_ORDER.length;
    var angleStep = (2 * Math.PI) / n;
    var startAngle = -Math.PI / 2; // top

    // Draw grid rings
    var rings = [0.25, 0.5, 0.75, 1];
    rings.forEach(function(frac) {
      ctx.beginPath();
      for (var i = 0; i <= n; i++) {
        var angle = startAngle + i * angleStep;
        var px = cx + Math.cos(angle) * r * frac;
        var py = cy + Math.sin(angle) * r * frac;
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.strokeStyle = '#e4e1ec';
      ctx.lineWidth = 1;
      ctx.stroke();
    });

    // Draw spokes
    for (var i = 0; i < n; i++) {
      var angle = startAngle + i * angleStep;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(angle) * r, cy + Math.sin(angle) * r);
      ctx.strokeStyle = '#e4e1ec';
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    // Draw filled area
    ctx.beginPath();
    for (var i = 0; i < n; i++) {
      var cat = CAT_ORDER[i];
      var angle = startAngle + i * angleStep;
      var frac = scores[cat] / 100;
      var px = cx + Math.cos(angle) * r * frac;
      var py = cy + Math.sin(angle) * r * frac;
      if (i === 0) ctx.moveTo(px, py);
      else ctx.lineTo(px, py);
    }
    ctx.closePath();
    ctx.fillStyle = 'rgba(124, 106, 255, 0.15)';
    ctx.fill();
    ctx.strokeStyle = '#7c6aff';
    ctx.lineWidth = 2;
    ctx.stroke();

    // Draw vertex dots
    for (var i = 0; i < n; i++) {
      var cat = CAT_ORDER[i];
      var angle = startAngle + i * angleStep;
      var frac = scores[cat] / 100;
      var px = cx + Math.cos(angle) * r * frac;
      var py = cy + Math.sin(angle) * r * frac;
      ctx.beginPath();
      ctx.arc(px, py, 4, 0, 2 * Math.PI);
      ctx.fillStyle = CAT_META[cat].color;
      ctx.fill();
    }

    // Draw axis labels
    ctx.font = '600 10px Sora, sans-serif';
    ctx.textAlign = 'center';
    for (var i = 0; i < n; i++) {
      var cat = CAT_ORDER[i];
      var angle = startAngle + i * angleStep;
      var labelR = r + 22;
      var lx = cx + Math.cos(angle) * labelR;
      var ly = cy + Math.sin(angle) * labelR;
      var sc = scores[cat];
      ctx.fillStyle = CAT_META[cat].color;
      ctx.fillText(sc + '%', lx, ly + 4);
    }
  }

  // ── Score ring update ─────────────────────────────────────────────────────
  var RING_CIRCUM = 2 * Math.PI * 52; // ~326.73

  function updateRing(score) {
    var fill = document.getElementById('score-ring-fill');
    if (!fill) return;
    var frac = score / 100;
    var drawn = frac * RING_CIRCUM;
    var offset = RING_CIRCUM - drawn;
    fill.setAttribute('stroke-dasharray', RING_CIRCUM.toFixed(2));
    fill.setAttribute('stroke-dashoffset', offset.toFixed(2));
    var color = score < 40 ? '#ff6b52' : score < 60 ? '#f59e0b' : score < 80 ? '#3b82f6' : '#10b981';
    fill.setAttribute('stroke', color);
  }

  // ── Priority card HTML ────────────────────────────────────────────────────
  function buildPriorityCards(priorities) {
    if (!priorities.length) {
      return '<p style="font-size:0.8rem;color:var(--text-soft);">All habits are in great shape — keep it up!</p>';
    }
    return priorities.map(function(d, idx) {
      var c = PRIORITY_COLORS[idx] || PRIORITY_COLORS[2];
      var item = d.item;
      var catMeta = CAT_META[item.cat];
      var linkHtml = '';
      if (item.link) {
        linkHtml = '<a class="priority-link" href="' + item.link + '" style="color:' + c.rankBg + ';">' +
          'Try the related calculator' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>' +
          '</a>';
      }
      return '<div class="priority-card" style="border-color:' + c.border + ';background:' + c.bg + ';">' +
        '<div class="priority-rank" style="background:' + c.rankBg + ';color:' + c.rankColor + ';">' + (idx + 1) + '</div>' +
        '<div class="priority-body">' +
          '<div class="priority-title">' + item.label + '</div>' +
          '<div class="priority-action">' + item.action + '</div>' +
          '<div style="display:flex;align-items:center;gap:0.4rem;margin-top:0.35rem;">' +
            '<span style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:' + catMeta.color + ';">' + catMeta.label + '</span>' +
            linkHtml +
          '</div>' +
        '</div>' +
      '</div>';
    }).join('');
  }

  // ── Main calculate function ───────────────────────────────────────────────
  function calculate() {
    var overall = overallScore();

    // Category scores
    var catScores = {};
    CAT_ORDER.forEach(function(cat) { catScores[cat] = catScore(cat); });

    // Score ring
    updateRing(overall);

    // Score hero
    var hero = document.getElementById('score-hero');
    var scoreNumEl = document.getElementById('score-num');
    var scoreGradeEl = document.getElementById('score-grade');
    var scoreDescEl = document.getElementById('score-desc');
    var grade = gradeData(overall);
    if (hero) { hero.className = 'score-hero ' + grade.cls; }
    if (scoreNumEl) { scoreNumEl.textContent = overall; }
    if (scoreGradeEl) { scoreGradeEl.textContent = grade.label; }
    if (scoreDescEl) { scoreDescEl.textContent = grade.desc; }

    // Cat score badges
    CAT_ORDER.forEach(function(cat) {
      var el = document.getElementById(CAT_META[cat].scoreId);
      if (el) { el.textContent = catScores[cat] + '%'; }
    });

    // Radar
    drawRadar(catScores);

    // Priorities
    var priorities = getPriorities();
    var priorityListEl = document.getElementById('priority-list');
    var prioritiesHintEl = document.getElementById('priorities-hint');
    if (priorityListEl) {
      priorityListEl.innerHTML = buildPriorityCards(priorities);
    }
    if (prioritiesHintEl) {
      prioritiesHintEl.style.display = priorities.length ? 'none' : 'block';
    }

    // Item row highlighting
    ITEMS.forEach(function(item) {
      var el = document.querySelector('.hygiene-item[data-item="' + item.id + '"]');
      if (!el) return;
      el.classList.remove('state-yes', 'state-sometimes', 'state-no');
      el.classList.add('state-' + state[item.id]);
    });
  }

  // ── Toggle interaction ────────────────────────────────────────────────────
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.tt-btn');
    if (!btn) return;

    var toggleGroup = btn.closest('.three-toggle');
    if (!toggleGroup) return;

    var itemId = toggleGroup.getAttribute('data-item');
    var val = btn.getAttribute('data-val');
    if (!itemId || !val) return;

    // Clear all active classes in group
    toggleGroup.querySelectorAll('.tt-btn').forEach(function(b) {
      b.classList.remove('active-yes', 'active-sometimes', 'active-no');
    });

    // Apply correct active class
    btn.classList.add('active-' + val);

    state[itemId] = val;
    calculate();
  });

  // ── Initial render ────────────────────────────────────────────────────────
  calculate();

})();
</script>

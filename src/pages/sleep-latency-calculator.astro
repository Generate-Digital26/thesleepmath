      </div>

      <!-- Sleep habits -->
      <div class="field">
        <label>Sleep habits (select all that apply)</label>
        <div class="checkbox-group" id="habits-group">
          <label class="check-item">
            <input type="checkbox" id="habit-caffeine"> Caffeine within 6 hrs of bed
          </label>
          <label class="check-item">
            <input type="checkbox" id="habit-screens"> Screens right before bed
          </label>
          <label class="check-item">
            <input type="checkbox" id="habit-irregular"> Irregular sleep schedule
          </label>
          <label class="check-item">
            <input type="checkbox" id="habit-stress"> High stress / racing thoughts
          </label>
        </div>
      </div>

      <div class="tip-box" id="tip-box">

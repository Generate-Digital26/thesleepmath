    <div class="calc-header-inner">
      <div class="calc-header-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="#7c6aff" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 6v6l4 2"/>
          <path d="M8 14s1 1 4 1 4-1 4-1"/>
        </svg>
      </div>
      <div>
        <h1>Sleep Latency Calculator</h1>
      </div>
    </div>
    <p class="subtitle">Find out if your time to fall asleep is normal, suggests insomnia, or flags serious sleep debt. Benchmarked against the clinical MSLT standard.</p>
    <div class="calc-meta-row">
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        2 min
      </span>
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        MSLT benchmarks
      </span>
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Clinical research
      </span>
    </div>
  </div>

  <!-- CALCULATOR -->
  <div class="calc-layout">

    <!-- INPUT PANEL -->
    <div class="input-panel">
      <h2>Your sleep details</h2>

      <!-- Latency slider -->
      <div class="field">
        <label for="latency-slider">How long does it take you to fall asleep?</label>
        <div class="slider-value-row">
          <span class="slider-value-display" id="latency-display">15 min</span>
        </div>
        <input type="range" id="latency-slider" min="0" max="120" value="15" step="1" class="slider">
        <div class="slider-labels">
          <span>0 min</span>
          <span>60 min</span>
          <span>120 min</span>
        </div>
      </div>

      <!-- Measurement method -->
      <div class="field">
        <label>How did you measure this?</label>
        <div class="choice-group" id="method-group">
          <button class="choice-btn active" data-val="guess">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            Rough guess
          </button>
          <button class="choice-btn" data-val="tracked">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
            Sleep tracker
          </button>
          <button class="choice-btn" data-val="partner">

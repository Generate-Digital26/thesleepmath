  function minutesToGaugePct(min) {
    /* Zone cumulative flex: debt[0-5]=5, short[5-10]=5, normal[10-20]=10, mild[20-30]=10, insomnia[30-60]=30, severe[60-120]=60 */
    /* Total flex = 120. Percentage = flex units used / 120. */
    var totalFlex = 120;
    var flexUsed;
    if (min <= 5)  flexUsed = (min / 5) * 5;

      check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
      moon:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>',
      doc:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>',
      book:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>',
      star:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
    };
    return icons[type] || icons['check'];
  }

  /* ---- Habit-derived tip ---- */
  function buildTip(min, method, sleepiness, caffeine, screens, irreg, stress) {
    var tips = [];
    if (method === 'guess') tips.push('Note: self-estimated latency tends to be 5–10 min longer than objectively measured. Your true latency may be shorter.');
    if (method === 'tracked') tips.push('Sleep tracker-measured latency is more accurate than estimation — use these results with confidence.');
    if (caffeine && min > 20) tips.push('Caffeine is likely contributing to your delayed sleep onset — try cutting off at 2 PM.');
    if (screens  && min > 15) tips.push('Blue light and cognitive arousal from screens can delay sleep onset by 30–60 min.');
    if (irreg    && min > 15) tips.push('Irregular sleep timing weakens your circadian signal and makes falling asleep harder.');
    if (stress   && min > 20) tips.push('Pre-sleep worry is a leading driver of sleep onset insomnia. CBT-I targets this directly.');
    if (sleepiness === 'severe' && min < 8) tips.push('Extreme daytime sleepiness combined with very fast sleep onset is a red flag — please see a doctor.');
    if (tips.length === 0) tips.push('Adjust any input above to see personalised observations here.');
    return tips[0];
  }

  /* ---- Main calculate ---- */
  function calculate() {
    var min         = parseInt(slider.value, 10);
    var caffeine    = habitCaffeine.checked;
    var screens     = habitScreens.checked;
    var irreg       = habitIrreg.checked;
    var stress      = habitStress.checked;

    /* Update slider display */
    latencyDisplay.textContent = min + ' min';

    /* Classify */
    var c = classify(min);

    /* Classification card */
    classCard.style.borderColor = c.cardBorder;
    classBadge.textContent = c.short;
    classBadge.style.background = c.badgeBg;
    classBadge.style.color = c.badgeColor;
    classLatency.textContent = min + ' min';
    classLatency.style.color = c.accent;
    classLabel.textContent = c.desc;

    /* Gauge marker */
    var pct = minutesToGaugePct(min);
    gaugeMarker.style.left = pct + '%';

    /* Population bars */
    var youZone  = getPopZone(min);
    var barsHtml = '';
    POP_DATA.forEach(function(row, i) {
      var isYou = (i === youZone);
      barsHtml += '<div class="pop-row">';
      barsHtml += '<div class="pop-label">' + row.label + (isYou ? ' <span class="pop-you">You</span>' : '') + '</div>';
      barsHtml += '<div class="pop-bar-wrap"><div class="pop-bar-track"><div class="pop-bar-fill" style="width:' + row.pct + '%;background:' + row.color + '"></div></div></div>';
      barsHtml += '<div class="pop-pct">' + row.pct + '%</div>';
      barsHtml += '</div>';
    });
    popBars.innerHTML = barsHtml;

    /* Recommendations */
    var recs = getRecsKey(c.id);
    var recsHtml = '';
    recs.forEach(function(rec) {
      recsHtml += '<li class="' + rec.cls + '">';
      recsHtml += '<div class="rec-icon">' + recIconSvg(rec.icon) + '</div>';
      recsHtml += '<span>' + rec.text + '</span>';
      recsHtml += '</li>';
    });
    recsList.innerHTML = recsHtml;

    /* Tip box */
    tipText.textContent = buildTip(min, currentMethod, currentSleepiness, caffeine, screens, irreg, stress);
  }

  /* ---- Event listeners ---- */
  slider.addEventListener('input', calculate);
  habitCaffeine.addEventListener('change', calculate);
  habitScreens.addEventListener('change', calculate);
  habitIrreg.addEventListener('change', calculate);
  habitStress.addEventListener('change', calculate);

  /* Method group */
  methodGroup.addEventListener('click', function(e) {
    var btn = e.target.closest('.choice-btn');
    if (!btn) return;
    currentMethod = btn.dataset.val;
    methodGroup.querySelectorAll('.choice-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    calculate();
  });

  /* Sleepiness group */
  sleepinessGrp.addEventListener('click', function(e) {
    var btn = e.target.closest('.choice-btn');
    if (!btn) return;
    currentSleepiness = btn.dataset.val;
    sleepinessGrp.querySelectorAll('.choice-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    calculate();
  });

  /* ---- Init ---- */
  calculate();

})();
</script>

import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import ToolsGrid from '@/components/ToolsGrid.astro';

const title = 'Sleep & Exercise: The Research — The Sleep Math';
const description = 'The complete evidence-based guide to how exercise affects your sleep — timing, intensity, aerobic vs. weights, insomnia treatment, mechanisms, and minimum dose. All from peer-reviewed research.';
const canonical = 'https://thesleepmath.com/guides/sleep-and-exercise';
const heroImage = '/images/guides/sleep-and-exercise-hero.jpg';

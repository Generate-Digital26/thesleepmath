---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import ToolsGrid from '@/components/ToolsGrid.astro';

const title = 'The Complete Guide to Sleep Hygiene — The Sleep Math';
const description = 'The complete, evidence-based guide to sleep hygiene: what actually works, what is myth, and how to build the habits that move the needle on your sleep.';
const canonical = 'https://thesleepmath.com/guides/the-complete-guide-to-sleep-hygiene';
const heroImage = '/images/guides/the-complete-guide-to-sleep-hygiene-hero.jpg';

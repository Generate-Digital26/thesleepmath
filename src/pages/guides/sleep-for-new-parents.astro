const title = 'Sleep for New Parents — The Sleep Math';
const description = 'The evidence-based guide to surviving sleep deprivation as a new parent — what the data says about fragmentation, recovery timelines, safe sleep, sleep training, and the strategies that actually help.';
const canonical = 'https://thesleepmath.com/guides/sleep-for-new-parents';
const heroImage = '/images/guides/sleep-for-new-parents-hero.jpg';

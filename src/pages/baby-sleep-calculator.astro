      napCountNum: 0,
      napLength: 'Occasional',
      napMin: 0, napMax: 60,
      wakeWindow: '5–6h+',
      wwMin: 5, wwMax: 7,
      tips: [
        'Most preschoolers drop the nap between 3–4 years, but some need it until age 5.',

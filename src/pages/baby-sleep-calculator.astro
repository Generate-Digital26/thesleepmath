  };

  /* =============================================
     DOM REFS
     ============================================= */
  var ageSelect      = document.getElementById('age-select');
  var wakeInput      = document.getElementById('wake-time');
  var styleBtns      = document.getElementById('style-btns');
  var totalSleepVal  = document.getElementById('total-sleep-val');
  var nightSleepVal  = document.getElementById('night-sleep-val');
  var napCountVal    = document.getElementById('nap-count-val');
  var wakeWindowVal  = document.getElementById('wake-window-val');
  var napCountSub    = document.getElementById('nap-count-sub');
  var scheduleList   = document.getElementById('schedule-list');
  var scheduleWakeLabel = document.getElementById('schedule-wake-label');
  var timelineBar    = document.getElementById('timeline-bar');
  var timelineLabels = document.getElementById('timeline-labels');
  var tipsList       = document.getElementById('tips-list');
  var tipsTitle      = document.getElementById('tips-title');

  var scheduleStyle = 'earlier';

  /* =============================================
     HELPERS
     ============================================= */
  function fmt12(h) {
    h = ((h % 24) + 24) % 24;
    var period = h >= 12 ? 'PM' : 'AM';
    var hh = Math.floor(h) % 12; if (hh === 0) hh = 12;
    var mm = Math.round((h - Math.floor(h)) * 60);
    if (mm === 60) { hh = (hh % 12) + 1; mm = 0; if (hh > 12) hh = 1; }
    return hh + ':' + (mm < 10 ? '0' : '') + mm + ' ' + period;
  }

  function parseTime(val) {
    var parts = val.split(':').map(Number);
    return parts[0] + parts[1] / 60;
  }

  function pct(h) {
    return (((h % 24) + 24) % 24 / 24 * 100).toFixed(2) + '%';
  }

  /* =============================================
     BUILD SCHEDULE
     ============================================= */
  function buildSchedule(age, wake, style) {
    var d = AGE_DATA[age];
    var events = [];
    var offset = style === 'later' ? 0.25 : 0; /* 15 min shift */

    /* Nighttime sleep: wake up, then trace backwards to find bedtime previous night */
    var ww  = style === 'later'
              ? (d.wwMin + d.wwMax) / 2 + 0.25
              : (d.wwMin + d.wwMax) / 2;
    var napDur = d.napMin > 0 ? Math.round((d.napMin + d.napMax) / 2) : 0;
    var napDurH = napDur / 60;
    var nightDur = (d.nightMin + d.nightMax) / 2;

    /* Previous night bedtime (before wake) */
    var prevBed = wake - nightDur;

    /* Morning wake */
    events.push({ time: wake, label: 'Wake up', type: 'wake', badge: 'wake-badge', badgeText: 'Morning' });

    var naps = d.napCountNum;
    var cursor = wake;

    if (naps === 0) {
      /* No naps — just bedtime */
      cursor = wake + ww * 2;
      var bed0 = cursor;
      events.push({ time: bed0, label: 'Bedtime', type: 'bed', badge: 'sleep', badgeText: 'Night sleep' });
    } else if (naps >= 4) {
      /* 0-3mo: 4 naps */
      for (var i = 0; i < 4; i++) {
        var napStart = cursor + ww + offset;
        events.push({ time: napStart, label: 'Nap ' + (i + 1) + ' starts', type: 'nap', badge: 'nap', badgeText: napDur + ' min' });
        cursor = napStart + napDurH;
        events.push({ time: cursor, label: 'Nap ' + (i + 1) + ' ends', type: 'wake', badge: null });
      }
      var bedtime4 = cursor + ww;
      events.push({ time: bedtime4, label: 'Bedtime', type: 'bed', badge: 'sleep', badgeText: 'Night sleep' });
    } else if (naps === 3) {
      /* 4-6mo: 3 naps */
      var n3times = [];
      var c3 = wake;
      for (var j = 0; j < 3; j++) {
        var ns3 = c3 + ww + offset;
        n3times.push(ns3);
        events.push({ time: ns3, label: 'Nap ' + (j + 1) + ' starts', type: 'nap', badge: 'nap', badgeText: napDur + ' min' });
        c3 = ns3 + napDurH;
        events.push({ time: c3, label: 'Nap ' + (j + 1) + ' ends', type: 'wake', badge: null });
      }
      var bed3 = c3 + ww;
      events.push({ time: bed3, label: 'Bedtime', type: 'bed', badge: 'sleep', badgeText: 'Night sleep' });
    } else if (naps === 2) {
      /* 7-12mo: 2 naps */
      var nap1Start = cursor + ww + offset;
      events.push({ time: nap1Start, label: 'Nap 1 starts', type: 'nap', badge: 'nap', badgeText: napDur + ' min' });
      var nap1End = nap1Start + napDurH;
      events.push({ time: nap1End, label: 'Nap 1 ends', type: 'wake', badge: null });

      var nap2Start = nap1End + ww + offset;
      events.push({ time: nap2Start, label: 'Nap 2 starts', type: 'nap', badge: 'nap', badgeText: napDur + ' min' });
      var nap2End = nap2Start + napDurH;
      events.push({ time: nap2End, label: 'Nap 2 ends', type: 'wake', badge: null });

      var bed2 = nap2End + ww;
      events.push({ time: bed2, label: 'Bedtime', type: 'bed', badge: 'sleep', badgeText: 'Night sleep' });
    } else {
      /* 1 nap */
      var nap1s = cursor + ww + offset;
      events.push({ time: nap1s, label: 'Nap starts', type: 'nap', badge: 'nap', badgeText: napDur + ' min' });
      var nap1e = nap1s + napDurH;
      events.push({ time: nap1e, label: 'Nap ends', type: 'wake', badge: null });

      var bed1 = nap1e + ww * 1.5;
      events.push({ time: bed1, label: 'Bedtime', type: 'bed', badge: 'sleep', badgeText: 'Night sleep' });
    }

    return { events: events, prevBed: prevBed, nightDur: nightDur };
  }

  /* =============================================
     RENDER TIMELINE
     ============================================= */
  function renderTimeline(age, wake, schedule) {
    var d = AGE_DATA[age];
    var events = schedule.events;
    var nightDur = schedule.nightDur;

    /* Build 24h segments: night sleep, naps, wake */
    /* First find bedtime from events */
    var bedtime = null;
    for (var i = events.length - 1; i >= 0; i--) {
      if (events[i].type === 'bed') { bedtime = events[i].time; break; }
    }
    if (bedtime === null) bedtime = wake + 14;

    /* Collect nap windows */
    var napWindows = [];
    for (var j = 0; j < events.length; j++) {
      if (events[j].type === 'nap') {
        /* find next wake event */
        for (var k = j + 1; k < events.length; k++) {
          if (events[k].type === 'wake') {
            napWindows.push({ start: events[j].time, end: events[k].time });
            break;
          }
        }
      }
    }

    /* Build segments over 0–24 */
    var segs = [];

    /* Prev night sleep: 0 → wake */
    var prevBedNorm = ((wake - nightDur) % 24 + 24) % 24;
    if (prevBedNorm < wake) {
      segs.push({ start: prevBedNorm, end: wake, cls: 'seg-night' });
      /* Wake time 0..prevBed is also night sleep if it wraps */
    } else {
      /* Wraps midnight */
      segs.push({ start: prevBedNorm, end: 24, cls: 'seg-night' });
      segs.push({ start: 0, end: wake, cls: 'seg-night' });
    }

    /* Wake period from wake to first event */
    /* Add wake stretches between events */
    var prev = wake;
    var allMarkers = [wake].concat(events.map(function(e) { return e.time; }));

    /* Draw wake from wake to first nap */
    segs.push({ start: wake, end: (napWindows.length > 0 ? napWindows[0].start : bedtime), cls: 'seg-wake' });

    /* Draw nap and wake alternating */
    for (var n = 0; n < napWindows.length; n++) {
      segs.push({ start: napWindows[n].start, end: napWindows[n].end, cls: 'seg-nap' });
      var nextStart = n + 1 < napWindows.length ? napWindows[n + 1].start : bedtime;
      segs.push({ start: napWindows[n].end, end: nextStart, cls: 'seg-wake' });
    }

    /* Tonight's sleep: bedtime → end of day (24) */
    if (bedtime <= 24) {
      segs.push({ start: bedtime, end: 24, cls: 'seg-night' });
    }

    /* Remove zero-width segs and sort */
    segs = segs.filter(function(s) { return s.end > s.start && s.end - s.start > 0.01; });

    /* Render bar */
    var html = '';
    segs.forEach(function(s) {
      var w = ((s.end - s.start) / 24 * 100).toFixed(2);
      html += '<div class="timeline-seg ' + s.cls + '" style="width:' + w + '%;"></div>';
    });
    timelineBar.innerHTML = html;

    /* Label key times */
    var labelPts = [];
    labelPts.push({ h: wake, label: fmt12(wake), tag: 'Wake' });
    if (napWindows.length > 0) {
      labelPts.push({ h: napWindows[0].start, label: fmt12(napWindows[0].start), tag: 'Nap 1' });
    }
    if (napWindows.length > 1) {
      labelPts.push({ h: napWindows[1].start, label: fmt12(napWindows[1].start), tag: 'Nap 2' });
    }
    if (bedtime !== null) {
      labelPts.push({ h: bedtime, label: fmt12(bedtime), tag: 'Bedtime' });
    }

    /* Render labels */
    var labHtml = '';
    labelPts.forEach(function(pt) {
      var lp = (((pt.h % 24) + 24) % 24 / 24 * 100).toFixed(2);
      labHtml += '<div class="tl-label" style="left:' + lp + '%;">';
      labHtml += '<span class="tl-time">' + pt.label + '</span>';
      labHtml += '<span class="tl-tag">' + pt.tag + '</span>';
      labHtml += '</div>';
    });
    timelineLabels.innerHTML = labHtml;
  }

  /* =============================================
     RENDER SCHEDULE LIST
     ============================================= */
  function renderScheduleList(events) {
    var html = '';
    events.forEach(function(e) {
      var dotCls = e.type === 'nap' ? 'nap' : (e.type === 'bed' ? 'bed' : 'wake');
      var badgeHtml = '';
      if (e.badge) {
        badgeHtml = '<span class="si-badge ' + e.badge + '">' + e.badgeText + '</span>';
      }
      html += '<div class="schedule-item">';
      html += '<div class="si-dot-wrap"><div class="si-dot ' + dotCls + '"></div></div>';
      html += '<span class="si-time">' + fmt12(e.time) + '</span>';
      html += '<span class="si-label">' + e.label + '</span>';
      html += badgeHtml;
      html += '</div>';
    });
    scheduleList.innerHTML = html;
  }

  /* =============================================
     RENDER TIPS
     ============================================= */
  function renderTips(age) {
    var d = AGE_DATA[age];
    tipsTitle.textContent = 'Tips for ' + d.label;
    var html = '';
    d.tips.forEach(function(tip) {
      html += '<li>' + tip + '</li>';
    });
    tipsList.innerHTML = html;
  }

  /* =============================================
     MAIN CALCULATE
     ============================================= */
  function calculate() {
    var age  = ageSelect.value;
    var wake = parseTime(wakeInput.value);
    var d    = AGE_DATA[age];

    /* Update summary cards */
    totalSleepVal.textContent  = d.totalSleep;
    nightSleepVal.textContent  = d.nightSleep;
    napCountVal.textContent    = d.napCount;
    wakeWindowVal.textContent  = d.wakeWindow;
    napCountSub.textContent    = d.napMin > 0 ? d.napMin + '–' + d.napMax + ' min each' : 'nighttime only';

    /* Update schedule wake label */
    scheduleWakeLabel.textContent = fmt12(wake);

    /* Build schedule */
    var schedule = buildSchedule(age, wake, scheduleStyle);

    /* Render */
    renderScheduleList(schedule.events);
    renderTimeline(age, wake, schedule);
    renderTips(age);
  }

  /* =============================================
     EVENT LISTENERS
     ============================================= */
  ageSelect.addEventListener('change', calculate);
  wakeInput.addEventListener('input', calculate);

  styleBtns.addEventListener('click', function(e) {
    var btn = e.target.closest('.style-btn');
    if (!btn) return;
    scheduleStyle = btn.dataset.style;
    styleBtns.querySelectorAll('.style-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    calculate();
  });

  /* =============================================
     INIT
     ============================================= */
  calculate();

})();
</script>

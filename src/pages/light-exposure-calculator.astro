      fall: [
        {
          icon: 'M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z',
          color: '#f59e0b',
          text: 'Fall is the time to begin transitioning from outdoor-only morning light to a hybrid approach. Sunrise moves later each week — a light box prevents the gradual loss of morning light exposure as days shorten.'
        },
        {
          icon: 'M3 15a4 4 0 0 0 4 4h9a5 5 0 0 0 1.8-9.7 6 6 0 0 0-11.8-1 4 4 0 0 0-3 6.7',
          color: '#7c6aff',
          text: 'As days get shorter, some people notice mood or energy changes beginning in fall — this is the earliest sign of seasonal sensitivity. Starting morning light therapy in October rather than waiting for winter produces better outcomes.'
        }
      ]
    };

    tips = (seasonTips[season] || seasonTips['spring']).slice();

    // Add chronotype-specific tip
    if (chronotype === 'late') {
      tips.push({
        icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
        color: '#ec4899',
        text: 'As a night owl, morning light is your most powerful tool for shifting your clock earlier. Even 15 minutes of bright outdoor light the moment you wake — before coffee, before your phone — will gradually advance your sleep timing over 1–2 weeks.'
      });
    }

    if (isVeryHighLat && season === 'winter') {
      tips.push({
        icon: 'M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2',
        color: '#ff6b52',
        text: 'At your latitude in winter, the sun rises after 9 AM and sets before 3 PM — providing very little usable morning light. A 10,000-lux light box is not optional at this latitude in winter: it is essential for circadian health.'
      });
    }

    return tips;
  }

  // ---- MAIN CALCULATE ----
  function calculate() {
    var wakeHour = getWakeHour();
    var chronotype = document.getElementById('chronotype').value;
    var latSelect = document.getElementById('latitude').value;
    var season = document.getElementById('season').value;
    var outdoorAccess = document.getElementById('outdoor-access').value;
    var lightBox = document.getElementById('light-box').value;

    // Manual sunrise
    var sunriseHour;
    if (latSelect === 'manual') {
      document.getElementById('manual-sunrise-field').style.display = '';
      var manVal = document.getElementById('manual-sunrise').value || '06:30';
      var parts = manVal.split(':').map(Number);
      sunriseHour = parts[0] + parts[1] / 60;
    } else {
      document.getElementById('manual-sunrise-field').style.display = 'none';
      var lat = parseFloat(latSelect);
      var doy = getDayOfYear(season);
      sunriseHour = getSunriseHour(lat, doy);
    }

    var lat = latSelect === 'manual' ? 40 : parseFloat(latSelect);
    var sunsetHour = getSunsetHour(lat, getDayOfYear(season));

    // Clamp sunrise to reasonable range
    sunriseHour = Math.max(3, Math.min(10, sunriseHour));
    sunsetHour = Math.max(14, Math.min(21, sunsetHour));

    // Recommended light start: wake + 30 min (allow alerting period)
    var lightStartHour = wakeHour + 0.5;

    // If sunrise is after lightStart, shift lightStart to sunrise
    if (sunriseHour > lightStartHour && outdoorAccess === 'yes') {
      lightStartHour = sunriseHour;
    }

    // Duration based on source
    var lightDurationMin;
    if (outdoorAccess === 'yes' || lightBox === 'yes') {
      lightDurationMin = 25;
    } else if (outdoorAccess === 'limited' || lightBox === 'low') {
      lightDurationMin = 75;
    } else {
      lightDurationMin = 30; // show even if insufficient
    }

    var lightEndHour = lightStartHour + lightDurationMin / 60;

    // Implied bedtime for avoid window
    var bedtime = wakeHour + 16; // ~16hr day
    var avoidHour = bedtime - 2;

    // Update hero
    var hero = document.getElementById('result-hero');
    var lightFmt = formatTime12(lightStartHour);
    document.getElementById('light-time').textContent = lightFmt.time;
    document.getElementById('light-period').textContent = lightFmt.period;

    var windowAfterMin = Math.round((lightStartHour - wakeHour) * 60);
    var windowAfterText = windowAfterMin <= 30 ? '30 min' : windowAfterMin + ' min';

    hero.className = 'result-hero';
    var subEl = document.getElementById('light-sub');

    if (outdoorAccess === 'yes' || lightBox === 'yes') {
      hero.classList.add('state-great');
      subEl.innerHTML = 'Within <strong>' + windowAfterText + '</strong> of waking for maximum circadian benefit. Aim for <strong>' + lightDurationMin + ' min</strong> of bright light.';
    } else if (outdoorAccess === 'limited' || lightBox === 'low') {
      hero.classList.add('state-good');
      subEl.innerHTML = 'Window access or a lower-lux box requires <strong>60–90 min</strong> to achieve the same circadian effect as 20–30 min of outdoor or 10,000-lux light.';
    } else {
      hero.classList.add('state-limited');
      document.getElementById('light-time').textContent = 'Limited';
      document.getElementById('light-period').textContent = '';
      subEl.innerHTML = 'Indoor office light alone is insufficient for circadian entrainment. <strong>A 10,000-lux light box is strongly recommended.</strong>';
    }

    // Sunrise stat
    var sunriseFmt = formatTime12(sunriseHour);
    document.getElementById('stat-sunrise').textContent = sunriseFmt.time + ' ' + sunriseFmt.period;

    // Duration stat
    var durationLabel = getRecommendedDuration(outdoorAccess, lightBox);
    document.getElementById('stat-duration').textContent = durationLabel;

    // Avoid-light stat
    var avoidFmt = formatTime12(avoidHour);
    document.getElementById('stat-avoid').textContent = avoidFmt.time + ' ' + avoidFmt.period;

    // Timeline
    renderTimeline(wakeHour, lightStartHour, lightDurationMin, sunriseHour, sunsetHour, avoidHour, bedtime);

    // Sun arc
    renderSunArc(sunriseHour, sunsetHour, lightStartHour, lightEndHour, wakeHour);

    // Arc caption
    var arcEl = document.getElementById('arc-caption');
    arcEl.textContent = 'Sunrise at ' + sunriseFmt.time + ' ' + sunriseFmt.period + '. Golden window: ' + lightFmt.time + ' ' + lightFmt.period + ' for ' + lightDurationMin + ' min. Purple tick = your wake time.';

    // Lux sources
    var sources = getLuxSources(outdoorAccess, lightBox, season, lat);
    var sourcesEl = document.getElementById('lux-sources');
    sourcesEl.innerHTML = sources.map(function (s) {
      return '<div class="lux-source-row">' +
        '<div class="lux-source-icon" style="background:' + s.color + '22; color:' + s.color + '">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="' + s.icon + '"/></svg>' +
        '</div>' +
        '<div class="lux-source-body">' +
          '<div class="lux-source-name">' + s.label + '<span class="lux-source-badge" style="background:' + s.color + '22; color:' + s.color + '">' + s.badge + '</span></div>' +
          '<div class="lux-source-meta">' + s.lux + ' &nbsp;·&nbsp; ' + s.duration + '</div>' +
          '<div class="lux-source-desc">' + s.desc + '</div>' +
        '</div>' +
      '</div>';
    }).join('');

    // Seasonal tips
    var tips = getSeasonalTips(season, lat, outdoorAccess, lightBox, chronotype);
    var tipsEl = document.getElementById('tips-list');
    document.getElementById('tips-title').textContent = season.charAt(0).toUpperCase() + season.slice(1) + ' recommendations';
    tipsEl.innerHTML = tips.map(function (t) {
      return '<div class="tip-item">' +
        '<div class="tip-icon" style="background:' + t.color + '22; color:' + t.color + '">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="' + t.icon + '"/></svg>' +
        '</div>' +
        '<p>' + t.text + '</p>' +
      '</div>';
    }).join('');
  }

  // Wire up inputs
  ['wake-time','chronotype','latitude','season','outdoor-access','light-box','manual-sunrise'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('change', calculate);
    if (el) el.addEventListener('input', calculate);
  });

  // Set season from current month
  var month = new Date().getMonth(); // 0-11
  var seasonEl = document.getElementById('season');
  if (month >= 2 && month <= 4) seasonEl.value = 'spring';
  else if (month >= 5 && month <= 7) seasonEl.value = 'summer';
  else if (month >= 8 && month <= 10) seasonEl.value = 'fall';
  else seasonEl.value = 'winter';

  // Initial render
  calculate();
})();
</script>


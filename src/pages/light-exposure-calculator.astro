    },
    lightbox_10k: {
      icon: 'M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18',
      color: '#7c6aff',
      label: '10,000-lux light therapy box',
      lux: '10,000 lux at 12–24"',
      duration: '20–30 min',
      desc: 'Place the box at eye level, 12–24 inches away. Use it during breakfast or while reading — indirect gaze is fine.',
      badge: 'Recommended'
    },
    lightbox_low: {
      icon: 'M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18',
      color: '#ec4899',
      label: 'Lower-lux light box',
      lux: '2,500 lux (est.)',
      duration: '60–90 min',
      desc: 'Use for longer durations to compensate for lower intensity. Position at the same distance as your 10k-lux box instructions.',
      badge: 'Extended use'
    },
    no_access: {
      icon: 'M18.36 18.36A9 9 0 1 1 5.64 5.64M12 3a9 9 0 0 1 9 9',
      color: '#ff6b52',
      label: 'No outdoor or box access',
      lux: '200–500 lux (indoor)',
      duration: 'Not sufficient alone',
      desc: 'Indoor office light alone is insufficient for circadian entrainment. Consider a light therapy box — certified 10,000-lux models start at $50.',
      badge: 'Upgrade needed'
    }
  };

  function getLuxSources(outdoorAccess, lightBox, season, latDeg) {
    var sources = [];
    var isWinter = season === 'winter';
    var isHighLat = Math.abs(latDeg) > 50;

    if (outdoorAccess === 'yes') {
      sources.push(LUX_SOURCES.outdoor_great);
    }
    if (outdoorAccess === 'limited') {
      sources.push(LUX_SOURCES.outdoor_limited);
    }
    if (lightBox === 'yes') {
      sources.push(LUX_SOURCES.lightbox_10k);
    }
    if (lightBox === 'low') {
      sources.push(LUX_SOURCES.lightbox_low);
    }
    if (outdoorAccess === 'no' && lightBox === 'no') {
      sources.push(LUX_SOURCES.no_access);
    }
    // Suggest light box if outdoor is limited + winter + high lat
    if ((isWinter || isHighLat) && lightBox === 'no' && outdoorAccess !== 'no') {
      sources.push({
        icon: 'M12 2a10 10 0 1 0 10 10M12 2v4M12 6l3-3M22 12h-4',
        color: '#10b981',
        label: 'Consider a light therapy box this season',
        lux: '10,000 lux',
        duration: '20–30 min',
        desc: isWinter && isHighLat
          ? 'At your latitude in winter, sunrise is late and sun angle is low. A certified 10,000-lux box used at wake time will substantially supplement limited natural light.'
          : isWinter
            ? 'Winter days are shorter and sun angle is lower. A light box on dark mornings helps maintain circadian consistency.'
            : 'At your latitude, some mornings may have late or low-angle sunrise. A light box is a good backup.',
        badge: 'Seasonal tip'
      });
    }
    return sources;
  }

  function getRecommendedDuration(outdoorAccess, lightBox) {
    if (outdoorAccess === 'yes') return '20–30 min';
    if (lightBox === 'yes') return '20–30 min';
    if (outdoorAccess === 'limited') return '60–90 min';
    if (lightBox === 'low') return '60–90 min';
    return 'Not sufficient';
  }

  // ---- TIMELINE RENDERING ----
  function renderTimeline(wakeHour, lightStartHour, lightDurationMin, sunriseHour, sunsetHour, avoidHour, bedtimeHour) {
    // Represent 24 hours as a bar
    var container = document.getElementById('timeline-bar');
    var labelsEl = document.getElementById('timeline-labels');
    var totalH = 24;

    // Build segments:
    // sleep (before wake), morning neutral, seek light, neutral day, avoid light, sleep
    var segments = [];

    // Sleep before wake (from implied prev bedtime)
    // Bedtime is yesterday's, so offset by 24 if needed
    var prevBed = bedtimeHour < wakeHour ? bedtimeHour : bedtimeHour - 24;
    var sleepStart = ((prevBed % 24) + 24) % 24;
    var sleepEnd = wakeHour;

    // Build a list of time segments across 24-hour bar starting at 0
    // We'll paint the bar by walking from 0 to 24:
    // 0–sleepEnd (continuing sleep from yesterday)
    // sleepEnd–lightStart (neutral morning)
    // lightStart–lightEnd (seek light)
    // lightEnd–avoidHour (neutral day)
    // avoidHour–bed+24 adjusted (avoid light)
    // bed–24 (sleep)

    var lightEndHour = lightStartHour + lightDurationMin / 60;
    var bed24 = ((bedtimeHour % 24) + 24) % 24;

    function seg(startH, endH, color, label) {
      if (endH <= startH) return;
      var pct = (endH - startH) / totalH * 100;
      segments.push({ startH, endH, color, label, pct });
    }

    // From midnight (0) to wake (sleep segment)
    var wake0 = ((wakeHour % 24) + 24) % 24;
    seg(0, wake0, '#1e1b2e', 'sleep');

    // wake to lightStart (neutral, morning prep)
    var ls0 = ((lightStartHour % 24) + 24) % 24;
    if (ls0 > wake0) seg(wake0, ls0, '#f0eef5', 'neutral');

    // lightStart to lightEnd (seek light)
    var le0 = ((lightEndHour % 24) + 24) % 24;
    if (le0 > ls0) seg(ls0, le0, '#f59e0b', 'seek light');
    else if (le0 <= ls0) le0 = ls0; // clamp

    // lightEnd to avoidHour (neutral day)
    var av0 = ((avoidHour % 24) + 24) % 24;
    if (av0 > le0) seg(le0, av0, '#f0eef5', 'neutral');

    // avoidHour to bedtime (avoid light)
    if (bed24 > av0) seg(av0, bed24, '#ff6b52', 'avoid');

    // bedtime to 24 (sleep)
    if (bed24 < 24) seg(bed24, 24, '#1e1b2e', 'sleep');

    container.innerHTML = segments.map(function (s) {
      return '<div title="' + s.label + ' (' + formatTime12(s.startH).time + '–' + formatTime12(s.endH).time + ')" style="flex:0 0 ' + s.pct + '%;background:' + s.color + ';height:100%;"></div>';
    }).join('');

    // Hour labels: 12A, 6A, 12P, 6P, 12A
    labelsEl.innerHTML = ['12A', '6A', '12P', '6P', '12A'].map(function (l) {
      return '<span>' + l + '</span>';
    }).join('');
  }

  // ---- SUN ARC ----
  function renderSunArc(sunriseHour, sunsetHour, lightStartHour, lightEndHour, wakeHour) {
    var svg = document.getElementById('sun-arc-svg');
    var W = 400, H = 200, margin = 40;
    var dayH = sunsetHour - sunriseHour;

    // Map hour to x position (only daylight span)
    function hourToX(h) {
      var t = Math.max(0, Math.min(1, (h - sunriseHour) / dayH));
      return margin + t * (W - margin * 2);
    }

    // Arc: parabola peaking at solar noon
    function hourToY(h) {
      var t = (h - sunriseHour) / dayH;
      return H - 30 - (H - 60) * (4 * t * (1 - t)); // inverted parabola, peak up
    }

    // Build arc path
    var steps = 60;
    var pathD = '';
    for (var i = 0; i <= steps; i++) {
      var frac = i / steps;
      var hh = sunriseHour + frac * dayH;
      var x = hourToX(hh);
      var y = hourToY(hh);
      pathD += (i === 0 ? 'M' : 'L') + x.toFixed(1) + ',' + y.toFixed(1) + ' ';
    }

    // Light window highlight on arc
    var lsX = hourToX(Math.max(lightStartHour, sunriseHour));
    var leX = hourToX(Math.min(lightEndHour, sunsetHour));

    // Sun position at lightStart
    var sunH = lightStartHour;
    var sunX = hourToX(sunH);
    var sunY = hourToY(sunH);

    // Ground line
    var groundY = H - 30;
    var riseX = hourToX(sunriseHour);
    var setX = hourToX(sunsetHour);

    var html = '';

    // Sky gradient background
    html += '<defs>';
    html += '<linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">';
    html += '<stop offset="0%" stop-color="#dbeafe"/>';
    html += '<stop offset="100%" stop-color="#f0f9ff"/>';
    html += '</linearGradient>';
    html += '<clipPath id="arcClip"><path d="' + pathD + 'L' + setX.toFixed(1) + ',' + groundY + ' L' + riseX.toFixed(1) + ',' + groundY + ' Z"/></clipPath>';
    html += '</defs>';

    // Ground
    html += '<rect x="' + margin + '" y="' + groundY + '" width="' + (W - margin * 2) + '" height="18" fill="#d1fae5" rx="3"/>';

    // Light window shading
    var winW = Math.max(0, leX - lsX);
    html += '<rect x="' + lsX.toFixed(1) + '" y="30" width="' + winW.toFixed(1) + '" height="' + (groundY - 30) + '" fill="#f59e0b22" rx="2"/>';

    // Arc path
    html += '<path d="' + pathD + '" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round"/>';

    // Light window border lines
    html += '<line x1="' + lsX.toFixed(1) + '" y1="30" x2="' + lsX.toFixed(1) + '" y2="' + groundY + '" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="4,3"/>';
    html += '<line x1="' + leX.toFixed(1) + '" y1="30" x2="' + leX.toFixed(1) + '" y2="' + groundY + '" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="4,3"/>';

    // Sunrise / sunset markers
    html += '<circle cx="' + riseX.toFixed(1) + '" cy="' + groundY + '" r="4" fill="#f59e0b"/>';
    html += '<circle cx="' + setX.toFixed(1) + '" cy="' + groundY + '" r="4" fill="#f59e0b" opacity="0.4"/>';

    // Wake marker
    var wakeX = hourToX(wakeHour);
    html += '<line x1="' + wakeX.toFixed(1) + '" y1="' + (groundY - 12) + '" x2="' + wakeX.toFixed(1) + '" y2="' + (groundY + 4) + '" stroke="#7c6aff" stroke-width="2"/>';

    // Sun circle on arc (at lightStart)
    if (lightStartHour >= sunriseHour && lightStartHour <= sunsetHour) {
      html += '<circle cx="' + sunX.toFixed(1) + '" cy="' + sunY.toFixed(1) + '" r="8" fill="#f59e0b"/>';
      html += '<circle cx="' + sunX.toFixed(1) + '" cy="' + sunY.toFixed(1) + '" r="13" fill="#f59e0b" opacity="0.2"/>';
    }

    // Labels
    var riseLabel = formatTime12(sunriseHour);
    var setLabel = formatTime12(sunsetHour);
    html += '<text x="' + riseX.toFixed(1) + '" y="' + (groundY + 15) + '" text-anchor="middle" font-size="9" fill="#7c778e" font-family="Sora,sans-serif">Rise ' + riseLabel.time + '</text>';
    html += '<text x="' + setX.toFixed(1) + '" y="' + (groundY + 15) + '" text-anchor="middle" font-size="9" fill="#7c778e" font-family="Sora,sans-serif">Set ' + setLabel.time + '</text>';

    // Light window label
    var midWinX = (lsX + leX) / 2;
    html += '<text x="' + midWinX.toFixed(1) + '" y="50" text-anchor="middle" font-size="9" fill="#d97706" font-weight="700" font-family="Sora,sans-serif">LIGHT WINDOW</text>';

    // Wake label
    html += '<text x="' + wakeX.toFixed(1) + '" y="' + (groundY - 15) + '" text-anchor="middle" font-size="9" fill="#7c6aff" font-weight="700" font-family="Sora,sans-serif">Wake</text>';

    svg.innerHTML = html;
  }

  // ---- SEASONAL TIPS ----
  function getSeasonalTips(season, latDeg, outdoorAccess, lightBox, chronotype) {
    var tips = [];
    var isHighLat = Math.abs(latDeg) > 48;
    var isVeryHighLat = Math.abs(latDeg) > 55;

    var seasonTips = {
      winter: [
        {
          icon: 'M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18',

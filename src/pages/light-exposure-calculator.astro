<script is:inline>
(function () {

  // ---- SOLAR DECLINATION & SUNRISE ESTIMATE ----
  // Returns approximate sunrise hour (decimal) for a given latitude and day-of-year
  function getSunriseHour(latDeg, dayOfYear) {
    var lat = latDeg * Math.PI / 180;
    // Solar declination angle (radians)
    var decl = -0.40928 * Math.cos(2 * Math.PI / 365 * (dayOfYear + 10));
    // Hour angle at sunrise
    var cosH = -Math.tan(lat) * Math.tan(decl);
    // Clamp for polar cases
    cosH = Math.max(-1, Math.min(1, cosH));
    var H = Math.acos(cosH) * 180 / Math.PI; // degrees
    // Sunrise = solar noon - H/15 hours (solar noon ~= 12:00 local mean solar time)
    var sunrise = 12 - H / 15;
    return sunrise;
  }

  // Returns approximate sunset hour for same params
  function getSunsetHour(latDeg, dayOfYear) {
    var lat = latDeg * Math.PI / 180;
    var decl = -0.40928 * Math.cos(2 * Math.PI / 365 * (dayOfYear + 10));
    var cosH = -Math.tan(lat) * Math.tan(decl);
    cosH = Math.max(-1, Math.min(1, cosH));
    var H = Math.acos(cosH) * 180 / Math.PI;
    return 12 + H / 15;
  }

  // Approximate day-of-year from season
  function getDayOfYear(season) {
    var map = { spring: 90, summer: 172, fall: 265, winter: 355 };
    return map[season] || 172;
  }

  function formatTime12(decimalHours) {
    var h = ((decimalHours % 24) + 24) % 24;
    var period = h >= 12 ? 'PM' : 'AM';
    var displayH = Math.floor(h) % 12;
    if (displayH === 0) displayH = 12;
    var m = Math.round((h - Math.floor(h)) * 60);
    if (m === 60) { displayH++; m = 0; if (displayH === 13) displayH = 1; }
    return {
      time: displayH + ':' + String(m).padStart(2, '0'),
      period: period,
      decimal: h
    };
  }

  function getWakeHour() {
    var val = document.getElementById('wake-time').value || '07:00';
    var parts = val.split(':').map(Number);
    return parts[0] + parts[1] / 60;
  }

  // Recommended sleep duration by chronotype (used to estimate bedtime)
  var CHRONOTYPE_SLEEP = { early: 7.5, intermediate: 8.0, late: 8.5 };

  // Returns implied bedtime based on wake time and chronotype sleep duration
  function getBedtimeHour(wakeHour, chronotype) {
    return wakeHour - CHRONOTYPE_SLEEP[chronotype];
  }

  // ---- LUX SOURCE RECOMMENDATIONS ----
  var LUX_SOURCES = {
    outdoor_great: {
      icon: 'M12 3v1M12 20v1M4.22 4.22l.71.71M18.36 18.36l.71.71M1 12h2M20 12h2M4.22 19.78l.71-.71M18.36 5.64l.71-.71M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z',
      color: '#f59e0b',
      label: 'Outdoor morning sunlight',
      lux: '5,000–100,000 lux',
      duration: '10–30 min',
      desc: 'Step outside within 30–60 min of waking — even on overcast days. No sunglasses during your light window.',
      badge: 'Best option'
    },
    outdoor_limited: {
      icon: 'M17 8a5 5 0 0 1-10 0M12 3v5M3 21h18M5 21V10M19 21V10',
      color: '#38b6ff',
      label: 'Bright indoor window',
      lux: '500–2,000 lux',
      duration: '60–90 min',
      desc: 'Sit as close as possible to a south-facing window. Keep the blinds fully open and avoid tinting or heavy glass.',

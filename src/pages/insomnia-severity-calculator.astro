  }
  .gauge-score {
    font-size: 2.8rem; font-weight: 800; letter-spacing: -0.04em;
    line-height: 1; font-family: 'Space Grotesk', monospace;
    color: var(--text);
  }
  .score-hero.sev-none .gauge-score { color: var(--mint); }
  .score-hero.sev-sub .gauge-score { color: var(--amber); }
  .score-hero.sev-mod .gauge-score { color: var(--coral); }
  .score-hero.sev-sev .gauge-score { color: var(--rose); }
  .gauge-denom { font-size: 0.9rem; font-weight: 700; color: var(--text-soft); }
  .gauge-label-inner {
    font-size: 0.7rem; font-weight: 700; margin-top: 0.15rem;
    text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--text-soft);
  }
  .score-hero.sev-none .gauge-label-inner { color: var(--mint); }
  .score-hero.sev-sub .gauge-label-inner { color: var(--amber); }
  .score-hero.sev-mod .gauge-label-inner { color: var(--coral); }
  .score-hero.sev-sev .gauge-label-inner { color: var(--rose); }

  /* Severity badge */
  .severity-badge {
    display: inline-block; padding: 0.35rem 1rem;
    border-radius: 20px; font-size: 0.88rem; font-weight: 700;
    margin-bottom: 0.5rem; background: #f0eef5; color: var(--text-soft);
    transition: all 0.3s;

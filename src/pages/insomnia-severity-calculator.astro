  /* ===== RESULTS PANEL ===== */
  .results-panel { display: flex; flex-direction: column; gap: 1rem; }

  /* Score hero with circular gauge */
  .score-hero {
    background: var(--card); border: 2px solid var(--border);
    border-radius: var(--radius); padding: 1.5rem 1.5rem 1.25rem;
    text-align: center; transition: border-color 0.3s, background 0.3s;
  }
  .score-hero.sev-none { border-color: var(--mint); background: #f0fdf8; }

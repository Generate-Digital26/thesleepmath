    border-color: var(--primary); background: var(--primary-soft);
    color: var(--primary); font-weight: 700;
  }

  /* Nav buttons */
  .nav-buttons {
    display: flex; gap: 0.5rem; margin-top: 1.1rem; padding-top: 1rem;

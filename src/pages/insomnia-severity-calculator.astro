  .score-hero.sev-none .severity-badge { background: #dcfce7; color: #065f46; }
  .score-hero.sev-sub .severity-badge { background: #fef3c7; color: #78350f; }
  .score-hero.sev-mod .severity-badge { background: #ffe4de; color: #9a1c10; }
  .score-hero.sev-sev .severity-badge { background: #fce7f3; color: #9d174d; }

  .severity-sub {
    font-size: 0.82rem; color: var(--text-mid); line-height: 1.55;
    max-width: 360px; margin: 0 auto;
  }

  /* Component breakdown */
  .breakdown-card {
    background: var(--card); border: 1.5px solid var(--border);
    border-radius: var(--radius); padding: 1.25rem;
  }
  .breakdown-card h3 { font-size: 0.88rem; font-weight: 700; margin-bottom: 0.85rem; }
  .comp-list { display: flex; flex-direction: column; gap: 0.55rem; }
  .comp-item { display: flex; flex-direction: column; gap: 0.25rem; }
  .comp-top { display: flex; align-items: center; gap: 0.5rem; }
  .comp-name { font-size: 0.78rem; font-weight: 600; color: var(--text); flex: 1; }
  .comp-score-badge {
    font-size: 0.7rem; font-weight: 800; padding: 0.1rem 0.45rem;
    border-radius: 99px; flex-shrink: 0;
  }
  .comp-score-badge.s0 { background: #dcfce7; color: #065f46; }
  .comp-score-badge.s1 { background: #ecfdf5; color: #047857; }
  .comp-score-badge.s2 { background: #fef9c3; color: #78350f; }
  .comp-score-badge.s3 { background: #ffe4de; color: #9a1c10; }
  .comp-score-badge.s4 { background: #fce7f3; color: #9d174d; }
  .comp-bar-track {
    height: 5px; background: var(--border); border-radius: 99px; overflow: hidden;
  }
  .comp-bar-fill {
    height: 100%; border-radius: 99px;
    transition: width 0.4s cubic-bezier(0.4,0,0.2,1);
  }
  .comp-bar-fill.s0 { background: var(--mint); }
  .comp-bar-fill.s1 { background: var(--mint); }
  .comp-bar-fill.s2 { background: var(--amber); }
  .comp-bar-fill.s3 { background: var(--coral); }
  .comp-bar-fill.s4 { background: var(--rose); }

  /* Recommendations card */
  .recs-card {
    background: var(--card); border: 1.5px solid var(--border);
    border-radius: var(--radius); padding: 1.25rem;
  }
  .recs-card h3 { font-size: 0.88rem; font-weight: 700; margin-bottom: 0.85rem; }
  .recs-list { display: flex; flex-direction: column; gap: 0.65rem; }
  .rec-item {
    display: flex; gap: 0.75rem; align-items: flex-start;
    padding: 0.85rem; border-radius: var(--radius-sm); border: 1.5px solid;
  }
  .rec-item.rec-good { border-color: #a7f3d0; background: #f0fdf8; }
  .rec-item.rec-fair { border-color: #fde68a; background: #fffbeb; }
  .rec-item.rec-poor { border-color: #ffd0c8; background: #fff6f4; }
  .rec-item.rec-severe { border-color: #fbcfe8; background: #fdf2f8; }
  .rec-icon {
    width: 32px; height: 32px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .rec-icon svg { width: 16px; height: 16px; }
  .rec-good .rec-icon { background: #dcfce7; }
  .rec-fair .rec-icon { background: #fef9c3; }
  .rec-poor .rec-icon { background: #ffe4de; }
  .rec-severe .rec-icon { background: #fce7f3; }
  .rec-title { font-size: 0.8rem; font-weight: 700; margin-bottom: 0.2rem; }
  .rec-good .rec-title { color: #065f46; }
  .rec-fair .rec-title { color: #78350f; }
  .rec-poor .rec-title { color: #9a1c10; }
  .rec-severe .rec-title { color: #9d174d; }
  .rec-desc { font-size: 0.75rem; color: var(--text-mid); line-height: 1.5; }

  /* Info card / threshold table */
  .info-card {
    background: var(--card); border: 1.5px solid var(--border);
    border-radius: var(--radius); padding: 1.25rem;
  }
  .info-card h3 { font-size: 0.88rem; font-weight: 700; margin-bottom: 0.8rem; }
  .threshold-table { display: flex; flex-direction: column; gap: 0; border-radius: 8px; overflow: hidden; border: 1px solid var(--border); }
  .thresh-row { display: grid; grid-template-columns: 60px 90px 1fr; gap: 0; padding: 0.55rem 0.75rem; font-size: 0.75rem; }
  .thresh-row-head { background: var(--bg-tint); font-weight: 700; color: var(--text-soft); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .thresh-row-none { background: #f0fdf8; border-top: 1px solid var(--border); }
  .thresh-row-sub { background: #fffbeb; border-top: 1px solid var(--border); }
  .thresh-row-mod { background: #fff6f4; border-top: 1px solid var(--border); }
  .thresh-row-sev { background: #fdf2f8; border-top: 1px solid var(--border); }
  .thresh-range { font-weight: 700; }
  .thresh-row-none .thresh-range { color: var(--mint); }
  .thresh-row-sub .thresh-range { color: var(--amber); }
  .thresh-row-mod .thresh-range { color: var(--coral); }
  .thresh-row-sev .thresh-range { color: var(--rose); }
  .thresh-rating { font-weight: 600; color: var(--text-mid); }
  .thresh-desc { color: var(--text-soft); line-height: 1.45; }
  .info-cite { font-size: 0.68rem; color: var(--text-soft); margin-top: 0.6rem; font-style: italic; }

  /* ===== SCIENCE ===== */
  .science-section { max-width: 960px; margin: 0 auto; padding: 0 2rem 3rem; }
  .science-card {
    background: var(--bg); border: 1.5px solid var(--border);
    border-radius: var(--radius); padding: 2rem;
  }
  .science-card h2 { font-size: 1.25rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.75rem; }
  .science-card p { font-size: 0.88rem; color: var(--text-mid); line-height: 1.65; margin-bottom: 0.85rem; }
  .formula-box {
    background: #1e1b2e; color: #edeaff; border-radius: 10px;
    padding: 1rem 1.25rem; font-family: 'Space Grotesk', monospace;
    font-size: 0.88rem; margin: 1rem 0; text-align: center;
  }
  .formula-box .formula-main { font-size: 0.98rem; font-weight: 700; margin-bottom: 0.3rem; }
  .formula-box .formula-desc { font-size: 0.72rem; color: #a8a3be; line-height: 1.6; }
  .citation {
    font-size: 0.78rem; color: var(--text-soft); line-height: 1.55;
    padding-left: 0.85rem; border-left: 2px solid var(--border);
  }
  .citation em { color: var(--text-mid); }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .calc-header { padding: 1rem 1.25rem 0; }
    .disclaimer-banner { padding: 0 1.25rem; }
    .calc-layout {
      grid-template-columns: 1fr; padding: 1.25rem; gap: 1.25rem;
    }
    .input-panel { position: static; max-height: none; }
    .science-section { padding: 0 1.25rem 2rem; }
    .thresh-row { grid-template-columns: 55px 80px 1fr; font-size: 0.7rem; }
  }
  @media (max-width: 480px) {
    .option-btn { padding: 0.5rem 0.7rem; font-size: 0.75rem; }
    .gauge-wrap { width: 160px; height: 160px; }
    .gauge-svg { width: 160px; height: 160px; }
    .gauge-score { font-size: 2.3rem; }
  }
</style>

<script is:inline>
(function () {

  // =====================
  //   STATE
  // =====================
  var state = { q1: -1, q2: -1, q3: -1, q4: -1, q5: -1, q6: -1, q7: -1 };

  var currentSection = 1;
  var TOTAL_SECTIONS = 3;

  // =====================
  //   COMPONENT META
  // =====================
  var COMP_META = [
    { key: 'q1', label: 'Falling Asleep' },
    { key: 'q2', label: 'Staying Asleep' },
    { key: 'q3', label: 'Early Waking' },
    { key: 'q4', label: 'Satisfaction' },
    { key: 'q5', label: 'Noticeability' },
    { key: 'q6', label: 'Worry' },
    { key: 'q7', label: 'Daily Impact' }
  ];

  // =====================
  //   RECOMMENDATION TEMPLATES PER QUESTION
  // =====================
  var ITEM_RECS = {
    q1: 'Practice stimulus control: only go to bed when sleepy. If you can\'t sleep within 20 minutes, get up.',
    q2: 'Avoid checking the clock. Consider sleep restriction therapy to consolidate sleep.',
    q3: 'Ensure your bedroom is dark. Light exposure timing may need adjustment — try our Light Exposure Calculator.',
    q4: 'Sleep dissatisfaction often improves with better sleep efficiency. Try our Sleep Efficiency Calculator.',
    q5: 'When sleep problems are visible to others, it\'s a signal to seek professional guidance.',
    q6: 'Sleep anxiety feeds insomnia. CBT-I specifically targets sleep-related worry with proven techniques.',
    q7: 'Daytime impairment from poor sleep compounds over time. Prioritize treatment to prevent long-term effects.'
  };

  // =====================
  //   SCORING
  // =====================
  function getTotal() {
    var total = 0;
    for (var i = 1; i <= 7; i++) {
      var v = state['q' + i];
      if (v > 0) total += v;
    }
    return total;
  }

  function getSeverity(score) {
    if (score <= 7) return {
      cls: 'sev-none', badge: 'No Clinical Insomnia', inner: 'No Insomnia',
      color: '#10b981', sub: 'Score 0–7: Your sleep appears healthy. Maintain good habits.',
      level: 'none'
    };
    if (score <= 14) return {
      cls: 'sev-sub', badge: 'Subthreshold Insomnia', inner: 'Subthreshold',
      color: '#f59e0b', sub: 'Score 8–14: Mild sleep difficulties present. Targeted improvements can help.',
      level: 'sub'
    };
    if (score <= 21) return {
      cls: 'sev-mod', badge: 'Moderate Clinical Insomnia', inner: 'Moderate',
      color: '#ff6b52', sub: 'Score 15–21: Clinical insomnia detected. CBT-I is the recommended first-line treatment.',
      level: 'mod'
    };
    return {
      cls: 'sev-sev', badge: 'Severe Clinical Insomnia', inner: 'Severe',
      color: '#ec4899', sub: 'Score 22–28: Severe insomnia. Seek clinical evaluation as soon as possible.',
      level: 'sev'
    };
  }

  // =====================
  //   GAUGE (circular SVG arc)
  // =====================
  var CIRC = 2 * Math.PI * 78; // ~490.09
  var ARC_SWEEP = CIRC * 0.75; // ~367.57 (270 degrees)

  function setGaugeArc(score) {
    var arc = document.getElementById('gauge-arc');
    if (!arc) return;
    var frac = Math.min(1, Math.max(0, score / 28));
    var drawn = frac * ARC_SWEEP;
    var offset = CIRC - drawn;
    arc.setAttribute('stroke-dasharray', CIRC.toFixed(2));
    arc.setAttribute('stroke-dashoffset', offset.toFixed(2));
    var sev = getSeverity(score);
    arc.setAttribute('stroke', sev.color);
  }

  // =====================
  //   COMPONENT BREAKDOWN
  // =====================
  function buildCompList() {
    var html = '';
    for (var i = 0; i < COMP_META.length; i++) {
      var c = COMP_META[i];
      var v = state[c.key];
      var s = v < 0 ? 0 : v;
      var pct = (s / 4) * 100;
      var scoreLabels = ['0 — None', '1 — Mild', '2 — Moderate', '3 — Severe', '4 — Very Severe'];
      html += '<div class="comp-item">' +
        '<div class="comp-top">' +
          '<span class="comp-name">' + c.label + '</span>' +
          '<span class="comp-score-badge s' + s + '">' + scoreLabels[s] + '</span>' +
        '</div>' +
        '<div class="comp-bar-track">' +
          '<div class="comp-bar-fill s' + s + '" style="width:' + pct.toFixed(1) + '%"></div>' +
        '</div>' +
      '</div>';
    }
    return html;
  }

  // =====================
  //   RECOMMENDATIONS
  // =====================
  function buildRecCard(level, title, desc) {
    var iconMap = {
      good: '<svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
      fair: '<svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>',
      poor: '<svg viewBox="0 0 24 24" fill="none" stroke="#ff6b52" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
      severe: '<svg viewBox="0 0 24 24" fill="none" stroke="#ec4899" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>'
    };
    var recClass = level === 'severe' ? 'rec-severe' : level === 'poor' ? 'rec-poor' : level === 'fair' ? 'rec-fair' : 'rec-good';
    return '<div class="rec-item ' + recClass + '">' +
      '<div class="rec-icon">' + (iconMap[level] || iconMap.fair) + '</div>' +
      '<div><div class="rec-title">' + title + '</div><div class="rec-desc">' + desc + '</div></div>' +
    '</div>';
  }

  function getWorstItems() {
    var items = [];
    for (var i = 0; i < COMP_META.length; i++) {
      var c = COMP_META[i];
      var v = state[c.key];
      if (v > 0) items.push({ key: c.key, label: c.label, score: v });
    }
    items.sort(function(a, b) { return b.score - a.score; });
    return items.slice(0, 3);
  }

  function buildRecs() {
    var score = getTotal();
    var sev = getSeverity(score);
    var html = '';

    // General recommendation based on severity
    if (sev.level === 'none') {
      html += buildRecCard('good', 'Your sleep appears healthy',
        'Your ISI score is in the healthy range. Maintain good sleep hygiene practices: consistent sleep and wake times, a dark and cool bedroom, and limited caffeine after noon.');
    } else if (sev.level === 'sub') {
      html += buildRecCard('fair', 'Mild sleep difficulties detected',
        'You have mild sleep difficulties. Sleep hygiene improvements and consistent sleep scheduling may help. Consider the sleep hygiene audit on this site.');
    } else if (sev.level === 'mod') {
      html += buildRecCard('poor', 'Clinical insomnia — CBT-I recommended',
        'Clinical insomnia detected. CBT-I (Cognitive Behavioral Therapy for Insomnia) is the recommended first-line treatment. Speak to your doctor about a referral to a CBT-I therapist or validated digital program.');
    } else {
      html += buildRecCard('severe', 'Severe insomnia — seek help promptly',
        'Severe insomnia requires clinical attention. CBT-I and/or pharmacotherapy should be discussed with a sleep medicine specialist as soon as possible. Do not delay seeking evaluation.');
    }

    // Top 3 worst-scoring items with specific recommendations
    var worst = getWorstItems();
    for (var i = 0; i < worst.length; i++) {
      var w = worst[i];
      var rec = ITEM_RECS[w.key];
      if (rec) {
        var itemLevel = w.score >= 4 ? 'severe' : w.score >= 3 ? 'poor' : 'fair';
        html += buildRecCard(itemLevel, w.label + ' (scored ' + w.score + '/4)', rec);
      }
    }

    return html;
  }

  // =====================
  //   RENDER
  // =====================
  function render() {
    var score = getTotal();
    var sev = getSeverity(score);

    // Gauge
    var scoreEl = document.getElementById('gauge-score');
    if (scoreEl) scoreEl.textContent = score;
    setGaugeArc(score);

    var innerEl = document.getElementById('gauge-label-inner');
    if (innerEl) innerEl.textContent = sev.inner;

    // Hero class
    var hero = document.getElementById('score-hero');
    if (hero) hero.className = 'score-hero ' + sev.cls;

    // Badge
    var badgeEl = document.getElementById('severity-badge');
    if (badgeEl) badgeEl.textContent = sev.badge;

    // Sub text
    var subEl = document.getElementById('severity-sub');
    if (subEl) subEl.textContent = sev.sub;

    // Component breakdown
    var compList = document.getElementById('comp-list');
    if (compList) compList.innerHTML = buildCompList();

    // Recommendations
    var recsList = document.getElementById('recs-list');
    if (recsList) recsList.innerHTML = buildRecs();
  }

  // =====================
  //   SECTION NAVIGATION
  // =====================
  function showSection(n) {
    for (var i = 1; i <= TOTAL_SECTIONS; i++) {
      var el = document.getElementById('sec-' + i);
      if (el) el.classList.toggle('active', i === n);
    }
    currentSection = n;

    // Progress
    var pct = ((n - 1) / TOTAL_SECTIONS) * 100;
    var fill = document.getElementById('progress-fill');
    if (fill) fill.style.width = pct.toFixed(0) + '%';
    var lbl = document.getElementById('progress-label');
    if (lbl) lbl.textContent = 'Section ' + n + ' of ' + TOTAL_SECTIONS;

    // Nav buttons
    var prev = document.getElementById('btn-prev');
    var next = document.getElementById('btn-next');
    if (prev) prev.disabled = n === 1;
    if (next) {
      if (n === TOTAL_SECTIONS) {
        next.innerHTML = 'See Results ✓';
      } else {
        next.innerHTML = 'Next <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>';
      }
    }

    // Scroll input panel to top
    var panel = document.querySelector('.input-panel');
    if (panel) panel.scrollTop = 0;

    render();
  }

  var prevBtn = document.getElementById('btn-prev');
  var nextBtn = document.getElementById('btn-next');

  if (prevBtn) prevBtn.addEventListener('click', function () {
    if (currentSection > 1) showSection(currentSection - 1);
  });

  if (nextBtn) nextBtn.addEventListener('click', function () {
    if (currentSection < TOTAL_SECTIONS) {
      showSection(currentSection + 1);
    } else {
      // Mark 100% complete
      var fill = document.getElementById('progress-fill');
      if (fill) fill.style.width = '100%';
      var lbl = document.getElementById('progress-label');
      if (lbl) lbl.textContent = 'Complete!';
      render();
      // Scroll to results on mobile
      var hero = document.getElementById('score-hero');
      if (hero && window.innerWidth < 768) {
        hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  });

  // =====================
  //   OPTION BUTTONS (event delegation)
  // =====================
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.option-btn');
    if (!btn) return;

    var comp = btn.getAttribute('data-comp');
    var val = parseInt(btn.getAttribute('data-val'), 10);
    if (!comp || isNaN(val)) return;

    // Deselect siblings in the same option-group
    var group = btn.closest('.option-group');
    if (group) {
      var btns = group.querySelectorAll('.option-btn');
      for (var i = 0; i < btns.length; i++) btns[i].classList.remove('selected');
    }
    btn.classList.add('selected');

    state[comp] = val;
    render();
  });

  // =====================
  //   INIT
  // =====================
  showSection(1);

})();
</script>

</style>

<script is:inline>
(function () {
  /* ---- DOM refs ---- */
  var wakeInput    = document.getElementById('wake-time');
  var nowInput     = document.getElementById('now-time');
  var bedInput     = document.getElementById('bed-time');
  var tiredGrid    = document.getElementById('tiredness-grid');
  var goalBtns     = document.getElementById('goal-btns');
  var resultHero   = document.getElementById('result-hero');
  var resultVerdict = document.getElementById('result-verdict');
  var resultIcon   = document.getElementById('result-icon');
  var napStartEl   = document.getElementById('nap-start-time');
  var napAlarmEl   = document.getElementById('nap-alarm-time');
  var resultSub    = document.getElementById('result-sub');
  var pressureFill = document.getElementById('pressure-fill');
  var pressureLabel = document.getElementById('pressure-label');
  var pressureDesc = document.getElementById('pressure-desc');
  var hoursAwakeStat = document.getElementById('hours-awake-stat');
  var hoursToBedStat = document.getElementById('hours-to-bed-stat');
  var dipStatusStat  = document.getElementById('dip-status-stat');
  var timelineBar    = document.getElementById('timeline-bar');
  var timelineLabels = document.getElementById('timeline-labels');

  var tiredLevel = 3;
  var goal = 'best';

  /* ---- helpers ---- */
  function parseTime(val) {
    var parts = val.split(':').map(Number);
    return parts[0] + parts[1] / 60;
  }

  function mod24(h) { return ((h % 24) + 24) % 24; }

  function fmt12(h) {
    h = mod24(h);
    var period = h >= 12 ? 'PM' : 'AM';
    var hh = Math.floor(h) % 12; if (hh === 0) hh = 12;
    var mm = Math.round((h - Math.floor(h)) * 60);
    return hh + ':' + (mm < 10 ? '0' : '') + mm + ' ' + period;
  }

  function napDuration(goal, tiredLevel, hoursAwake, hoursToBed) {
    /* returns minutes */
    if (goal === 'power') return 20;
    if (goal === 'full') {
      /* if less than 2.5h until bed, can't do 90min */
      if (hoursToBed < 2.5) return 60;
      return 90;
    }
    /* best: decide based on tiredness + hours awake */
    if (tiredLevel >= 4 || hoursAwake >= 9) {
      if (hoursToBed >= 2.5) return 90;
      return 60;
    }
    if (tiredLevel >= 3 || hoursAwake >= 6) {
      if (hoursToBed >= 2.0) return 60;
      return 20;
    }
    return 20;
  }

  function getRecommendedType(minutes) {
    if (minutes <= 20) return 'power';
    if (minutes <= 60) return 'restorative';
    return 'cycle';
  }

  function napBenefitText(minutes) {
    if (minutes <= 20) return minutes + '-min power nap · Wake refreshed, no grogginess';
    if (minutes <= 60) return minutes + '-min restorative nap · Deep memory boost, allow 15 min grogginess';
    return minutes + '-min full cycle · Maximum restoration, wakes from light sleep';
  }

  /* ---- Main calculate ---- */
  function calculate() {
    var wake  = parseTime(wakeInput.value);
    var now   = parseTime(nowInput.value);
    var bed   = parseTime(bedInput.value);

    /* handle crossing midnight */
    var hoursAwake = now - wake;
    if (hoursAwake < 0) hoursAwake += 24;
    var hoursToBed = bed - now;
    if (hoursToBed < 0) hoursToBed += 24;
    var totalSleepWindow = bed - wake;
    if (totalSleepWindow < 0) totalSleepWindow += 24;

    /* Optimal dip window: 6–8h after wake */
    var dipStart = mod24(wake + 6);
    var dipEnd   = mod24(wake + 8);

    /* Forbidden zone: 2–3h before bed */
    var forbiddenStart = mod24(bed - 3);
    var forbiddenEnd   = bed;

    /* Determine nap duration */
    var napMins  = napDuration(goal, tiredLevel, hoursAwake, hoursToBed);
    var napHours = napMins / 60;

    /* State logic */
    var state, verdict, napStart, alarmTime, subText;

    /* Is now in forbidden zone? */
    var nowForbidden = isInWindow(now, forbiddenStart, bed);
    /* Is now before the dip starts? */
    var beforeDip = hoursAwake < 6;
    /* Is now past dip but not forbidden? */
    var inDip = isInWindow(now, dipStart, dipEnd) || (hoursAwake >= 6 && hoursAwake <= 10 && !nowForbidden);

    if (nowForbidden || hoursToBed < 2) {
      /* Too late — skip */
      state = 'state-skip';
      verdict = 'Skip the nap';
      napStart = now;
      alarmTime = now;
      var hoursUntilForbidden = forbiddenStart - now; if (hoursUntilForbidden < 0) hoursUntilForbidden += 24;
      subText = 'You\'re in the circadian forbidden zone — napping now will delay tonight\'s sleep by 30–60 min. Next safe window: ' + fmt12(mod24(bed + 8)) + ' tomorrow.';
    } else if (beforeDip) {
      /* Too early — wait */
      state = 'state-wait';
      verdict = 'Wait until ' + fmt12(dipStart);
      napStart = dipStart;
      alarmTime = mod24(dipStart + napHours);
      subText = 'Sleep pressure is still building (' + hoursAwake.toFixed(1) + 'h awake). The circadian dip begins at ' + fmt12(dipStart) + ' — that\'s when napping will be easiest and most effective.';
    } else {
      /* Good window — nap now */
      state = 'state-nap';
      verdict = 'Nap now!';
      napStart = now;
      alarmTime = mod24(now + napHours);
      subText = napBenefitText(napMins);
    }

    /* Update hero */
    resultHero.className = 'result-hero ' + state;
    resultVerdict.textContent = verdict;

    /* Update icon SVG */
    var iconSvg = '';
    if (state === 'state-nap') {
      iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
    } else if (state === 'state-wait') {
      iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
    } else {
      iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>';
    }
    resultIcon.innerHTML = iconSvg;

    napStartEl.textContent = fmt12(napStart);
    napAlarmEl.textContent  = fmt12(alarmTime);
    resultSub.textContent   = subText;

    /* Show/hide times when skipping */
    var timesEl = document.getElementById('result-times');
    if (state === 'state-skip') {
      timesEl.style.opacity = '0.4';
    } else {
      timesEl.style.opacity = '1';
    }

    /* Nap type cards */
    var recommended = getRecommendedType(napMins);
    document.getElementById('card-power').className       = 'nap-card' + (recommended === 'power' ? ' recommended' : '');
    document.getElementById('card-restorative').className = 'nap-card' + (recommended === 'restorative' ? ' recommended' : '');
    document.getElementById('card-cycle').className       = 'nap-card' + (recommended === 'cycle' ? ' recommended' : '');

    /* Sleep pressure */
    updatePressure(hoursAwake, hoursToBed, state);

    /* Circadian timeline */
    updateTimeline(wake, now, dipStart, dipEnd, forbiddenStart, bed);

    /* Stats */
    hoursAwakeStat.textContent = hoursAwake.toFixed(1) + 'h';
    hoursToBedStat.textContent = hoursToBed.toFixed(1) + 'h';
    dipStatusStat.textContent  = nowForbidden ? 'Forbidden' : (inDip ? 'Active' : (beforeDip ? 'Not yet' : 'Passed'));
    dipStatusStat.style.color  = nowForbidden ? '#dc2626' : (inDip ? '#10b981' : 'var(--text)');
  }

  function isInWindow(t, start, end) {
    /* handles same-day windows, simple comparison */
    if (start <= end) return t >= start && t < end;
    /* wraps midnight */
    return t >= start || t < end;
  }

  function updatePressure(hoursAwake, hoursToBed, state) {
    void hoursToBed;
    var pct, label, color, desc;
    if (hoursAwake < 6) {
      pct = 20; label = 'Low'; color = '#38b6ff';
      desc = 'Sleep pressure is still low (' + hoursAwake.toFixed(1) + 'h awake). Napping now may be difficult — adenosine hasn\'t built up enough yet.';
    } else if (hoursAwake < 9) {
      pct = 55; label = 'Ideal'; color = '#10b981';
      desc = 'Ideal nap window — circadian dip is active and adenosine has built up enough to fall asleep quickly.';
    } else if (hoursAwake < 12) {
      pct = 75; label = 'High'; color = '#f59e0b';
      desc = 'Sleep pressure is high. Napping is helpful but keep it short to avoid disrupting tonight\'s sleep.';
    } else {
      pct = 92; label = 'Very high'; color = '#ef4444';
      desc = 'Very high sleep pressure — you\'re running on low adenosine reserves. A nap helps but you still need a full night\'s sleep tonight.';
    }
    if (state === 'state-skip') {
      pct = 85; label = 'Too late'; color = '#dc2626';
      desc = 'Napping now would spend adenosine reserves needed for tonight. Protect your bedtime instead.';
    }
    pressureFill.style.width = pct + '%';
    pressureFill.style.background = color;
    pressureLabel.style.color = color;
    pressureLabel.textContent = label;
    pressureDesc.textContent = desc;
  }

  function updateTimeline(wake, now, dipStart, dipEnd, forbiddenStart, bed) {
    /* Build 24h timeline from midnight */
    /* dipStart and dipEnd params consumed via dipS/dipE derived below */
    void dipStart; void dipEnd;

    /* segments in order: midnight sleep, active, dip, nap window, forbidden, bed */
    /* Strategy: build sorted list of events */
    var segments = [];

    /* pre-wake sleep (midnight to wake) */
    if (wake > 0) {
      segments.push({ start: 0, end: wake, cls: 'seg-sleep' });
    }

    /* active period: wake to dip start */
    var dipS = mod24(wake + 6);
    var dipE = mod24(wake + 8);
    /* clamp dipE to not overlap forbidden */
    var forbS = mod24(bed - 3);

    /* active: wake → dip start */
    if (dipS > wake) {
      segments.push({ start: wake, end: dipS, cls: 'seg-active' });
    }
    /* dip: dipStart → dipEnd */
    segments.push({ start: dipS, end: dipE, cls: 'seg-dip' });
    /* nap optimal: dipEnd → forbidden start */
    if (forbS > dipE) {
      segments.push({ start: dipE, end: forbS, cls: 'seg-nap' });
    }
    /* forbidden: forbStart → bed */
    segments.push({ start: forbS, end: bed, cls: 'seg-forbidden' });
    /* night sleep after bed */
    if (bed < 24) {
      segments.push({ start: bed, end: 24, cls: 'seg-bed' });
    }

    /* render bar */
    var barHtml = '';
    segments.forEach(function(seg) {
      var width = ((seg.end - seg.start) / 24 * 100).toFixed(2);
      if (width > 0) {
        barHtml += '<div class="timeline-seg ' + seg.cls + '" style="width:' + width + '%;" title="' + seg.cls.replace('seg-','') + '"></div>';
      }
    });

    /* Add "now" marker */
    var nowPct = (mod24(now) / 24 * 100).toFixed(2);
    timelineBar.innerHTML = barHtml;
    /* overlay now marker */
    timelineBar.style.position = 'relative';
    var marker = document.createElement('div');
    marker.style.cssText = 'position:absolute;top:0;bottom:0;left:' + nowPct + '%;width:2px;background:#7c6aff;border-radius:1px;z-index:2;';
    var markerLabel = document.createElement('div');
    markerLabel.style.cssText = 'position:absolute;top:-18px;left:' + nowPct + '%;transform:translateX(-50%);font-size:0.6rem;font-weight:700;color:#7c6aff;white-space:nowrap;';
    markerLabel.textContent = 'Now';
    timelineBar.appendChild(marker);
    timelineBar.appendChild(markerLabel);

    /* Labels */
    var labelPoints = [
      { h: wake, label: fmt12(wake), tag: 'Wake' },
      { h: dipS,  label: fmt12(dipS),  tag: 'Dip start' },
      { h: forbS, label: fmt12(forbS), tag: 'Zone starts' },
      { h: bed,   label: fmt12(bed),   tag: 'Bedtime' },
    ];

    var labelsHtml = '<div style="display:flex;width:100%;position:relative;height:28px;">';
    labelPoints.forEach(function(pt) {
      var lpct = (mod24(pt.h) / 24 * 100).toFixed(2);
      labelsHtml += '<div class="tl-label" style="position:absolute;left:' + lpct + '%;transform:translateX(-50%);">';
      labelsHtml += '<span class="tl-time">' + pt.label + '</span>';
      labelsHtml += '<span class="tl-tag">' + pt.tag + '</span>';
      labelsHtml += '</div>';
    });
    labelsHtml += '</div>';
    timelineLabels.innerHTML = labelsHtml;
  }

  /* ---- Event listeners ---- */
  wakeInput.addEventListener('input', calculate);
  nowInput.addEventListener('input', calculate);
  bedInput.addEventListener('input', calculate);

  tiredGrid.addEventListener('click', function(e) {
    var btn = e.target.closest('.tired-btn');
    if (!btn) return;
    tiredLevel = parseInt(btn.dataset.level);
    tiredGrid.querySelectorAll('.tired-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    calculate();
  });

  goalBtns.addEventListener('click', function(e) {
    var btn = e.target.closest('.goal-btn');
    if (!btn) return;
    goal = btn.dataset.goal;
    goalBtns.querySelectorAll('.goal-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    calculate();
  });

  /* ---- Init ---- */
  /* Set now-time to current time */
  (function() {
    var d = new Date();
    var hh = d.getHours().toString().padStart(2,'0');
    var mm = d.getMinutes().toString().padStart(2,'0');
    nowInput.value = hh + ':' + mm;
  })();

  calculate();
})();
</script>

<script is:inline>
(function () {

  // =====================
  //   STATE
  // =====================
  var state = {
    quality:     -1,  // 0-3
    latency:     -1,  // 0-3 (time to fall asleep)
    latency2:    -1,  // 0-3 (freq trouble falling asleep within 30 min)
    duration:    -1,  // 0-3
    effComp:     -1,  // 0-3 (computed from time inputs)
    distItems:   { d1: -1, d2: -1, d3: -1, d4: -1, d5: -1, d6: -1 },
    medication:  -1,  // 0-3
    dysfunction1: -1, // 0-3
    dysfunction2: -1, // 0-3
  };

  var currentSection = 1;
  var TOTAL_SECTIONS = 7;

  // =====================
  //   COMPONENT SCORING
  // =====================
  // C1: Subjective quality — direct from quality
  function scoreC1() { return state.quality < 0 ? 0 : state.quality; }

  // C2: Latency — sum of latency + latency2, map to 0-3
  function scoreC2() {
    var s1 = state.latency < 0 ? 0 : state.latency;
    var s2 = state.latency2 < 0 ? 0 : state.latency2;
    var sum = s1 + s2;
    if (sum === 0) return 0;
    if (sum <= 2) return 1;
    if (sum <= 4) return 2;
    return 3;
  }

  // C3: Duration — direct
  function scoreC3() { return state.duration < 0 ? 0 : state.duration; }

  // C4: Efficiency — from effComp
  function scoreC4() { return state.effComp < 0 ? 0 : state.effComp; }

  // C5: Disturbances — sum of 6 items mapped to 0-3
  function scoreC5() {
    var keys = ['d1','d2','d3','d4','d5','d6'];
    var sum = 0;
    for (var i = 0; i < keys.length; i++) {
      var v = state.distItems[keys[i]];
      sum += v < 0 ? 0 : v;
    }
    if (sum === 0) return 0;
    if (sum <= 9) return 1;
    if (sum <= 18) return 2;
    return 3;
  }

  // C6: Medication — direct
  function scoreC6() { return state.medication < 0 ? 0 : state.medication; }

  // C7: Daytime dysfunction — sum mapped to 0-3
  function scoreC7() {
    var s1 = state.dysfunction1 < 0 ? 0 : state.dysfunction1;
    var s2 = state.dysfunction2 < 0 ? 0 : state.dysfunction2;
    var sum = s1 + s2;
    if (sum === 0) return 0;
    if (sum <= 2) return 1;
    if (sum <= 4) return 2;
    return 3;
  }

  function getComponents() {
    return [
      { name: 'Subjective Quality',   score: scoreC1(), key: 'c1' },
      { name: 'Sleep Latency',        score: scoreC2(), key: 'c2' },
      { name: 'Sleep Duration',       score: scoreC3(), key: 'c3' },
      { name: 'Sleep Efficiency',     score: scoreC4(), key: 'c4' },
      { name: 'Sleep Disturbances',   score: scoreC5(), key: 'c5' },
      { name: 'Sleep Medication',     score: scoreC6(), key: 'c6' },
      { name: 'Daytime Dysfunction',  score: scoreC7(), key: 'c7' },
    ];
  }

  function globalScore() {
    var comps = getComponents();
    var total = 0;
    for (var i = 0; i < comps.length; i++) total += comps[i].score;
    return total;
  }

  // =====================
  //   GAUGE (circular SVG arc)
  // =====================
  // Circle r=78, circumference = 2*PI*78 = 490.09
  // We use 270° of the circle (3/4). The arc is rotated 135°.
  // Active portion = 490.09 * 0.75 = 367.57 (for 270° sweep)
  // We drive dashoffset to hide the inactive portion.
  // Total dash = full circumference 490.09, offset for full circle = 490.09 * 0.25 = 122.52 (the 90° gap)
  // For score s on scale 0-21: drawn length = (s/21) * 367.57
  // offset = 490.09 - drawn_length = hides rest
  var CIRC = 2 * Math.PI * 78; // 490.09
  var ARC_SWEEP = CIRC * 0.75; // 367.57 — 270° of ring we use

  function setGaugeArc(score) {
    var arc = document.getElementById('gauge-arc');
    if (!arc) return;
    var frac = Math.min(1, Math.max(0, score / 21));
    var drawn = frac * ARC_SWEEP;
    // dasharray = full circumference; dashoffset hides the unused portion
    var offset = CIRC - drawn;
    arc.setAttribute('stroke-dasharray', CIRC.toFixed(2));
    arc.setAttribute('stroke-dashoffset', offset.toFixed(2));
    var color = score <= 5 ? '#10b981' : score <= 10 ? '#f59e0b' : '#ff6b52';
    arc.setAttribute('stroke', color);
  }

  function getSQData(score) {
    if (score <= 5) {
      return { cls: 'sq-good', label: 'Good Sleep Quality', sub: 'Score 0–5: Your sleep quality appears healthy. Keep it up!', inner: 'Good' };
    } else if (score <= 10) {
      return { cls: 'sq-fair', label: 'Fair Sleep Quality', sub: 'Score 6–10: Some sleep impairment. Targeted changes can improve your score.', inner: 'Fair' };
    } else {
      return { cls: 'sq-poor', label: 'Poor Sleep Quality', sub: 'Score 11–21: Significant sleep impairment. Consider CBT-I or professional evaluation.', inner: 'Poor' };
    }
  }

  // =====================
  //   COMPONENT LIST
  // =====================
  function buildCompList(comps) {
    var html = '';
    for (var i = 0; i < comps.length; i++) {
      var c = comps[i];
      var s = c.score;
      var pct = (s / 3) * 100;
      var scoreLabel = ['0 — Good', '1 — Fair', '2 — Poor', '3 — Poor'][s] || s;
      html += '<div class="comp-item">' +
        '<div class="comp-top">' +
          '<span class="comp-name">' + c.name + '</span>' +
          '<span class="comp-score-badge s' + s + '">' + scoreLabel + '</span>' +
        '</div>' +
        '<div class="comp-bar-track">' +
          '<div class="comp-bar-fill s' + s + '" style="width:' + pct.toFixed(1) + '%"></div>' +
        '</div>' +
      '</div>';
    }
    return html;
  }

  // =====================
  //   RECOMMENDATIONS
  // =====================
  var recTemplates = {
    c1: {
      0: null,
      1: { level: 'good', title: 'Maintain your sleep routine', desc: 'Your subjective sleep quality is fairly good. Keep a consistent bedtime and wake time, even on weekends, to sustain your circadian rhythm.' },
      2: { level: 'fair', title: 'Improve sleep hygiene', desc: 'You rate your sleep as fairly bad. Try dimming lights 90 min before bed, keeping the room cool (65–68°F / 18–20°C), and avoiding screens at least 60 min before sleep.' },
      3: { level: 'poor', title: 'Consider CBT-I for poor sleep quality', desc: 'You rate your sleep as very bad. Cognitive Behavioral Therapy for Insomnia (CBT-I) is the gold-standard first-line treatment — more effective than sleep medications and without side effects. Ask your doctor for a referral.' },
    },
    c2: {
      0: null,
      1: { level: 'good', title: 'Minor latency — try a wind-down routine', desc: 'You occasionally take more than 15 min to fall asleep. A consistent 30-min wind-down ritual (reading, light stretching, warm shower) can reduce sleep onset time significantly.' },
      2: { level: 'fair', title: 'Reduce sleep latency with stimulus control', desc: 'You often struggle to fall asleep. Only use your bed for sleep and sex — avoid reading, watching TV, or working in bed. If you\'re not asleep in 20 min, get up and do something calm until sleepy.' },
      3: { level: 'poor', title: 'High latency — rule out anxiety and insomnia', desc: 'Regularly taking over 30 min to fall asleep is clinically significant. Chronic sleep-onset insomnia often involves hyperarousal and racing thoughts — CBT-I, particularly relaxation techniques and sleep restriction, has the strongest evidence base for this pattern.' },
    },
    c3: {
      0: null,
      1: { level: 'good', title: 'Slightly short duration — aim for 7–9 hours', desc: 'You\'re getting 6–7 hours, slightly below the 7–9 hour recommendation for adults. Even small chronic deficits accumulate — try an earlier bedtime by 30 min and see if you wake more refreshed.' },
      2: { level: 'fair', title: 'Short sleep — address barriers to earlier bedtime', desc: 'Getting 5–6 hours is below the minimum for most adults. Identify what keeps you up: social media, TV, work, or poor sleep drive from irregular schedules. Protect sleep time as a non-negotiable priority.' },
      3: { level: 'poor', title: 'Severely short sleep — significant health risk', desc: 'Less than 5 hours consistently is associated with elevated risks of cardiovascular disease, metabolic syndrome, and impaired immune function. Speak with your doctor to rule out underlying conditions driving short sleep.' },
    },
    c4: {
      0: null,
      1: { level: 'good', title: 'Sleep efficiency borderline — avoid excess time in bed', desc: 'Your efficiency is 75–85%. Spending too much time in bed (lying awake) can worsen insomnia over time. Keep time in bed close to your actual sleep need.' },
      2: { level: 'fair', title: 'Low efficiency — consider sleep restriction', desc: 'Sleep efficiency below 75% means you spend a quarter or more of bed time awake. Sleep restriction therapy — temporarily limiting time in bed to build sleep pressure — is highly effective at improving efficiency quickly.' },
      3: { level: 'poor', title: 'Very low efficiency — key insomnia indicator', desc: 'Below 65% efficiency is a hallmark of chronic insomnia. Sleep restriction and stimulus control through CBT-I are the most evidence-based interventions. Avoid compensatory behaviors like napping or lying in bed hoping sleep will come.' },
    },
    c5: {
      0: null,
      1: { level: 'good', title: 'Minor disturbances — check bedroom environment', desc: 'Occasional sleep disruptions are common. Ensure your bedroom is dark, quiet, and cool. Consider white noise or blackout curtains if environmental factors are waking you.' },
      2: { level: 'fair', title: 'Frequent disturbances — investigate root cause', desc: 'You\'re regularly disrupted during sleep. Common causes include pain, noise, light, nocturia, and undiagnosed conditions like restless legs syndrome or mild sleep apnea. Tracking when you wake and what sensations accompany it can help identify the driver.' },
      3: { level: 'poor', title: 'Severe disturbances — seek medical evaluation', desc: 'Multiple frequent sleep disturbances significantly fragment sleep architecture, reducing restorative deep and REM sleep. Breathing difficulties during sleep especially warrant evaluation for obstructive sleep apnea with your healthcare provider.' },
    },
    c6: {
      0: null,
      1: { level: 'good', title: 'Occasional medication use — monitor dependency', desc: 'Using sleep aids less than weekly is low risk, but regular use can build dependency and reduce natural sleep drive. Discuss with your doctor if you feel you need medication to sleep.' },
      2: { level: 'fair', title: 'Regular medication use — explore alternatives', desc: 'Weekly sleep medication reliance suggests the underlying sleep problem isn\'t being addressed. CBT-I is more effective long-term and without dependency risk. Ask your doctor about a supervised tapering plan alongside behavioral therapy.' },
      3: { level: 'poor', title: 'Nightly medication reliance — address with your doctor', desc: 'Nightly sleep medication use can impair natural sleep regulation, cause tolerance, and worsen sleep quality long-term. Work with your doctor to address the root cause and explore CBT-I as a pathway to medication-free sleep.' },
    },
    c7: {
      0: null,
      1: { level: 'good', title: 'Minor daytime effects — protect your sleep window', desc: 'Mild daytime effects suggest your sleep is mostly adequate but could be more consistent. Protect your sleep window and avoid caffeine after noon to optimize daytime alertness.' },
      2: { level: 'fair', title: 'Daytime impairment — prioritize sleep consistency', desc: 'Struggling to stay awake or maintain motivation during the day reflects meaningful sleep impairment. Consistent sleep and wake times are the most powerful tool for improving daytime function via stronger circadian signaling.' },
      3: { level: 'poor', title: 'Severe daytime dysfunction — safety concern', desc: 'If you\'re having trouble staying awake while driving or in social settings, this is a safety issue as well as a health concern. Do not drive if excessively sleepy. Seek evaluation promptly — severe daytime sleepiness can indicate OSA, narcolepsy, or other treatable conditions.' },
    },
  };

  function buildRecs(comps) {
    // Sort by score descending, show top 3 worst components
    var sorted = comps.slice().sort(function(a, b) { return b.score - a.score; });
    var html = '';
    var shown = 0;

    // Always show at least one general rec
    var globalS = globalScore();
    if (globalS <= 5) {
      html += buildRecCard({ level: 'good', title: 'Your sleep quality looks healthy', desc: 'Your PSQI-style score is in the healthy range. Continue prioritizing consistent sleep and wake times, a dark and cool sleep environment, and limiting alcohol and caffeine in the evening. Re-assess after any major life changes.' });
      shown++;
    }

    for (var i = 0; i < sorted.length && shown < 3; i++) {
      var c = sorted[i];
      var s = c.score;
      if (s === 0) continue;
      var tpl = recTemplates[c.key] && recTemplates[c.key][s];
      if (tpl) {
        html += buildRecCard(tpl);
        shown++;
      }
    }

    if (shown === 0) {
      html += buildRecCard({ level: 'good', title: 'All components look great', desc: 'Your responses suggest excellent sleep across all seven PSQI domains. Keep up your healthy sleep habits!' });
    }

    return html;
  }

  function buildRecCard(tpl) {
    var level = tpl.level || 'fair';
    var iconSvg = {
      good: '<svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
      fair: '<svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>',
      poor: '<svg viewBox="0 0 24 24" fill="none" stroke="#ff6b52" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
    }[level];
    return '<div class="rec-item rec-' + level + '">' +
      '<div class="rec-icon">' + iconSvg + '</div>' +
      '<div><div class="rec-title">' + tpl.title + '</div><div class="rec-desc">' + tpl.desc + '</div></div>' +
    '</div>';
  }

  // =====================
  //   RENDER
  // =====================
  function render() {
    var score = globalScore();
    var comps = getComponents();
    var sq = getSQData(score);

    // Gauge
    var scoreEl = document.getElementById('gauge-score');
    if (scoreEl) scoreEl.textContent = score;
    setGaugeArc(score);

    var innerEl = document.getElementById('gauge-label-inner');
    if (innerEl) innerEl.textContent = sq.inner;

    // Hero class
    var hero = document.getElementById('score-hero');
    if (hero) hero.className = 'score-hero ' + sq.cls;

    var labelEl = document.getElementById('quality-label');
    if (labelEl) labelEl.textContent = sq.label;

    var subEl = document.getElementById('quality-sub');
    if (subEl) subEl.textContent = sq.sub;

    // Component breakdown
    var compList = document.getElementById('comp-list');
    if (compList) compList.innerHTML = buildCompList(comps);

    // Recommendations
    var recsList = document.getElementById('recs-list');
    if (recsList) recsList.innerHTML = buildRecs(comps);
  }

  // =====================
  //   SECTION NAVIGATION
  // =====================
  function showSection(n) {
    for (var i = 1; i <= TOTAL_SECTIONS; i++) {
      var el = document.getElementById('sec-' + i);
      if (el) el.classList.toggle('active', i === n);
    }
    currentSection = n;

    // Progress
    var pct = ((n - 1) / TOTAL_SECTIONS) * 100;
    var fill = document.getElementById('progress-fill');
    if (fill) fill.style.width = pct.toFixed(0) + '%';
    var lbl = document.getElementById('progress-label');
    if (lbl) lbl.textContent = 'Section ' + n + ' of ' + TOTAL_SECTIONS;

    // Nav buttons
    var prev = document.getElementById('btn-prev');
    var next = document.getElementById('btn-next');
    if (prev) prev.disabled = n === 1;
    if (next) {
      if (n === TOTAL_SECTIONS) {
        next.innerHTML = 'Done <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
      } else {
        next.innerHTML = 'Next <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>';
      }
    }

    render();
  }

  document.getElementById('btn-prev') && document.getElementById('btn-prev').addEventListener('click', function() {
    if (currentSection > 1) showSection(currentSection - 1);
  });

  document.getElementById('btn-next') && document.getElementById('btn-next').addEventListener('click', function() {
    if (currentSection < TOTAL_SECTIONS) {
      showSection(currentSection + 1);
    } else {
      // Mark 100% complete
      var fill = document.getElementById('progress-fill');
      if (fill) fill.style.width = '100%';
      var lbl = document.getElementById('progress-label');
      if (lbl) lbl.textContent = 'Complete!';
    }
  });

  // =====================
  //   OPTION BUTTONS
  // =====================
  document.addEventListener('click', function(e) {
    // Standard option buttons
    var optBtn = e.target.closest('.option-btn');
    if (optBtn) {
      var comp = optBtn.getAttribute('data-comp');
      var val = parseInt(optBtn.getAttribute('data-val'), 10);
      if (comp && !isNaN(val)) {
        // Deselect siblings
        var group = optBtn.closest('.option-group');
        if (group) {
          group.querySelectorAll('.option-btn').forEach(function(b) { b.classList.remove('selected'); });
        }
        optBtn.classList.add('selected');
        state[comp] = val;
        render();
      }
    }

    // Disturbance buttons
    var distBtn = e.target.closest('.dist-btn');
    if (distBtn) {
      var distKey = distBtn.getAttribute('data-dist');
      var distVal = parseInt(distBtn.getAttribute('data-val'), 10);
      if (distKey && !isNaN(distVal)) {
        var distGroup = distBtn.closest('.dist-options');
        if (distGroup) {
          distGroup.querySelectorAll('.dist-btn').forEach(function(b) { b.classList.remove('selected'); });
        }
        distBtn.classList.add('selected');
        state.distItems[distKey] = distVal;
        render();
      }
    }
  });

  // =====================
  //   SLEEP EFFICIENCY CALC
  // =====================
  function calcEfficiency() {
    var bh = parseInt(document.getElementById('bedtime-h').value, 10);
    var bm = parseInt(document.getElementById('bedtime-m').value, 10);
    var wh = parseInt(document.getElementById('waketime-h').value, 10);
    var wm = parseInt(document.getElementById('waketime-m').value, 10);

    var effDisplay = document.getElementById('efficiency-display');

    if (isNaN(bh) || isNaN(bm) || isNaN(wh) || isNaN(wm)) {
      effDisplay.textContent = 'Enter both times to calculate efficiency';
      effDisplay.className = 'efficiency-display';
      state.effComp = -1;
      document.getElementById('eff-comp-val').value = -1;
      render();
      return;
    }

    var bedMins = bh * 60 + bm;
    var wakeMins = wh * 60 + wm;
    var timeInBed;
    if (wakeMins > bedMins) {
      timeInBed = wakeMins - bedMins;
    } else {
      // crosses midnight
      timeInBed = (24 * 60 - bedMins) + wakeMins;
    }

    if (timeInBed <= 0 || timeInBed > 14 * 60) {
      effDisplay.textContent = 'Please enter valid bedtime and wake time';
      effDisplay.className = 'efficiency-display';
      state.effComp = 0;
      render();
      return;
    }

    // Sleep efficiency = sleep time / time in bed
    // We don't know actual sleep time precisely from inputs alone,
    // so we use duration component as proxy: map duration score back to hours
    var durationHours = [8, 6.5, 5.5, 4][state.duration < 0 ? 0 : state.duration];
    var eff = (durationHours * 60 / timeInBed) * 100;
    eff = Math.min(100, Math.max(0, eff));

    var compScore, cls, label;
    if (eff >= 85) {
      compScore = 0; cls = 'eff-good'; label = 'Efficiency: ' + eff.toFixed(0) + '% (≥85% — Good)';
    } else if (eff >= 75) {
      compScore = 1; cls = 'eff-good'; label = 'Efficiency: ' + eff.toFixed(0) + '% (75–84% — Acceptable)';
    } else if (eff >= 65) {
      compScore = 2; cls = 'eff-fair'; label = 'Efficiency: ' + eff.toFixed(0) + '% (65–74% — Fair)';
    } else {
      compScore = 3; cls = 'eff-poor'; label = 'Efficiency: ' + eff.toFixed(0) + '% (<65% — Poor)';
    }

    effDisplay.textContent = label;
    effDisplay.className = 'efficiency-display ' + cls;
    state.effComp = compScore;
    document.getElementById('eff-comp-val').value = compScore;
    render();
  }

  ['bedtime-h','bedtime-m','waketime-h','waketime-m'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', calcEfficiency);
      el.addEventListener('change', calcEfficiency);
    }
  });

  // =====================
  //   INIT
  // =====================
  showSection(1);

})();
</script>

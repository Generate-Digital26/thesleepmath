    </div>
  </article>

  <Footer />
</BaseLayout>

<style is:global>
  /* ── Blog post layout ── */
  .blog-post {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  /* ── Breadcrumb ── */
  .breadcrumb {
    padding: 1.25rem 0 0;
    font-size: 0.8rem;
    color: var(--text-soft);
  }

  .breadcrumb a {
    color: var(--text-soft);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .breadcrumb .sep {
    margin: 0 0.35rem;
    opacity: 0.4;
  }

  /* ── Post header ── */
  .post-header {
    padding: 2rem 0 1.5rem;
  }

  .post-meta-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    color: var(--text-soft);
    font-weight: 500;
  }

  .post-tag {
    background: var(--primary-soft);
    color: var(--primary);
    padding: 0.2rem 0.65rem;
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .read-time::before {
    content: '·';
    margin-right: 1rem;
    color: var(--border);
  }

  .post-header h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .post-header h1 .pop {
    color: var(--primary);
  }

  .article-intro {
    font-size: 1.12rem;
    color: var(--text-mid);
    line-height: 1.65;
    font-weight: 400;
  }


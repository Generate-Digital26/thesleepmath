<script is:inline>
  function formatHour(h) {
    var hour = h % 24;
    var suffix = hour >= 12 ? 'pm' : 'am';
    var display = hour % 12 === 0 ? 12 : hour % 12;
    return display + ':00' + suffix;
  }

  function calculateAnchor() {
    var shiftEndRaw = parseInt(document.getElementById('shiftEnd').value, 10);
    var shiftType = document.getElementById('shiftType').value;

    var anchorStart, anchorEnd, caffeineStart, caffeineEnd, lightNote, dayOffNote;

    if (shiftEndRaw <= 12) {
      anchorStart = shiftEndRaw + 2;
      anchorEnd = anchorStart + 4;
      caffeineEnd = anchorStart - 5;
      if (caffeineEnd < 0) caffeineEnd += 24;
      lightNote = 'Wear sunglasses on the commute home. Seek bright light at shift start the following evening.';
      dayOffNote = shiftType === 'fixed'
        ? 'On days off, maintain this anchor window (shift by no more than 1 hour). Avoiding morning light will protect your adaptation.'
        : 'On days off, keep this anchor window. Rotating shift workers can\'t adapt their clock, so consistency is your only stability lever.';
    } else {
      anchorStart = shiftEndRaw + 1;
      if (anchorStart >= 24) anchorStart -= 24;
      anchorEnd = anchorStart + 4;
      if (anchorEnd >= 24) anchorEnd -= 24;
      caffeineEnd = shiftEndRaw - 3;
      if (caffeineEnd < 0) caffeineEnd += 24;
      lightNote = 'Your shift ends before sunrise — morning darkness helps. Still use blackout curtains and an eye mask for your sleep window.';
      dayOffNote = 'Maintain this anchor on days off for maximum consistency.';
    }

    var badge = formatHour(anchorStart) + ' – ' + formatHour(anchorEnd);

    var details = '<p class="result-detail-block"><strong>Anchor window:</strong> ' + badge + ' &#8212; protect this block every day, including days off.</p>' +
      '<p class="result-detail-block"><strong>Caffeine cutoff:</strong> No caffeine after ' + formatHour(caffeineEnd) + ' to protect this sleep window (5-hour clearance).</p>' +
      '<p class="result-detail-block"><strong>Light note:</strong> ' + lightNote + '</p>';

    var nudge = '<p class="calc-nudge">' + dayOffNote + ' For a full schedule including meal windows and light exposure timing, use the <a href="/shift-work-calculator" style="color:#92400e;font-weight:600;">Shift Work Planner</a>.</p>';

    document.getElementById('anchorBadge').textContent = 'Anchor: ' + badge;
    document.getElementById('anchorDetails').innerHTML = details;
    document.getElementById('anchorNudge').innerHTML = nudge;

    var resultEl = document.getElementById('anchorCalcResult');
    resultEl.classList.add('visible');
    resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
</script>

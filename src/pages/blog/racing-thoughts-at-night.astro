<script is:inline>
  function calculateArousal() {
    var arousal = document.getElementById('arousalType').value;
    var timing = document.getElementById('timingType').value;
    var duration = document.getElementById('durationType').value;

    var typeLabel = '';
    var mechanism = '';
    var protocol = '';
    var nudge = '';

    if (arousal === 'cognitive' && timing === 'onset') {
      typeLabel = 'Cognitive Onset Arousal';
      mechanism = '<p class="result-detail-block"><strong>What\'s happening:</strong> Your default mode network is staying active when it should be disengaging. Racing thoughts at sleep onset are the clearest expression of the pre-sleep cognitive hyperarousal pattern identified in insomnia research — the brain hasn\'t received a reliable cue that it\'s safe to stop processing.</p>';
      protocol = '<p class="result-detail-block"><strong>First-line protocol:</strong> Scheduled worry time (15–20 min, 2+ hours before bed) + cognitive restructuring to reduce sleep-catastrophizing + stimulus control (leave the bed if not asleep in ~20 min). This combination directly targets DMN overactivation and conditioned arousal.</p>';
    } else if (arousal === 'cognitive' && timing === 'maintenance') {
      typeLabel = 'Cognitive Maintenance Arousal';
      mechanism = '<p class="result-detail-block"><strong>What\'s happening:</strong> You\'re likely experiencing the pre-dawn cortisol rise triggering wakefulness in a hyperaroused HPA axis — then cognitive arousal takes over and keeps you awake. The cortisol spike is normal in timing; the sensitivity to it is not.</p>';
      protocol = '<p class="result-detail-block"><strong>First-line protocol:</strong> Stimulus control for nighttime wakings (leave bed after 20 min awake, return when sleepy) + passive cognitive defusion — observing thoughts without engaging them. Sleep restriction therapy to increase sleep pressure and reduce the number of wakings over time.</p>';
    } else if (arousal === 'somatic' && timing === 'onset') {
      typeLabel = 'Somatic Onset Arousal';
      mechanism = '<p class="result-detail-block"><strong>What\'s happening:</strong> The physical symptoms — racing heart, tension, being wired — are your sympathetic nervous system running in activation mode at bedtime. This is the somatic arm of the hyperarousal model, often present without prominent racing thoughts.</p>';
      protocol = '<p class="result-detail-block"><strong>First-line protocol:</strong> Progressive muscle relaxation (PMR) or 4-7-8 breathing (inhale 4, hold 7, exhale 8) to activate the parasympathetic system. Consider a warm bath 60–90 min before bed to accelerate peripheral vasodilation. Body-first approaches outperform cognitive techniques when somatic arousal dominates.</p>';
    } else if (arousal === 'somatic' && timing === 'maintenance') {
      typeLabel = 'Somatic Maintenance Arousal';
      mechanism = '<p class="result-detail-block"><strong>What\'s happening:</strong> Physical activation during nighttime wakings suggests ongoing sympathetic nervous system activity during sleep. This may include elevated nocturnal cortisol maintaining a baseline of bodily arousal that is easily tipped into wakefulness.</p>';
      protocol = '<p class="result-detail-block"><strong>First-line protocol:</strong> Body scan during wakings (systematic attention to each body part without trying to change anything), diaphragmatic breathing to lower heart rate, and a cooler bedroom environment (65–68°F) to reduce thermal arousal. Track waking patterns with a sleep latency log.</p>';
    } else if (arousal === 'mixed') {
      typeLabel = 'Mixed Cognitive + Somatic Arousal';
      mechanism = '<p class="result-detail-block"><strong>What\'s happening:</strong> You have both arms of the hyperarousal response active — the mental and physical components amplifying each other. This is the most common presentation of chronic insomnia and typically requires a combined intervention approach.</p>';
      protocol = '<p class="result-detail-block"><strong>First-line protocol:</strong> Start with the physical (PMR or breathing) to lower the somatic floor, then address cognitive arousal with scheduled worry time and cognitive restructuring. Stimulus control is essential for both. This is the full CBT-I stack — consider working with a CBT-I therapist if self-guided hasn\'t moved the needle.</p>';
    } else {
      typeLabel = 'Mixed Presentation';
      mechanism = '<p class="result-detail-block"><strong>What\'s happening:</strong> Your pattern suggests elements of both cognitive and somatic arousal across different sleep phases. This variability is common in stress-reactive insomnia where the dominant symptom shifts depending on what\'s happening in your life.</p>';
      protocol = '<p class="result-detail-block"><strong>First-line protocol:</strong> A sleep diary for 1–2 weeks will clarify whether onset or maintenance is the primary issue. In the meantime: stimulus control (bed only for sleep) applies universally, and scheduled worry time reduces the cognitive load arriving at bedtime regardless of when it activates.</p>';
    }

    if (duration === 'acute') {
      nudge = '<p class="calc-nudge">⚠️ Acute insomnia (under 3 months) is common after a specific stressor and often resolves when the stressor passes. The most important thing at this stage is not to develop conditioned arousal — avoid staying in bed awake for long periods, which is how short-term insomnia becomes chronic.</p>';
    } else if (duration === 'chronic') {
      nudge = '<p class="calc-nudge">⚠️ At 3+ months, the original stressor is often no longer the primary driver — the conditioned arousal and cortisol feedback loop have become self-sustaining. This is where the CBT-I techniques are most important and where professional support (a trained CBT-I therapist or a structured program) produces the best outcomes.</p>';
    }

    document.getElementById('resultType').textContent = typeLabel;
    document.getElementById('resultMechanism').innerHTML = mechanism;
    document.getElementById('resultProtocol').innerHTML = protocol;
    document.getElementById('resultNudge').innerHTML = nudge;

    var resultEl = document.getElementById('arousalCalcResult');
    resultEl.classList.add('visible');
    resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
</script>

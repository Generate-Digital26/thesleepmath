const title = 'Caffeine Half-Life: What Drake et al. Actually Found — The Sleep Math';
const description = 'The Drake et al. 2013 study proved caffeine 6 hours before bed still costs you an hour of sleep — and you won\'t even notice. Here\'s the full breakdown.';
const canonical = 'https://thesleepmath.com/blog/caffeine-half-life-what-drake-et-al-actually-found';

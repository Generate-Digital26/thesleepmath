<script is:inline>
  function calculateSleepTemp() {
    var age = document.getElementById('ageGroup').value;
    var pref = document.getElementById('tempPref').value;
    var current = document.getElementById('currentTemp').value;

    var minF, maxF, minC, maxC;

    if (age === 'older') {
      minF = 68; maxF = 75; minC = 20; maxC = 24;
    } else if (pref === 'hot') {
      minF = 63; maxF = 66; minC = 17; maxC = 19;
    } else if (pref === 'cold') {
      minF = 67; maxF = 70; minC = 19; maxC = 21;
    } else {
      minF = 65; maxF = 68; minC = 18; maxC = 20;
    }

    var rangeText = minF + '–' + maxF + '°F (' + minC + '–' + maxC + '°C)';
    document.getElementById('resultTemp').textContent = 'Target: ' + rangeText;

    var summary = '';
    if (age === 'older') {
      summary = '<p class="result-detail-block"><strong>Why slightly warmer:</strong> Thermoregulatory capacity declines with age. Older adults produce less metabolic heat and have reduced peripheral vasodilation responsiveness, shifting the optimal window 3–4°F warmer than younger adults.</p>';
    } else if (pref === 'hot') {
      summary = '<p class="result-detail-block"><strong>For hot sleepers:</strong> You likely generate more metabolic heat during sleep or have naturally higher nocturnal skin temperature. The lower end of the range gives your body more thermal gradient to work with.</p>';
    } else if (pref === 'cold') {
      summary = '<p class="result-detail-block"><strong>For cold sleepers:</strong> You may have slower peripheral vasodilation, which delays the distal skin warming that signals sleep onset. A slightly warmer room prevents the compensatory vasoconstriction that makes this worse.</p>';
    } else {
      summary = '<p class="result-detail-block"><strong>The standard range:</strong> 65–68°F is the evidence-backed consensus for healthy adults with typical thermoregulation. This range supports core temperature decline without triggering cold-defense responses.</p>';
    }

    var action = '';
    if (current === 'hot' || current === 'warm') {
      action = '<p class="calc-nudge">⚠️ Your current room is above the recommended range. Each degree above 68°F measurably reduces sleep efficiency. Pre-cool your room 20–30 minutes before bed and consider a fan at minimum.</p>';
    } else if (current === 'too_cold') {
      action = '<p class="calc-nudge">⚠️ Below 62°F risks triggering vasoconstriction — the cold-defense response that can delay sleep onset. Add a light layer and raise the thermostat slightly toward your target range.</p>';
    } else if (current === 'ideal' || current === 'cool') {
      action = '<p class="result-detail-block"><strong>You’re close:</strong> Fine-tune within your target range and note whether sleep onset feels faster or slower at the cooler vs warmer end. Individual variation within the recommended window is real.</p>';
    }

    document.getElementById('resultSummary').innerHTML = summary;
    document.getElementById('resultAction').innerHTML = action;

    var resultEl = document.getElementById('tempCalcResult');
    resultEl.classList.add('visible');
    resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
</script>

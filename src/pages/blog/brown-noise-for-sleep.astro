<script is:inline>
  function calculateNoiseVolume() {
    var ambient = parseInt(document.getElementById('ambientNoise').value, 10);
    var sensitivity = document.getElementById('sleepSensitivity').value;
    var goal = document.getElementById('sleepGoal').value;

    var offset = sensitivity === 'light' ? 16 : sensitivity === 'average' ? 11 : 6;
    var targetMin = ambient + offset - 3;
    var targetMax = ambient + offset + 3;

    var MAX_SAFE = 50;
    var warning = '';

    if (ambient >= 50) {
      targetMin = 50;
      targetMax = 55;
      warning = '<p class="calc-warning">&#9888;&#65039; At 50+ dB ambient, brown noise alone may not mask the problem effectively. Consider combining with quality earplugs or addressing the noise source directly. Keep brown noise at the lower end of this range.</p>';
    } else {
      if (targetMax > MAX_SAFE + 5) {
        targetMax = MAX_SAFE + 5;
      }
      if (targetMin > MAX_SAFE) {
        targetMin = MAX_SAFE;
      }
    }

    var placement = '';
    if (targetMax <= 40) {
      placement = 'Place your speaker <strong>1&#8211;1.5 m</strong> from your bed. A small Bluetooth speaker at low volume will reach this range without difficulty.';
    } else if (targetMax <= 50) {
      placement = 'Place your speaker <strong>1.5&#8211;2 m</strong> from the head of your bed. Every doubling of distance reduces perceived volume by ~6 dB &#8212; distance is your primary safety control.';
    } else {
      placement = 'Keep your speaker at <strong>least 2 m</strong> from your pillow and verify volume at pillow level with a free dB meter app (NIOSH SLM or DecibelX). Speaker distance, not volume dial position, is your reliable control.';
    }

    var goalNote = '';
    if (goal === 'onset') {
      goalNote = 'For faster sleep onset, you can start at the <strong>higher end</strong> of this range while you are still awake. If your device supports a timer, reduce to the lower end after 30&#8211;45 minutes to minimise total overnight exposure.';
    } else if (goal === 'maintenance') {
      goalNote = 'For all-night maintenance, stay at the <strong>lower end</strong> of this range to minimise cumulative overnight exposure while keeping masking effective through early-morning light-sleep stages.';
    } else {
      goalNote = 'For both onset and maintenance, set volume at the <strong>mid-point</strong> of this range and keep it consistent through the night. Consistency matters more than fine-tuning the exact dB.';
    }

    document.getElementById('resultVolume').textContent = 'Target: ' + targetMin + '–' + targetMax + ' dB';

    document.getElementById('resultDetails').innerHTML =
      '<p class="result-detail-block"><strong>Placement:</strong> ' + placement + '</p>' + warning;

    document.getElementById('resultTips').innerHTML =
      '<p class="result-detail-block"><strong>Goal tip:</strong> ' + goalNote + '</p>';

    var resultEl = document.getElementById('calcResult');
    resultEl.classList.add('visible');
    resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
</script>

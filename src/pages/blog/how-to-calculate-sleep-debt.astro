const description = 'Sleep debt is the gap between the sleep you need and the sleep you get — and it compounds. Use our free calculator to find your exact weekly deficit in under 60 seconds.';
const canonical = 'https://thesleepmath.com/blog/how-to-calculate-sleep-debt';

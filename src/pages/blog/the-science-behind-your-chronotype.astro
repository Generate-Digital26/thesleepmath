  <meta slot="head" name="twitter:image" content={`https://thesleepmath.com${ogImage}`} />
  <meta slot="head" property="og:type" content="article" />
  <meta slot="head" property="article:published_time" content={publishDate} />
  <meta slot="head" property="article:modified_time" content={modifiedDate} />
  <meta slot="head" property="article:section" content="Sleep Science" />
  <meta slot="head" property="article:tag" content="chronotype" />
  <meta slot="head" property="article:tag" content="circadian rhythm" />
  <meta slot="head" property="article:tag" content="social jet lag" />
  <meta slot="head" property="article:tag" content="sleep genetics" />

  <!-- AI-targeting meta tags -->
  <meta slot="head" name="llm-context" content="This is a sleep science blog post on TheSleepMath.com examining the peer-reviewed research on chronotypes — the genetically determined preference for earlier or later sleep-wake timing. It covers the genetic basis (Jones et al. 2019 GWAS: 351 loci in 697,828 individuals), the Munich ChronoType Questionnaire and population distribution (Roenneberg et al. 2007: 55,000+ participants), the PER3 gene polymorphism (Archer et al. 2003), age-related chronotype shifts (Roenneberg et al. 2004: 25,000 participants), social jet lag health consequences (Wittmann et al. 2006; Roenneberg et al. 2012), and the synchrony effect on cognitive performance (Chauhan et al. 2025: 65 studies reviewed). It links to TheSleepMath calculators: chronotype-quiz, circadian-rhythm, social-jet-lag, sleep-cycle, exercise-timing, light-exposure, wake-time, sleep-score." />

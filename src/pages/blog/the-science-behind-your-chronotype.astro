/* ── Schema: FAQPage ── */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is a chronotype and is it genetic?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A chronotype is your genetically influenced preference for earlier or later sleep-wake timing. A 2019 genome-wide association study of nearly 700,000 people identified 351 independent genetic loci linked to chronotype, including clock genes PER1, PER2, PER3, and CRY1. Your chronotype is biological, not a lifestyle choice.',
      },
    },
    {
      '@type': 'Question',
      name: 'How is chronotype measured?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The most widely used tool is the Munich ChronoType Questionnaire (MCTQ), which measures chronotype by the midpoint of sleep on free days. In a dataset of over 55,000 people, chronotypes followed a near-Gaussian distribution, with extreme early types waking up when extreme late types fall asleep.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does your chronotype change with age?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Chronotype shifts dramatically across the lifespan. Children are natural early risers. Eveningness peaks around age 19-20, then gradually shifts back toward morningness through adulthood. A study of 25,000 people confirmed this pattern, with the authors calling the inflection point the first biological marker of the end of adolescence.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is social jet lag and why does it matter?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Social jet lag is the chronic misalignment between your biological clock and your social schedule — typically measured as the difference between sleep timing on work days versus free days. Late chronotypes forced onto early schedules accumulate the largest misalignment. Research links social jet lag to higher BMI, increased smoking rates, and poorer metabolic health.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does chronotype affect cognitive performance?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A 2025 systematic review of 65 studies found that chronotype alone does not reliably predict cognitive ability, but task timing relative to chronotype does. Roughly 45% of studies in younger adults and 83% of studies in older adults demonstrated a synchrony effect — superior performance when tasks align with biological peak time, particularly for attention, inhibition, and memory.',
      },
    },
  ],

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import ToolsGrid from '@/components/ToolsGrid.astro';

const title = 'The Science Behind Your Chronotype — The Sleep Math';
const description = 'Your chronotype is coded into 351 genetic loci and shifts across your lifetime. Here is what the peer-reviewed research says about morning larks, night owls, and everyone in between.';
const canonical = 'https://thesleepmath.com/blog/the-science-behind-your-chronotype';
const heroImage = '/images/blog/the-science-behind-your-chronotype-hero.jpg';
const ogImage = '/images/blog/the-science-behind-your-chronotype-og.png';
const publishDate = '2026-05-21';
const modifiedDate = '2026-05-21';

/* ── Schema: BlogPosting ── */
const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: 'The Science Behind Your Chronotype',
  description,
  image: `https://thesleepmath.com${ogImage}`,
  datePublished: publishDate,
  dateModified: modifiedDate,
  wordCount: 1950,
  author: {
    '@type': 'Organization',
    name: 'The Sleep Math',
    url: 'https://thesleepmath.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'The Sleep Math',
    url: 'https://thesleepmath.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://thesleepmath.com/favicon.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.article-intro', '.tldr', '.bottom-line'],
  },
  citation: [
    {
      '@type': 'ScholarlyArticle',
      name: 'Genome-wide association analyses of chronotype in 697,828 individuals provides insights into circadian rhythms',
      author: 'Jones SE, Lane JM, Wood AR, et al.',
      datePublished: '2019',
      url: 'https://pubmed.ncbi.nlm.nih.gov/30696823/',
    },
    {
      '@type': 'ScholarlyArticle',
      name: 'Epidemiology of the human circadian clock',
      author: 'Roenneberg T, Kuehnle T, Juda M, Kantermann T, Allebrandt K, Gordijn M, Merrow M',
      datePublished: '2007',
      url: 'https://pubmed.ncbi.nlm.nih.gov/17936039/',

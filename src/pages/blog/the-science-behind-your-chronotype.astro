      datePublished: '2004',
      url: 'https://pubmed.ncbi.nlm.nih.gov/15620633/',
    },
    {
      '@type': 'ScholarlyArticle',
      name: 'Chronotype and synchrony effects in human cognitive performance: A systematic review',

        '<ellipse cx="58" cy="79" rx="24" ry="10" fill="#7c6aff" opacity="0.2"/>' +
        /* Large belly — third trimester */
        '<ellipse cx="185" cy="126" rx="38" ry="28" fill="#fcd3a0" opacity="0.8"/>' +
        /* Baby inside */
        '<ellipse cx="185" cy="126" rx="18" ry="16" fill="#f59e0b" opacity="0.28"/>' +
        '<circle cx="185" cy="118" r="8" fill="#f59e0b" opacity="0.2"/>' +
        /* U-body pillow / belly support */
        '<path d="M148 148 Q185 158 222 148" stroke="#a5b4fc" stroke-width="10" fill="none" stroke-linecap="round" opacity="0.75"/>' +
        /* Back wedge pillow (behind back to prevent rolling supine) */
        '<polygon points="228,108 282,108 282,138 228,138" fill="#fde68a" opacity="0.75" rx="4"/>' +
        '<text x="255" y="126" text-anchor="middle" font-size="8" fill="#78350f" font-family="Sora,sans-serif" font-weight="700">Back</text>' +
        '<text x="255" y="136" text-anchor="middle" font-size="8" fill="#78350f" font-family="Sora,sans-serif" font-weight="700">wedge</text>' +
        /* Arm */
        '<path d="M96 96 Q134 87 166 100" stroke="#fde8d0" stroke-width="13" fill="none" stroke-linecap="round"/>' +
        /* Legs */
        '<path d="M218 126 Q238 134 258 132" stroke="#fde8d0" stroke-width="17" fill="none" stroke-linecap="round"/>' +
        '<path d="M218 140 Q238 150 260 148" stroke="#fde8d0" stroke-width="15" fill="none" stroke-linecap="round"/>' +
        /* Knee pillow */
        '<ellipse cx="242" cy="144" rx="22" ry="9" fill="#c7c0ff" opacity="0.7"/>' +
        /* Left indicator with urgency */
        '<path d="M14 114 L26 107 L26 111 L34 111 L34 117 L26 117 L26 121 Z" fill="#10b981" opacity="0.85"/>' +
        '<text x="38" y="117" font-size="8" fill="#065f46" font-family="Sora,sans-serif" font-weight="700">LEFT</text>' +
        /* Labels */
        '<text x="58" y="68" text-anchor="middle" font-size="9" fill="#7c778e" font-family="Sora,sans-serif">Head pillow</text>' +
        '<line x1="58" y1="71" x2="58" y2="83" stroke="#d0cce0" stroke-width="1"/>' +
        '<text x="185" y="164" text-anchor="middle" font-size="9" fill="#7c778e" font-family="Sora,sans-serif">Body pillow</text>' +
        '<text x="242" y="158" text-anchor="middle" font-size="9" fill="#7c778e" font-family="Sora,sans-serif">Knee pillow</text>' +
        '</svg>';
    }

    return '';
  }

  function getPositionLegend(type) {
    var items = [];
    if (type === 'first') {
      items = [
        { color: '#c7c0ff', text: 'Head pillow' },
        { color: '#c7c0ff', text: 'Knee pillow' },
        { color: '#fde8d0', text: 'Body' },
      ];
    } else if (type === 'left') {
      items = [
        { color: '#c7c0ff', text: 'Head pillow' },
        { color: '#a5b4fc', text: 'Belly pillow' },
        { color: '#c7c0ff', text: 'Knee pillow' },
        { color: '#f59e0b', text: 'Baby' },
      ];
    } else if (type === 'left-critical') {
      items = [
        { color: '#c7c0ff', text: 'Head pillow' },
        { color: '#a5b4fc', text: 'Body pillow' },
        { color: '#fde68a', text: 'Back wedge' },
        { color: '#c7c0ff', text: 'Knee pillow' },
      ];
    }
    return items.map(function(i) {
      return '<div class="leg-row"><div class="leg-dot" style="background:' + i.color + ';"></div><span>' + i.text + '</span></div>';
    }).join('');
  }

  /* =============================================
     DOM REFS
     ============================================= */
  var trimesterSelect   = document.getElementById('trimester-select');
  var weeksSlider       = document.getElementById('weeks-slider');
  var weeksDisplay      = document.getElementById('weeks-display');
  var safetyAlert       = document.getElementById('safety-alert');

  var sleepNeededVal    = document.getElementById('sleep-needed-val');
  var bestPositionVal   = document.getElementById('best-position-val');
  var bestPositionSub   = document.getElementById('best-position-sub');
  var pillowCountVal    = document.getElementById('pillow-count-val');
  var trimesterPhaseVal = document.getElementById('trimester-phase-val');
  var trimesterPhaseSub = document.getElementById('trimester-phase-sub');

  var positionCardTitle = document.getElementById('position-card-title');
  var positionCardSub   = document.getElementById('position-card-sub');
  var positionDiagram   = document.getElementById('position-diagram');
  var positionLegend    = document.getElementById('position-legend');

  var pillowList        = document.getElementById('pillow-list');

  var symptomTipsCard   = document.getElementById('symptom-tips-card');
  var symptomTipsList   = document.getElementById('symptom-tips-list');

  var tipsTitle         = document.getElementById('tips-title');
  var tipsList          = document.getElementById('tips-list');

  /* Symptom checkboxes */
  var SYM_IDS = ['backpain', 'heartburn', 'legcramps', 'urination', 'breath', 'rls'];

  /* =============================================
     SYNC TRIMESTER <-> WEEKS SLIDER
     ============================================= */
  function weeksToTrimester(w) {
    if (w <= 13) return '1';
    if (w <= 27) return '2';
    return '3';
  }

  function trimesterDefaultWeek(t) {
    if (t === '1') return 8;
    if (t === '2') return 20;
    return 34;
  }

  /* When slider moves, auto-update trimester select */
  weeksSlider.addEventListener('input', function () {
    var w = parseInt(this.value, 10);
    weeksDisplay.textContent = w;
    var t = weeksToTrimester(w);
    if (trimesterSelect.value !== t) {
      trimesterSelect.value = t;
    }
    calculate();
  });

  /* When trimester select changes, jump slider to midpoint */
  trimesterSelect.addEventListener('change', function () {
    var t = this.value;
    var w = trimesterDefaultWeek(t);
    weeksSlider.value = w;
    weeksDisplay.textContent = w;
    calculate();
  });

  /* Symptom checkboxes */
  SYM_IDS.forEach(function (id) {
    var el = document.getElementById('sym-' + id);
    if (el) el.addEventListener('change', calculate);
  });

  /* =============================================
     MAIN CALCULATE
     ============================================= */
  function calculate() {
    var t     = trimesterSelect.value;
    var weeks = parseInt(weeksSlider.value, 10);
    var d     = TRIMESTER_DATA[t];

    /* Safety alert after week 28 */
    if (weeks >= 28) {
      safetyAlert.style.display = 'flex';
    } else {
      safetyAlert.style.display = 'none';
    }

    /* Summary cards */
    sleepNeededVal.textContent    = d.sleepNeeded;
    bestPositionVal.textContent   = d.bestPosition;
    bestPositionSub.textContent   = d.bestPositionSub;
    pillowCountVal.textContent    = d.pillowCount;

    var ordinals = { '1': '1st', '2': '2nd', '3': '3rd' };
    trimesterPhaseVal.textContent = ordinals[t];
    trimesterPhaseSub.textContent = 'Week ' + weeks;

    /* Position diagram */
    positionCardTitle.textContent = d.positionTitle;
    positionCardSub.textContent   = d.positionSub;
    positionDiagram.innerHTML     = getPositionSVG(d.positionType);
    positionLegend.innerHTML      = getPositionLegend(d.positionType);

    /* Pillow guide */
    var pillHtml = '';
    d.pillowGuide.forEach(function (tip) {
      pillHtml += '<li>' + tip + '</li>';
    });
    pillowList.innerHTML = pillHtml;

    /* Trimester tips */
    tipsTitle.textContent = 'Sleep tips for the ' + ordinals[t] + ' trimester';
    var tipHtml = '';
    d.tips.forEach(function (tip) {
      tipHtml += '<li>' + tip + '</li>';
    });
    tipsList.innerHTML = tipHtml;

    /* Symptom tips */
    var activeSymptoms = SYM_IDS.filter(function (id) {
      var el = document.getElementById('sym-' + id);
      return el && el.checked;
    });

    if (activeSymptoms.length > 0) {
      symptomTipsCard.style.display = 'block';
      var symHtml = '';
      activeSymptoms.forEach(function (id) {
        var s = SYMPTOM_TIPS[id];
        if (s) {
          symHtml += '<div class="symptom-tip-group">';
          symHtml += '<div class="symptom-tip-label">' + s.label + '</div>';
          symHtml += '<div class="symptom-tip-text">' + s.text + '</div>';
          symHtml += '</div>';
        }
      });
      symptomTipsList.innerHTML = symHtml;
    } else {
      symptomTipsCard.style.display = 'none';
    }
  }

  /* =============================================
     INIT
     ============================================= */
  calculate();

})();
</script>

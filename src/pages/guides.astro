---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

const upcomingGuides = [];
---

<BaseLayout
  title="Sleep Science Guides — The Sleep Math"
  description="In-depth, evidence-based guides on sleep science, sleep hygiene, circadian rhythms, and the habits that actually move the needle. Long-form references from The Sleep Math."
>

  <Nav />

  <main class="guides-main">
    <div class="guides-inner">

      <!-- Header -->
      <header class="guides-header">
        <div class="icon-wrap">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="40"
            height="40"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <!-- Open book -->
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
          </svg>
        </div>
        <h1>Sleep Guides</h1>
        <p class="subtitle">
          Long-form, evidence-based references for building the sleep habits that actually move the needle.
        </p>
      </header>

      <!-- Published guides -->
      <section class="guides-grid" aria-label="Published guides">
        <a href="/guides/light-screens-and-sleep" class="guide-card">
          <div class="guide-card-img">
            <img
              src="/images/guides/light-screens-and-sleep-hero.jpg"
              alt="A bedroom at dusk with warm-toned lighting, a dimmed phone on the nightstand, and morning sunlight visible through a window"
              loading="lazy"
            />
          </div>
          <div class="guide-card-body">
            <div class="guide-card-meta">
              <span class="guide-tag">Definitive Guide</span>
              <span class="guide-date">17 min read</span>
            </div>
            <h2 class="guide-card-title">Light, Screens &amp; Sleep: The Science</h2>
            <p class="guide-card-excerpt">
              The definitive, evidence-based reference for how light and screens affect your sleep — the melanopsin pathway, what blue light actually does to melatonin, whether blue light glasses work, and the single most overlooked fix.
            </p>
            <span class="guide-card-cta">
              Read guide
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </div>
        </a>

        <a href="/guides/sleep-for-new-parents" class="guide-card">
          <div class="guide-card-img">
            <img
              src="/images/guides/sleep-for-new-parents-hero.jpg"
              alt="A soft nursery scene at dawn with a wooden crib and sheer curtains glowing with early morning light"
              loading="lazy"
            />
          </div>
          <div class="guide-card-body">
            <div class="guide-card-meta">
              <span class="guide-tag">Definitive Guide</span>
              <span class="guide-date">17 min read</span>
            </div>
            <h2 class="guide-card-title">Sleep for New Parents</h2>
            <p class="guide-card-excerpt">
              The definitive, evidence-based reference for surviving the sleep deprivation of early parenthood — what actigraphy data says about fragmentation, why your partner's sleep matters too, and the strategies backed by real research.
            </p>
            <span class="guide-card-cta">
              Read guide
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </div>
        </a>

        <a href="/guides/caffeine-and-sleep" class="guide-card">
          <div class="guide-card-img">
            <img
              src="/images/guides/caffeine-and-sleep-hero.jpg"
              alt="A ceramic pour-over coffee dripper and white mug on linen cloth beside an unmade bed, early morning light"
              loading="lazy"
            />
          </div>
          <div class="guide-card-body">
            <div class="guide-card-meta">
              <span class="guide-tag">Definitive Guide</span>
              <span class="guide-date">16 min read</span>
            </div>
            <h2 class="guide-card-title">Caffeine & Sleep: What Science Says</h2>
            <p class="guide-card-excerpt">
              The definitive, evidence-based reference for how caffeine actually affects your sleep — the adenosine mechanism, the half-life math, the genetics behind individual variation, and the timing cutoffs backed by peer-reviewed research.
            </p>
            <span class="guide-card-cta">
              Read guide
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </div>
        </a>

        <a href="/guides/sleep-and-exercise" class="guide-card">
          <div class="guide-card-img">
            <img
              src="/images/guides/sleep-and-exercise-hero.jpg"
              alt="A pair of running shoes beside a bed with white linen, warm morning light through sheer curtains"
              loading="lazy"
            />
          </div>
          <div class="guide-card-body">
            <div class="guide-card-meta">
              <span class="guide-tag">Definitive Guide</span>
              <span class="guide-date">16 min read</span>
            </div>
            <h2 class="guide-card-title">Sleep & Exercise: The Research</h2>
            <p class="guide-card-excerpt">
              The definitive, evidence-based reference for how exercise actually affects your sleep — what the meta-analyses say about timing, intensity, and modality, and the minimum dose that moves the needle.
            </p>
            <span class="guide-card-cta">
              Read guide
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </div>
        </a>

        <a href="/guides/understanding-your-circadian-rhythm" class="guide-card">
          <div class="guide-card-img">
            <img
              src="/images/guides/understanding-your-circadian-rhythm-hero.jpg"
              alt="A brass orrery resting on cream linen at dawn, soft violet-pink light catching the curved arms"
              loading="lazy"
            />
          </div>
          <div class="guide-card-body">
            <div class="guide-card-meta">
              <span class="guide-tag">Definitive Guide</span>
              <span class="guide-date">18 min read</span>
            </div>
            <h2 class="guide-card-title">Understanding Your Circadian Rhythm</h2>
            <p class="guide-card-excerpt">
              The definitive, evidence-based reference for how the body's master clock actually works — the neurons that keep time, the light that resets them, and the levers you can pull to bring your rhythm back into sync.
            </p>
            <span class="guide-card-cta">
              Read guide
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </div>
        </a>

        <a href="/guides/the-complete-guide-to-sleep-hygiene" class="guide-card">
          <div class="guide-card-img">
            <img
              src="/images/guides/the-complete-guide-to-sleep-hygiene-hero.jpg"
              alt="A calm bedside scene with a book, glass of water, and a single warm lamp"
              loading="lazy"
            />
          </div>
          <div class="guide-card-body">
            <div class="guide-card-meta">
              <span class="guide-tag">Definitive Guide</span>
              <span class="guide-date">17 min read</span>
            </div>
            <h2 class="guide-card-title">The Complete Guide to Sleep Hygiene</h2>
            <p class="guide-card-excerpt">
              The definitive, evidence-based reference for building the sleep habits that actually move the needle — what works, what is myth, and when sleep hygiene alone is not enough.
            </p>
            <span class="guide-card-cta">
              Read guide
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </section>

      <!-- Upcoming guides -->
      {upcomingGuides.length > 0 && (
        <section class="topics-section" aria-label="Upcoming guides">
          <span class="topics-label">Coming next</span>
          <div class="chips">
            {upcomingGuides.map((guide) => (
              <span class="chip">{guide}</span>
            ))}
          </div>
        </section>
      )}

      <!-- Newsletter CTA -->
      <div class="cta-box">
        <p class="cta-heading">Get notified when new guides launch</p>
        <form class="cta-form" data-kit-form>
          <input type="email" placeholder="you@email.com" required aria-label="Email address" />
          <button type="submit">Subscribe</button>
        </form>
        <p class="kit-note" data-kit-note aria-live="polite"></p>
      </div>

      <!-- Back link -->
      <a href="/#calcs" class="back-link">
        Browse calculators →
      </a>

    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .guides-main {
    min-height: calc(100vh - 140px);
    padding: 5rem 1.5rem;
  }

  .guides-inner {
    max-width: 880px;
    margin: 0 auto;
  }

  /* Header */
  .guides-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .icon-wrap {
    width: 72px;
    height: 72px;
    border-radius: 20px;
    background: var(--primary-soft);
    color: var(--primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .guides-header h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.4rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 0.65rem;
    line-height: 1.15;
  }

  .subtitle {
    font-size: 1.05rem;
    color: var(--text-mid);
    line-height: 1.6;
    max-width: 580px;
    margin: 0 auto;
  }

  /* Published guides grid */
  .guides-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .guide-card {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 1.5rem;
    background: var(--card);
    border: 1.5px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.2s, transform 0.15s;
  }

  .guide-card:hover {
    border-color: var(--primary);
    box-shadow: 0 6px 24px rgba(124, 106, 255, 0.12);
    transform: translateY(-2px);
  }

  .guide-card-img {
    overflow: hidden;
    background: var(--bg-tint);
  }

  .guide-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 9;
    transition: transform 0.4s;
  }

  .guide-card:hover .guide-card-img img {
    transform: scale(1.03);
  }

  .guide-card-body {
    padding: 1.5rem 1.5rem 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .guide-card-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.78rem;
    color: var(--text-soft);
    font-weight: 500;
  }

  .guide-tag {
    background: var(--primary-soft);
    color: var(--primary);
    padding: 0.2rem 0.65rem;
    border-radius: 100px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .guide-date::before {
    content: '◆';
    margin-right: 1rem;
    color: var(--border);
  }

  .guide-card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0.15rem 0 0.35rem;
  }

  .guide-card-excerpt {
    font-size: 0.92rem;
    color: var(--text-mid);
    line-height: 1.55;
    margin: 0 0 0.5rem;
  }

  .guide-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary);
    margin-top: auto;
  }

  /* Upcoming topics */
  .topics-section {
    margin-bottom: 3rem;
  }

  .topics-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-soft);
    margin-bottom: 0.85rem;
    text-align: center;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .chip {
    padding: 0.5rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-mid);
    background: var(--card);
    border: 1.5px solid var(--border);
    border-radius: 100px;
    transition: all 0.15s;
    cursor: default;
  }

  .chip:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--primary-soft);
  }

  /* Newsletter CTA */
  .cta-box {
    max-width: 560px;
    margin: 0 auto 2rem;
    background: var(--bg-tint);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem 1.5rem;
    text-align: center;
  }

  .cta-heading {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .cta-form {
    display: flex;
    gap: 0.5rem;
  }

  .cta-form input {
    flex: 1;
    padding: 0.7rem 1rem;
    background: var(--card);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
  }

  .cta-form input:focus {
    border-color: var(--primary);
  }

  .cta-form input::placeholder {
    color: var(--text-soft);
  }

  .cta-form button {
    padding: 0.7rem 1.25rem;
    background: var(--primary);
    color: #fff;
    font-weight: 700;
    font-size: 0.88rem;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
    transition: background 0.15s;
  }

  .cta-form button:hover {
    background: var(--primary-hover);
  }

  .cta-form button:disabled { opacity: 0.6; cursor: wait; }

  .kit-note {
    margin-top: 0.65rem;
    font-size: 0.82rem;
    min-height: 1.2em;
  }
  .kit-note:empty { display: none; }

  /* Back link */
  .back-link {
    display: block;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--primary-hover);
  }

  /* Responsive */
  @media (max-width: 720px) {
    .guides-main {
      padding: 3.5rem 1.25rem;
    }

    .guides-header h1 {
      font-size: 1.9rem;
    }

    .guide-card {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .guide-card-img img {
      aspect-ratio: 16 / 9;
    }

    .guide-card-body {
      padding: 1.25rem;
    }

    .cta-form {
      flex-direction: column;
    }
  }
</style>
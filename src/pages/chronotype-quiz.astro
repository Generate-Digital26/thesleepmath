    if (currentQ < questions.length - 1) {
      currentQ++;
      renderQuestion();
    } else {
      showResults();
    }
  }

  btnNext.addEventListener('click', function () {
    if (answers[currentQ] === null) return;
    advance();
  });

  btnBack.addEventListener('click', function () {
    if (currentQ > 0) {
      currentQ--;
      renderQuestion();
    }
  });

  /* =========================================
     CALCULATE & SHOW RESULTS
  ========================================= */
  function calcScores() {
    scores = { lion: 0, bear: 0, wolf: 0, dolphin: 0 };
    answers.forEach(function (ans, qi) {
      if (ans !== null) {
        var type = questions[qi].answers[ans].type;
        scores[type]++;
      }
    });
  }

  function getWinner() {
    var max = -1;
    var winner = 'bear';
    TYPES.forEach(function (t) {
      if (scores[t] > max) { max = scores[t]; winner = t; }
    });
    // tiebreak: question 15 (index 14) overrides if tied
    var q15ans = answers[14];
    if (q15ans !== null) {
      var q15type = questions[14].answers[q15ans].type;
      if (scores[q15type] === max && q15type !== winner) {
        winner = q15type;
      }
    }
    return winner;
  }

  function showResults() {
    calcScores();
    var winner = getWinner();
    var ct = chronotypes[winner];

    // progress to 100%
    progressFill.style.width = '100%';

    // populate results card — SVG icon in tinted circle
    var emojiEl = document.getElementById('result-emoji');
    emojiEl.style.background = ct.iconBg;
    emojiEl.innerHTML = ct.icon;

    var badge = document.getElementById('result-badge');
    badge.textContent = ct.badge;
    badge.style.background = ct.badgeBg;
    badge.style.color = ct.badgeColor;

    document.getElementById('result-name').textContent = ct.name;
    document.getElementById('result-desc').textContent = ct.desc;

    // score chips
    var scoreRow = document.getElementById('score-row');
    scoreRow.innerHTML = '';
    var labels = { lion: 'Lion', bear: 'Bear', wolf: 'Wolf', dolphin: 'Dolphin' };
    TYPES.forEach(function (t) {
      var chip = document.createElement('div');
      chip.className = 'score-chip' + (t === winner ? ' winner' : '');
      chip.textContent = labels[t] + '  ' + scores[t];
      scoreRow.appendChild(chip);
    });

    // schedule
    var tbody = document.getElementById('schedule-body');
    tbody.innerHTML = '';
    ct.schedule.forEach(function (row) {
      var tr = document.createElement('tr');
      tr.innerHTML = '<td><span class="time-tag">' + row.time + '</span><br>' + row.slot + '</td><td>' + row.rec + '</td>';
      tbody.appendChild(tr);
    });

    // tips
    var tipsBlock = document.getElementById('tips-block');
    tipsBlock.innerHTML = '<h4>Personalized tips for ' + ct.name + 's</h4>' +
      ct.tips.map(function (tip) {
        return '<div class="tip-item"><div class="tip-dot"></div><span>' + tip + '</span></div>';
      }).join('');

    // swap cards
    quizCard.style.display = 'none';
    resultsCard.style.display = 'block';
  }

  /* =========================================
     EMAIL CAPTURE
  ========================================= */
  var emailForm = document.getElementById('email-form');
  var emailInput = document.getElementById('email-input');
  var emailSubscribe = document.getElementById('email-subscribe');
  var emailSuccess = document.getElementById('email-success');
  var emailCapture = document.getElementById('email-capture');

  emailForm.addEventListener('submit', function (e) {
    e.preventDefault();
    var email = emailInput.value.trim();
    if (!email) return;

    var subscribe = emailSubscribe.checked;
    var winner = getWinner();
    var ct = chronotypes[winner];

    // Store submission data (integrate with your email service later)
    var payload = {
      email: email,
      chronotype: winner,
      chronotypeName: ct.name,
      scores: Object.assign({}, scores),
      subscribe: subscribe,
      timestamp: new Date().toISOString()
    };

    // Subscribe to Kit newsletter if checkbox is checked
    if (subscribe && typeof window.__KIT_FORM_ID !== 'undefined') {
      fetch('https://api.convertkit.com/v3/forms/' + window.__KIT_FORM_ID + '/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          api_key: window.__KIT_API_KEY,
          email: email,
          fields: { chronotype: winner },
        }),
      }).catch(function () { /* silent — UX already shows success */ });
      if (typeof gtag === 'function') gtag('event', 'newsletter_subscribe', { method: 'kit', source: 'chronotype_quiz' });
    }

    console.log('Email capture:', JSON.stringify(payload));

    // Show success state
    emailForm.style.display = 'none';
    document.querySelector('.email-checkbox').style.display = 'none';
    document.querySelector('.email-sub').style.display = 'none';
    emailSuccess.style.display = 'flex';
    emailCapture.querySelector('h4').textContent = 'Results sent!';
  });

  /* =========================================
     RETAKE
  ========================================= */
  btnRetake.addEventListener('click', function () {
    currentQ = 0;
    answers = new Array(questions.length).fill(null);
    scores = { lion: 0, bear: 0, wolf: 0, dolphin: 0 };
    progressFill.style.width = '0%';
    resultsCard.style.display = 'none';
    quizCard.style.display = 'block';
    // reset email capture
    emailForm.style.display = 'flex';
    document.querySelector('.email-checkbox').style.display = 'flex';
    document.querySelector('.email-sub').style.display = 'block';
    emailSuccess.style.display = 'none';
    emailCapture.querySelector('h4').textContent = 'Get your results & schedule by email';
    emailInput.value = '';
    renderQuestion();
    // scroll back to quiz
    quizCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  /* =========================================
     INIT
  ========================================= */
  renderQuestion();

})();
</script>

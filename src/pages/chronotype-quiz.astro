  ========================================= */
  function renderQuestion() {
    var q = questions[currentQ];
    qCounter.textContent = (currentQ + 1) + ' / ' + questions.length;
    qCategory.textContent = q.category;
    questionText.textContent = q.text;

    answersGrid.innerHTML = '';
    q.answers.forEach(function (ans, i) {
      var btn = document.createElement('button');
      btn.className = 'answer-btn' + (answers[currentQ] === i ? ' selected' : '');
      btn.innerHTML = '<span class="ans-letter">' + LETTERS[i] + '</span>' + ans.text;
      btn.addEventListener('click', function () {
        selectAnswer(i);
      });
      answersGrid.appendChild(btn);
    });

    // progress
    progressFill.style.width = (currentQ / questions.length * 100) + '%';

    // nav state
    btnBack.disabled = currentQ === 0;
    btnNext.disabled = answers[currentQ] === null;
    btnNext.textContent = currentQ === questions.length - 1 ? 'See results' : 'Next';

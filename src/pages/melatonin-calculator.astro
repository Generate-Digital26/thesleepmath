    color: var(--text-mid); transition: all 0.15s;
  }
  .dir-btn svg { width: 14px; height: 14px; }
  .dir-btn:hover { border-color: var(--sky); background: #f0f9ff; }
  .dir-btn.active { border-color: var(--sky); background: #eaf6ff; color: var(--sky); }

  /* ===== RESULTS PANEL ===== */
  .results-panel { display: flex; flex-direction: column; gap: 1rem; }

  /* Dose hero */
  .dose-hero {
    background: var(--card); border: 2px solid var(--border);
    border-radius: var(--radius); padding: 1.5rem;
    border-color: var(--mint);
  }
  .dose-hero-top {
    display: flex; align-items: center; gap: 1.25rem; margin-bottom: 1.25rem;
  }
  .dose-badge {
    display: flex; align-items: baseline; gap: 0.2rem;
    background: #ecfdf5; border-radius: 10px;
    padding: 0.75rem 1rem; flex-shrink: 0;
    border: 2px solid var(--mint);
  }
  .dose-num {
    font-size: 2.5rem; font-weight: 900; color: var(--mint);
    letter-spacing: -0.04em; line-height: 1;
    font-family: 'Space Grotesk', monospace;
  }
  .dose-unit {
    font-size: 1rem; font-weight: 700; color: var(--mint);
    align-self: flex-end; margin-bottom: 0.15rem;
  }
  .dose-label {
    font-size: 1rem; font-weight: 800; color: var(--text);
    letter-spacing: -0.02em; margin-bottom: 0.3rem;
  }
  .dose-sub { font-size: 0.82rem; color: var(--text-mid); line-height: 1.5; }

  /* Dosage scale */
  .dose-scale-wrap { }
  .dose-scale-label {
    font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--text-soft); margin-bottom: 0.5rem;
  }
  .dose-scale { }
  .dose-scale-track {
    height: 14px; border-radius: 7px; overflow: hidden;
    display: flex; margin-bottom: 0;
  }
  .dose-range-physio { width: 4%;  background: #10b981; }
  .dose-range-low    { width: 5%;  background: #6ee7b7; }
  .dose-range-mid    { width: 20%; background: #fde68a; }
  .dose-range-high   { width: 71%; background: #fca5a5; }

  .dose-marker-wrap { position: relative; height: 28px; }
  .dose-marker {
    position: absolute; display: flex; flex-direction: column;
    align-items: center; transform: translateX(-50%);
    transition: left 0.4s cubic-bezier(0.34,1.56,0.64,1);
  }
  .dm-pin {
    width: 2px; height: 14px; background: var(--text);
    border-radius: 1px;
  }
  .dm-label {
    font-size: 0.65rem; font-weight: 700; color: var(--text);
    white-space: nowrap; margin-top: 2px;
    background: var(--card); padding: 1px 4px; border-radius: 4px;

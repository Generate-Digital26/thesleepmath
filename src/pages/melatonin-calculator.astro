  }
  .dose-scale-ticks {
    display: flex; justify-content: space-between;
    font-size: 0.62rem; color: var(--text-soft); font-weight: 600;
    padding: 0.25rem 0 0;
  }
  .dose-scale-legend {
    display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.5rem;
  }
  .dose-scale-legend span { display: flex; align-items: center; gap: 0.3rem; font-size: 0.68rem; color: var(--text-soft); }
  .dl-dot { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }
  .dl-physio { background: #10b981; }
  .dl-low    { background: #6ee7b7; }
  .dl-mid    { background: #fde68a; }
  .dl-high   { background: #fca5a5; }

  /* Timing card */
  .timing-card {
    background: var(--card); border: 1.5px solid var(--border);
    border-radius: var(--radius); padding: 1.25rem;
  }
  .timing-card h3 {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.88rem; font-weight: 700; margin-bottom: 1rem;
  }
  .timing-card h3 svg { width: 16px; height: 16px; color: var(--primary); }
  .timing-grid {
    display: flex; align-items: center; gap: 1rem; margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }
  .timing-block { text-align: center; min-width: 100px; }
  .tb-label {
    font-size: 0.68rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--text-soft); margin-bottom: 0.25rem;
  }
  .tb-time {
    font-size: 1.6rem; font-weight: 800; letter-spacing: -0.03em;
    color: var(--mint); line-height: 1; font-family: 'Space Grotesk', monospace;
    margin-bottom: 0.25rem;
  }
  .tb-time.tb-bed { color: var(--primary); }
  .tb-note { font-size: 0.68rem; color: var(--text-soft); }
  .timing-arrow {
    flex: 1; display: flex; justify-content: center;
    color: var(--text-soft); flex-shrink: 0;
  }
  .timing-arrow svg { width: 20px; height: 20px; }
  .timing-insight {
    display: flex; align-items: flex-start; gap: 0.5rem;
    background: var(--primary-soft); border-radius: 8px;
    padding: 0.65rem 0.85rem; font-size: 0.78rem; color: var(--text-mid);
    line-height: 1.55;
  }
  .timing-insight svg { width: 14px; height: 14px; flex-shrink: 0; color: var(--primary); margin-top: 1px; }

  /* Warnings */
  .warnings-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .warn-card {
    background: var(--card); border: 1.5px solid var(--border);
    border-radius: var(--radius); padding: 1rem;
  }
  .warn-card.warn-interaction { border-color: #f59e0b; background: #fffbeb; }
  .warn-card.warn-avoid { border-color: #ff6b52; background: #fff5f3; }
  .warn-header {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.78rem; font-weight: 700; margin-bottom: 0.65rem;
  }
  .warn-card.warn-interaction .warn-header { color: #92400e; }
  .warn-card.warn-avoid .warn-header { color: #9a1e0b; }
  .warn-header svg { width: 15px; height: 15px; }
  .warn-card.warn-interaction .warn-header svg { stroke: #f59e0b; }
  .warn-card.warn-avoid .warn-header svg { stroke: #ff6b52; }
  .warn-list {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 0.3rem;
  }
  .warn-list li {
    font-size: 0.72rem; color: var(--text-mid); line-height: 1.4;
    padding-left: 0.9rem; position: relative;
  }
  .warn-card.warn-interaction .warn-list li::before { content: '!'; position: absolute; left: 0; color: #f59e0b; font-weight: 800; font-size: 0.65rem; }
  .warn-card.warn-avoid .warn-list li::before { content: '×'; position: absolute; left: 0; color: #ff6b52; font-weight: 800; font-size: 0.7rem; }

  /* Medical disclaimer */
  .disclaimer-card {
    display: flex; align-items: flex-start; gap: 0.85rem;
    background: var(--card); border: 2px solid var(--primary);
    border-radius: var(--radius); padding: 1rem 1.25rem;
  }
  .disclaimer-icon {
    width: 36px; height: 36px; border-radius: 8px;
    background: var(--primary-soft); display: flex; align-items: center;
    justify-content: center; flex-shrink: 0;
  }
  .disclaimer-icon svg { width: 18px; height: 18px; stroke: var(--primary); }
  .disclaimer-text { font-size: 0.78rem; color: var(--text-mid); line-height: 1.6; }
  .disclaimer-text strong { display: block; color: var(--text); font-size: 0.82rem; font-weight: 700; margin-bottom: 0.25rem; }

  /* ===== SCIENCE ===== */
  .science-section { max-width: 920px; margin: 0 auto; padding: 0 2rem 3rem; }
  .science-card {
    background: var(--card); border: 1.5px solid var(--border);
    border-radius: var(--radius); padding: 2rem;
  }
  .science-card h2 { font-size: 1.25rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.75rem; }
  .science-card p { font-size: 0.88rem; color: var(--text-mid); line-height: 1.65; margin-bottom: 0.85rem; }
  .formula-box {
    background: #1e1b2e; color: #edeaff; border-radius: 10px;
    padding: 1rem 1.25rem; font-family: 'Space Grotesk', monospace;
    font-size: 0.88rem; margin: 1rem 0; text-align: center;
  }
  .formula-box .formula-main { font-size: 1rem; font-weight: 700; margin-bottom: 0.25rem; }
  .formula-box .formula-desc { font-size: 0.72rem; color: #a8a3be; }
  .mel-table { width: 100%; border-collapse: collapse; margin-top: 1rem; font-size: 0.82rem; }
  .mel-table th {
    text-align: left; font-weight: 700; font-size: 0.72rem;
    text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--text-soft); padding: 0.5rem 0.75rem;
    border-bottom: 1.5px solid var(--border);
  }
  .mel-table td { padding: 0.55rem 0.75rem; color: var(--text-mid); border-bottom: 1px solid var(--border); }
  .mel-table tr:last-child td { border-bottom: none; }
  .mel-table .dose-col { font-weight: 700; color: var(--mint); font-family: 'Space Grotesk', monospace; font-size: 0.82rem; }
  .citation {
    font-size: 0.78rem; color: var(--text-soft); line-height: 1.5;
    padding-left: 0.85rem; border-left: 2px solid var(--border); margin-top: 1rem;
  }
  .citation em { color: var(--text-mid); }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .calc-header { padding: 1rem 1.25rem 0; }
    .calc-layout { grid-template-columns: 1fr; padding: 1.25rem; }
    .input-panel { position: static; }
    .warnings-grid { grid-template-columns: 1fr; }
    .science-section { padding: 0 1.25rem 2rem; }
    .dose-hero-top { flex-wrap: wrap; }
    .timing-grid { justify-content: center; }
  }
  @media (max-width: 480px) {
    .age-btns { grid-template-columns: repeat(2, 1fr); }
    .dose-scale-ticks { font-size: 0.55rem; }
  }
</style>

<script is:inline>
(function () {
  /* ---- DOM refs ---- */
  var ageBtns       = document.getElementById('age-btns');
  var purposeBtns   = document.getElementById('purpose-btns');
  var dirBtns       = document.getElementById('dir-btns');
  var jetlagField   = document.getElementById('jetlag-field');
  var bedtimeInput  = document.getElementById('bedtime-input');
  var currentInput  = document.getElementById('current-time-input');

  var doseNum       = document.getElementById('dose-num');
  var doseLabel     = document.getElementById('dose-label');
  var doseSub       = document.getElementById('dose-sub');
  var doseMarker    = document.getElementById('dose-marker');
  var dmLabel       = document.getElementById('dm-label');

  var timingTakeTime   = document.getElementById('timing-take-time');
  var timingBedTime    = document.getElementById('timing-bed-time');
  var timingTakeNote   = document.getElementById('timing-take-note');
  var timingInsightTxt = document.getElementById('timing-insight-text');

  /* ---- State ---- */
  var ageGroup  = 'adult';
  var purpose   = 'sleep';
  var direction = 'east';

  /* ---- Dose tables ---- */
  var DOSE = {
    child:  { start: 0.5, min: 0.5, max: 1.0,  label: 'Recommended starting dose (child)',   sub: 'Maximum 1 mg for children 4–12. Pediatric supervision advised.' },
    teen:   { start: 0.5, min: 0.5, max: 3.0,  label: 'Recommended starting dose (teen)',    sub: 'Begin low. Can increase to 1–3 mg if 0.5 mg has no effect after 2 weeks.' },
    adult:  { start: 0.5, min: 0.5, max: 5.0,  label: 'Recommended starting dose',           sub: 'Physiological dose — matches natural brain production. Rarely need more.' },
    older:  { start: 0.5, min: 0.5, max: 2.0,  label: 'Recommended starting dose (65+)',     sub: 'Start 0.5 mg. Older adults are more sensitive to melatonin effects.' },
  };

  /* Scale positions (% left) for log-ish dose scale 0.1–10mg */
  /* Scale buckets: physio 0–4%, low 4–9%, mid 9–29%, high 29–100% */
  function doseToScalePct(mg) {
    /* Approximate log scale 0.1mg to 10mg mapped to 0–100% */
    var logMin = Math.log10(0.1);
    var logMax = Math.log10(10);
    var pct = (Math.log10(Math.max(0.1, mg)) - logMin) / (logMax - logMin) * 100;
    return Math.min(98, Math.max(1, pct));
  }

  /* ---- Time helpers ---- */
  function parseTime(val) {
    var parts = val.split(':').map(Number);
    return parts[0] + parts[1] / 60;
  }
  function mod24(h) { return ((h % 24) + 24) % 24; }
  function fmt12(h) {
    h = mod24(h);
    var period = h >= 12 ? 'PM' : 'AM';
    var hh = Math.floor(h) % 12; if (hh === 0) hh = 12;
    var mm = Math.round((h - Math.floor(h)) * 60);
    return hh + ':' + (mm < 10 ? '0' : '') + mm + ' ' + period;
  }

  /* ---- Core calculate ---- */
  function calculate() {
    var bed     = parseTime(bedtimeInput.value);
    var current = parseTime(currentInput.value);

    /* --- Dose --- */
    var d = DOSE[ageGroup];

    /* Purpose-specific dose adjustments */
    var startDose = d.start;
    var doseLabelText = d.label;
    var doseSubText   = d.sub;

    if (purpose === 'jetlag') {
      /* Jet lag: slightly higher, 0.5–3mg per AASM */
      startDose     = (ageGroup === 'child') ? 0.5 : 1.0;
      doseLabelText = 'Recommended dose for jet lag';
      if (direction === 'east') {
        doseSubText = 'Take at destination bedtime. Eastward travel is harder — melatonin accelerates circadian advance.';
      } else {
        doseSubText = 'Westward travel is easier. Consider morning light exposure at destination instead of, or alongside, melatonin.';
      }
    } else if (purpose === 'shift') {
      startDose     = d.start;
      doseLabelText = 'Recommended dose for shift work';
      doseSubText   = 'Take immediately before your daytime sleep window. Keep the bedroom dark and cool.';
    } else if (purpose === 'reset') {
      startDose     = (ageGroup === 'child') ? 0.5 : 0.5;
      doseLabelText = 'Recommended dose for circadian reset';
      doseSubText   = 'Low physiological dose timed 5–7 hours before desired sleep onset. More effective than pre-bed dosing for phase shifts.';
    }

    doseNum.textContent   = startDose % 1 === 0 ? startDose.toFixed(0) : startDose.toFixed(1);
    doseLabel.textContent = doseLabelText;
    doseSub.textContent   = doseSubText;

    /* Marker position on scale */
    var pct = doseToScalePct(startDose);
    doseMarker.style.left = pct + '%';
    dmLabel.textContent   = 'Start here (' + (startDose % 1 === 0 ? startDose.toFixed(0) : startDose.toFixed(1)) + ' mg)';

    /* --- Timing --- */
    var takeTime, takeNote, insightText;

    if (purpose === 'sleep') {
      /* 30–60 min before bed */
      takeTime   = mod24(bed - 0.75); /* 45 min avg */
      takeNote   = '30–60 min before bed';
      insightText = 'Melatonin rises naturally at DLMO, about 2 hours before your habitual bedtime. Supplementing 30–60 minutes before bed amplifies the darkness signal without suppressing your own production.';
    } else if (purpose === 'jetlag') {
      if (direction === 'east') {
        takeTime   = bed;
        takeNote   = 'At destination bedtime';
        insightText = 'For eastward travel, take melatonin at the destination bedtime for 2–5 nights. This advances your clock to match the new time zone. Avoid taking it during your home-time daytime hours.';
      } else {
        takeTime   = mod24(bed - 1);
        takeNote   = 'Shortly before destination bedtime';
        insightText = 'For westward travel, your clock delays naturally. Morning bright light at the destination is the most powerful tool. Low-dose melatonin in the early evening at the destination can supplement this.';
      }
    } else if (purpose === 'shift') {
      /* Take immediately before daytime sleep */
      takeTime   = mod24(bed - 0.5);
      takeNote   = '30 min before daytime sleep';
      insightText = 'Shift workers should take melatonin immediately before their daytime sleep window. Combine with blackout curtains and earplugs to protect against light and noise disruption.';
    } else {
      /* Circadian reset: 5–7h before desired sleep onset */
      takeTime   = mod24(bed - 6);
      takeNote   = '5–7 hours before target bedtime';
      insightText = 'For circadian phase resetting, timing early exploits the phase response curve advance zone. This approach is more effective than pre-bed dosing for moving your clock earlier.';
    }

    timingTakeTime.textContent  = fmt12(takeTime);
    timingBedTime.textContent   = fmt12(bed);
    timingTakeNote.textContent  = takeNote;
    timingInsightTxt.textContent = insightText;

    /* Highlight if take-time has already passed today */
    var hoursSinceIdeal = current - takeTime;
    if (hoursSinceIdeal < 0) hoursSinceIdeal += 24;
    if (hoursSinceIdeal > 0 && hoursSinceIdeal < 12) {
      timingTakeTime.style.color = 'var(--amber)';
    } else {
      timingTakeTime.style.color = 'var(--mint)';
    }
  }

  /* ---- Event listeners ---- */
  ageBtns.addEventListener('click', function (e) {
    var btn = e.target.closest('.age-btn');
    if (!btn) return;
    ageGroup = btn.dataset.age;
    ageBtns.querySelectorAll('.age-btn').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
    calculate();
  });

  purposeBtns.addEventListener('click', function (e) {
    var btn = e.target.closest('.purpose-btn');
    if (!btn) return;
    purpose = btn.dataset.purpose;
    purposeBtns.querySelectorAll('.purpose-btn').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
    jetlagField.style.display = (purpose === 'jetlag') ? 'block' : 'none';
    calculate();
  });

  dirBtns.addEventListener('click', function (e) {
    var btn = e.target.closest('.dir-btn');
    if (!btn) return;
    direction = btn.dataset.dir;
    dirBtns.querySelectorAll('.dir-btn').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
    calculate();
  });

  bedtimeInput.addEventListener('input', calculate);
  currentInput.addEventListener('input', calculate);

  /* ---- Init ---- */
  (function () {
    var d = new Date();
    var hh = d.getHours().toString().padStart(2, '0');
    var mm = d.getMinutes().toString().padStart(2, '0');
    currentInput.value = hh + ':' + mm;
  })();

  calculate();
})();
</script>

  }
  .reco-card h3 { font-size: 0.88rem; font-weight: 700; margin-bottom: 0.85rem; }
  .reco-item {
    display: flex; gap: 0.75rem; align-items: flex-start;
    padding: 0.85rem; border-radius: var(--radius-sm);
    border: 1.5px solid; margin-bottom: 0.55rem;
  }
  .reco-item:last-child { margin-bottom: 0; }
  .reco-item.reco-low { border-color: #a7f3d0; background: #f0fdf8; }
  .reco-item.reco-mid { border-color: #fde68a; background: #fffbeb; }
  .reco-item.reco-high { border-color: #ffd0c8; background: #fff6f4; }
  .reco-icon {
    width: 36px; height: 36px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .reco-icon svg { width: 18px; height: 18px; }
  .reco-low .reco-icon { background: #dcfce7; }
  .reco-mid .reco-icon { background: #fef9c3; }
  .reco-high .reco-icon { background: #ffe4de; }
  .reco-title { font-size: 0.82rem; font-weight: 700; margin-bottom: 0.2rem; }
  .reco-low .reco-title { color: #065f46; }
  .reco-mid .reco-title { color: #78350f; }
  .reco-high .reco-title { color: #9a1c10; }
  .reco-desc { font-size: 0.77rem; color: var(--text-mid); line-height: 1.55; }

  /* Reference table */
  .ref-card {
    background: var(--card); border: 1.5px solid var(--border);
    border-radius: var(--radius); padding: 1.25rem;
  }
  .ref-card h3 { font-size: 0.88rem; font-weight: 700; margin-bottom: 0.85rem; }
  .ref-table {
    width: 100%; border-collapse: collapse; font-size: 0.78rem;
  }
  .ref-table th {
    text-align: left; padding: 0.5rem 0.6rem;
    font-weight: 700; color: var(--text-soft);
    font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em;
    border-bottom: 1.5px solid var(--border);
  }
  .ref-table td {
    padding: 0.6rem; color: var(--text-mid);
    border-bottom: 1px solid var(--border); line-height: 1.45;
  }
  .ref-table tr:last-child td { border-bottom: none; }
  .ref-score, .ref-level {
    display: inline-block; padding: 0.15rem 0.5rem;
    border-radius: 5px; font-weight: 700; font-size: 0.75rem;
  }
  .ref-low { background: #dcfce7; color: #065f46; }
  .ref-mid { background: #fef3c7; color: #78350f; }
  .ref-high { background: #ffe4de; color: #9a1c10; }

  /* ===== SCIENCE ===== */
  .science-section { max-width: 960px; margin: 0 auto; padding: 0 2rem 2.5rem; }
  .science-card {
    background: var(--bg); border: 1.5px solid var(--border);
    border-radius: var(--radius); padding: 2rem;
  }
  .science-card h2 { font-size: 1.25rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.85rem; }
  .science-card p { font-size: 0.88rem; color: var(--text-mid); line-height: 1.65; margin-bottom: 0.85rem; }
  .formula-box {
    background: #1e1b2e; color: #edeaff; border-radius: var(--radius-sm);
    padding: 1.1rem 1.25rem; font-family: 'Space Grotesk', monospace;
    font-size: 0.92rem; margin: 1.1rem 0; text-align: center;
  }
  .formula-box .formula-main { font-size: 1.05rem; font-weight: 700; margin-bottom: 0.3rem; }
  .formula-box .formula-desc { font-size: 0.73rem; color: #a8a3be; }
  .citation {
    font-size: 0.78rem; color: var(--text-soft); line-height: 1.55;

</style>

<script is:inline>
(function() {
  /* ============================
     STATE
     ============================ */
  var state = {
    snore: -1,
    tired: -1,
    observed: -1,
    pressure: -1,
    bmi: -1,
    bmiValue: null,
    age: -1,
    ageValue: null,
    neck: -1,
    neckValue: null,
    gender: -1
  };

  var currentSection = 1;
  var bmiUnit = 'imperial';
  var neckUnit = 'cm';

  var factorMeta = [
    { key: 'snore',    letter: 'S', label: 'Snoring loudly' },
    { key: 'tired',    letter: 'T', label: 'Tired / daytime fatigue' },
    { key: 'observed', letter: 'O', label: 'Observed breathing pauses' },
    { key: 'pressure', letter: 'P', label: 'High blood pressure' },
    { key: 'bmi',      letter: 'B', label: 'BMI > 35' },
    { key: 'age',      letter: 'A', label: 'Age > 50' },
    { key: 'neck',     letter: 'N', label: 'Neck > 40 cm (16 in)' },
    { key: 'gender',   letter: 'G', label: 'Male sex' }
  ];

  /* ============================
     SECTION NAVIGATION
     ============================ */
  function showSection(n) {
    currentSection = n;
    var s1 = document.getElementById('section-1');
    var s2 = document.getElementById('section-2');
    if (n === 1) {
      s1.classList.add('active');
      s2.classList.remove('active');
    } else {
      s1.classList.remove('active');
      s2.classList.add('active');
    }
    updateProgress();
    // Scroll input panel to top
    var panel = document.querySelector('.input-panel');
    if (panel) panel.scrollTop = 0;
  }

  function updateProgress() {
    var fill = document.getElementById('progress-fill');
    var label = document.getElementById('progress-label');
    if (currentSection === 1) {
      fill.style.width = '50%';
      label.textContent = 'Section 1 of 2';
    } else {
      fill.style.width = '100%';
      label.textContent = 'Section 2 of 2';
    }
  }

  var btnNext1 = document.getElementById('btn-next-1');
  var btnPrev2 = document.getElementById('btn-prev-2');
  var btnFinish = document.getElementById('btn-finish');

  if (btnNext1) btnNext1.addEventListener('click', function() { showSection(2); });
  if (btnPrev2) btnPrev2.addEventListener('click', function() { showSection(1); });
  if (btnFinish) btnFinish.addEventListener('click', function() {
    render();
    var hero = document.getElementById('score-hero');
    if (hero) hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  /* ============================
     SCORE RING
     ============================ */
  var RING_CIRCUMFERENCE = 2 * Math.PI * 85; // ~534.07

  function setRing(score) {
    var ring = document.getElementById('score-ring-fill');
    if (!ring) return;
    var frac = score / 8;
    var offset = RING_CIRCUMFERENCE * (1 - frac);
    ring.setAttribute('stroke-dashoffset', offset.toFixed(2));
    var color = score <= 2 ? 'var(--mint)' : score <= 4 ? 'var(--amber)' : 'var(--coral)';
    ring.setAttribute('stroke', color);
  }

  /* ============================
     OPTION BUTTONS (event delegation)
     ============================ */
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.option-btn');
    if (!btn) return;
    var comp = btn.getAttribute('data-comp');
    var val = parseInt(btn.getAttribute('data-val'), 10);
    if (!comp || isNaN(val)) return;

    // Toggle selection in the row
    var row = btn.closest('.btn-row');
    if (row) {
      var btns = row.querySelectorAll('.option-btn');
      for (var i = 0; i < btns.length; i++) btns[i].classList.remove('selected');
    }
    btn.classList.add('selected');

    // Update state
    state[comp] = val;

    // Style the question card
    var qCard = btn.closest('.q-card');
    if (qCard) {
      qCard.classList.remove('answered-yes', 'answered-no');
      qCard.classList.add(val === 1 ? 'answered-yes' : 'answered-no');
    }

    render();
  });

  /* ============================
     UNIT TOGGLES
     ============================ */
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.unit-btn');
    if (!btn) return;
    var group = btn.getAttribute('data-unit-group');
    var unit = btn.getAttribute('data-unit');
    if (!group || !unit) return;

    // Toggle selected state in row
    var row = btn.closest('.unit-toggle-row');
    if (row) {
      var btns = row.querySelectorAll('.unit-btn');
      for (var i = 0; i < btns.length; i++) btns[i].classList.remove('selected');
    }
    btn.classList.add('selected');

    if (group === 'bmi') {
      bmiUnit = unit;
      document.getElementById('bmi-imperial').style.display = unit === 'imperial' ? '' : 'none';
      document.getElementById('bmi-metric').style.display = unit === 'metric' ? '' : 'none';
      // Clear old inputs
      clearBmiInputs();
      resetBmiResult();
    }

    if (group === 'neck') {
      neckUnit = unit;
      var neckLabel = document.getElementById('neck-unit-label');
      var neckInput = document.getElementById('neck-input');
      if (neckLabel) neckLabel.textContent = unit === 'cm' ? 'cm' : 'in';
      if (neckInput) {
        neckInput.value = '';
        neckInput.placeholder = unit === 'cm' ? '40' : '16';
      }
      var neckResult = document.getElementById('neck-result');
      if (neckResult) { neckResult.textContent = ''; neckResult.className = 'auto-result'; }
    }
  });

  function clearBmiInputs() {
    var ids = ['height-ft', 'height-in', 'weight-lbs', 'height-cm', 'weight-kg'];
    for (var i = 0; i < ids.length; i++) {
      var el = document.getElementById(ids[i]);
      if (el) el.value = '';
    }
  }

  function resetBmiResult() {
    var r = document.getElementById('bmi-result');
    if (r) { r.textContent = 'Enter height & weight to calculate'; r.className = 'calc-result'; }
  }

  /* ============================
     BMI AUTO-CALCULATION
     ============================ */
  function calcBMI() {
    var heightM, weightKg;

    if (bmiUnit === 'imperial') {
      var ft = parseFloat(document.getElementById('height-ft').value) || 0;
      var inch = parseFloat(document.getElementById('height-in').value) || 0;
      var lbs = parseFloat(document.getElementById('weight-lbs').value) || 0;
      if ((!ft && !inch) || !lbs) { resetBmiResult(); return; }
      var totalInches = (ft * 12) + inch;
      if (totalInches <= 0) { resetBmiResult(); return; }
      heightM = totalInches * 0.0254;
      weightKg = lbs * 0.453592;
    } else {
      var cm = parseFloat(document.getElementById('height-cm').value) || 0;
      var kg = parseFloat(document.getElementById('weight-kg').value) || 0;
      if (!cm || !kg) { resetBmiResult(); return; }
      heightM = cm / 100;
      weightKg = kg;
    }

    if (heightM <= 0 || weightKg <= 0) { resetBmiResult(); return; }

    var bmi = weightKg / (heightM * heightM);
    state.bmiValue = bmi;
    var resultEl = document.getElementById('bmi-result');

    if (bmi > 35) {
      resultEl.textContent = 'Your BMI: ' + bmi.toFixed(1) + ' — above 35';
      resultEl.className = 'calc-result over';
      setOptionBtn('bmi', 1);
    } else if (bmi >= 25) {
      resultEl.textContent = 'Your BMI: ' + bmi.toFixed(1) + ' — at or below 35';
      resultEl.className = 'calc-result warn';
      setOptionBtn('bmi', 0);
    } else {
      resultEl.textContent = 'Your BMI: ' + bmi.toFixed(1) + ' — at or below 35';
      resultEl.className = 'calc-result ok';
      setOptionBtn('bmi', 0);
    }
    render();
  }

  // Attach BMI listeners
  var bmiInputIds = ['height-ft', 'height-in', 'weight-lbs', 'height-cm', 'weight-kg'];
  for (var i = 0; i < bmiInputIds.length; i++) {
    var el = document.getElementById(bmiInputIds[i]);
    if (el) {
      el.addEventListener('input', calcBMI);
      el.addEventListener('change', calcBMI);
    }
  }

  /* ============================
     AGE AUTO-CALCULATION
     ============================ */
  function calcAge() {
    var ageInput = document.getElementById('age-input');
    var ageResult = document.getElementById('age-result');
    var age = parseInt(ageInput.value, 10);
    if (!age || isNaN(age) || age < 1) {
      ageResult.textContent = '';
      ageResult.className = 'auto-result';
      return;
    }
    state.ageValue = age;
    if (age > 50) {
      ageResult.textContent = 'Over 50 — Yes';
      ageResult.className = 'auto-result over';
      setOptionBtn('age', 1);
    } else {
      ageResult.textContent = '50 or under — No';
      ageResult.className = 'auto-result ok';
      setOptionBtn('age', 0);
    }
    render();
  }

  var ageEl = document.getElementById('age-input');
  if (ageEl) {
    ageEl.addEventListener('input', calcAge);
    ageEl.addEventListener('change', calcAge);
  }

  /* ============================
     NECK AUTO-CALCULATION
     ============================ */
  function calcNeck() {
    var neckInput = document.getElementById('neck-input');
    var neckResult = document.getElementById('neck-result');
    var val = parseFloat(neckInput.value);
    if (!val || isNaN(val) || val <= 0) {
      neckResult.textContent = '';
      neckResult.className = 'auto-result';
      return;
    }

    // Convert to cm for comparison
    var cm = neckUnit === 'cm' ? val : val * 2.54;
    state.neckValue = cm;

    if (cm > 40) {
      neckResult.textContent = (neckUnit === 'cm' ? '> 40 cm' : '> 16 in') + ' — Yes';
      neckResult.className = 'auto-result over';
      setOptionBtn('neck', 1);
    } else {
      neckResult.textContent = (neckUnit === 'cm' ? '≤ 40 cm' : '≤ 16 in') + ' — No';
      neckResult.className = 'auto-result ok';
      setOptionBtn('neck', 0);
    }
    render();
  }

  var neckEl = document.getElementById('neck-input');
  if (neckEl) {
    neckEl.addEventListener('input', calcNeck);
    neckEl.addEventListener('change', calcNeck);
  }

  /* ============================
     HELPER: Set option button programmatically
     ============================ */
  function setOptionBtn(comp, val) {
    state[comp] = val;
    var btns = document.querySelectorAll('.option-btn[data-comp="' + comp + '"]');
    for (var i = 0; i < btns.length; i++) {
      btns[i].classList.remove('selected');
      if (parseInt(btns[i].getAttribute('data-val'), 10) === val) {
        btns[i].classList.add('selected');
      }
    }
    // Style the question card
    var qCard = document.querySelector('.q-card[data-q="' + comp + '"]');
    if (qCard) {
      qCard.classList.remove('answered-yes', 'answered-no');
      qCard.classList.add(val === 1 ? 'answered-yes' : 'answered-no');
    }
  }

  /* ============================
     SCORE CALCULATION
     ============================ */
  function getScore() {
    var s = 0;
    var keys = ['snore', 'tired', 'observed', 'pressure', 'bmi', 'age', 'neck', 'gender'];
    for (var i = 0; i < keys.length; i++) {
      if (state[keys[i]] === 1) s++;
    }
    return s;
  }

  function getAnswered() {
    var n = 0;
    var keys = ['snore', 'tired', 'observed', 'pressure', 'bmi', 'age', 'neck', 'gender'];
    for (var i = 0; i < keys.length; i++) {
      if (state[keys[i]] !== -1) n++;
    }
    return n;
  }

  /* ============================
     INTERMEDIATE RISK REFINEMENT
     ============================ */
  function checkIntermediateRefinement(score) {
    if (score < 3 || score > 4) return null;

    // Count STOP yes answers
    var stopYes = 0;
    if (state.snore === 1) stopYes++;
    if (state.tired === 1) stopYes++;
    if (state.observed === 1) stopYes++;
    if (state.pressure === 1) stopYes++;

    // Check BANG risk factors
    var hasMale = state.gender === 1;
    var hasBmi = state.bmi === 1;
    var hasNeck = state.neck === 1;

    if (stopYes >= 2 && (hasMale || hasBmi || hasNeck)) {
      return {
        elevated: true,
        message: 'Although your total score is ' + score + ' (intermediate), you answered <strong>Yes to ' + stopYes + ' STOP questions</strong> AND have at least one additional risk factor (' +
          (hasMale ? 'male sex' : '') +
          (hasMale && (hasBmi || hasNeck) ? ', ' : '') +
          (hasBmi ? 'BMI > 35' : '') +
          ((hasBmi && hasNeck) ? ', ' : '') +
          (hasNeck ? 'neck > 40 cm' : '') +
          '). Per STOP-BANG refinement criteria, this <strong>reclassifies you as high risk</strong> for moderate-to-severe OSA. A formal sleep evaluation is recommended.'
      };
    }

    return {
      elevated: false,
      message: 'Your score of ' + score + ' is intermediate. If you had answered Yes to 2 or more STOP symptom questions AND any of: male sex, BMI > 35, or neck > 40 cm, you would be reclassified as high risk. Based on your current answers, you remain at intermediate risk.'
    };
  }

  /* ============================
     BUILD FACTOR BREAKDOWN
     ============================ */
  function buildFactors() {
    var html = '';
    for (var i = 0; i < factorMeta.length; i++) {
      var m = factorMeta[i];
      var val = state[m.key];
      var scored = val === 1;
      var unanswered = val === -1;
      var cls = scored ? 'scored' : 'not-scored';

      var icon;
      if (scored) {
        icon = '<svg class="factor-icon check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
      } else if (unanswered) {
        icon = '<svg class="factor-icon x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/></svg>';
      } else {
        icon = '<svg class="factor-icon x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
      }

      html += '<div class="factor-item ' + cls + '">' +
        icon +
        '<span class="factor-letter">' + m.letter + '</span>' +
        '<span>' + m.label + '</span>' +
      '</div>';
    }
    return html;
  }

  /* ============================
     BUILD RECOMMENDATIONS
     ============================ */
  function buildRecommendations(score, refined) {
    var effectiveRisk = score <= 2 ? 'low' : score <= 4 ? 'mid' : 'high';
    if (refined && refined.elevated) effectiveRisk = 'high';

    if (effectiveRisk === 'low') {
      return '<div class="reco-item reco-low">' +
        '<div class="reco-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>' +
        '<div><div class="reco-title">Maintain healthy sleep habits</div>' +
        '<div class="reco-desc">Your screening suggests low OSA risk. Continue to get 7-9 hours of sleep nightly, maintain a healthy weight, and avoid alcohol close to bedtime. Re-screen if new symptoms develop or risk factors change.</div></div></div>';
    }

    if (effectiveRisk === 'mid') {
      return '<div class="reco-item reco-mid">' +
        '<div class="reco-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>' +
        '<div><div class="reco-title">Discuss with your doctor</div>' +
        '<div class="reco-desc">Consider discussing your sleep with a doctor, especially if you snore regularly. They may recommend a home sleep apnea test or refer you to a sleep specialist for further evaluation, particularly if you have daytime sleepiness or hypertension.</div></div></div>';
    }

    return '<div class="reco-item reco-high">' +
      '<div class="reco-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#ff6b52" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>' +
      '<div><div class="reco-title">Seek a formal sleep study</div>' +
      '<div class="reco-desc">A formal sleep study (polysomnography or home sleep test) is strongly recommended. Ask your doctor for a referral to a sleep medicine specialist. Untreated OSA increases risk of cardiovascular disease, hypertension, and daytime impairment. Effective treatments like CPAP and oral appliances are available.</div></div></div>' +
      '<div class="reco-item reco-high">' +
      '<div class="reco-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#ff6b52" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg></div>' +
      '<div><div class="reco-title">Reduce modifiable risk factors now</div>' +
      '<div class="reco-desc">While awaiting evaluation: avoid alcohol within 3 hours of bedtime, sleep on your side rather than your back, and if overweight, even modest weight loss (5-10%) can meaningfully reduce apnea severity.</div></div></div>';
  }

  /* ============================
     RENDER
     ============================ */
  function render() {
    var score = getScore();
    var answered = getAnswered();

    // Score number
    var scoreNum = document.getElementById('score-num');
    if (scoreNum) scoreNum.textContent = score;

    // Ring
    setRing(score);

    // Risk class
    var hero = document.getElementById('score-hero');
    var badge = document.getElementById('risk-badge');
    var desc = document.getElementById('risk-desc');

    hero.className = 'score-hero';
    if (score <= 2) {
      hero.classList.add('risk-low');
      badge.textContent = 'Low Risk';
      desc.textContent = 'Score 0–2: Low probability of moderate-to-severe OSA';
    } else if (score <= 4) {
      hero.classList.add('risk-mid');
      badge.textContent = 'Intermediate Risk';
      desc.textContent = 'Score 3–4: Intermediate probability of moderate-to-severe OSA';
    } else {
      hero.classList.add('risk-high');
      badge.textContent = 'High Risk';
      desc.textContent = 'Score 5–8: High probability of moderate-to-severe OSA — evaluation recommended';
    }

    if (answered === 0) {
      desc.textContent = 'Answer the questions to see your risk assessment';
    }

    // Factor breakdown
    var factorGrid = document.getElementById('factor-grid');
    if (factorGrid) factorGrid.innerHTML = buildFactors();

    // Intermediate refinement
    var refineCard = document.getElementById('refine-card');
    var refineTitle = document.getElementById('refine-title');
    var refineText = document.getElementById('refine-text');
    var refined = checkIntermediateRefinement(score);

    if (refined && answered >= 4) {
      refineCard.style.display = 'flex';
      if (refined.elevated) {
        refineTitle.textContent = 'Reclassified: High Risk';
        refineCard.style.borderColor = '#ffd0c8';
        refineCard.style.background = '#fff6f4';
        refineTitle.style.color = '#9a1c10';
        refineText.style.color = '#7f1d1d';
        refineCard.querySelector('svg').setAttribute('stroke', '#ff6b52');
      } else {
        refineTitle.textContent = 'Intermediate Risk Refinement';
        refineCard.style.borderColor = '#fde68a';
        refineCard.style.background = '#fffbeb';
        refineTitle.style.color = '#92400e';
        refineText.style.color = '#78350f';
        refineCard.querySelector('svg').setAttribute('stroke', '#f59e0b');
      }
      refineText.innerHTML = refined.message;
    } else {
      refineCard.style.display = 'none';
    }

    // Recommendations
    var recoBody = document.getElementById('reco-body');
    if (recoBody) recoBody.innerHTML = buildRecommendations(score, refined);
  }

  /* ============================
     INIT
     ============================ */
  showSection(1);
  render();

})();
</script>

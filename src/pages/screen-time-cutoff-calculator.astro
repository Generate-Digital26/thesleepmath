  }
  .device-row.active .device-row-icon { background: #fff; border-color: var(--primary); color: var(--primary); }
  .device-row-icon svg { width: 15px; height: 15px; }
  .device-row-body { min-width: 0; }
  .device-row-name {
    font-size: 0.82rem; font-weight: 600; color: var(--text);
    display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.25rem;
  }
  .rank-tag {
    font-size: 0.62rem; font-weight: 700; padding: 0.1rem 0.4rem;
    border-radius: 10px; background: var(--primary-soft); color: var(--primary);
  }
  .device-bar-track { height: 5px; background: var(--border); border-radius: 3px; overflow: hidden; }
  .device-bar-fill { height: 100%; border-radius: 3px; transition: width 0.35s ease; }
  .device-row-lux { font-size: 0.75rem; font-weight: 700; color: var(--text-soft); white-space: nowrap; }

  .tip-item {
    display: flex; align-items: flex-start; gap: 0.65rem;
  }
  .tip-icon {
    width: 32px; height: 32px; border-radius: 8px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .tip-icon svg { width: 15px; height: 15px; }
  .tip-item p { font-size: 0.82rem; color: var(--text-mid); line-height: 1.55; margin: 0; padding-top: 0.3rem; }

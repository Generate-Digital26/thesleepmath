  /* =============================================
     DOM REFS
     ============================================= */
  var birthInput       = document.getElementById('birth-date');
  var issuesWrap       = document.getElementById('sleep-issues');
  var symptomWrap      = document.getElementById('symptom-score-wrap');
  var symptomBarFill   = document.getElementById('symptom-bar-fill');
  var symptomPct       = document.getElementById('symptom-pct');
  var symptomNote      = document.getElementById('symptom-note');
  var placeholderCard  = document.getElementById('placeholder-card');
  var ageSummaryCard   = document.getElementById('age-summary-card');
  var ageChip          = document.getElementById('age-chip');
  var ageMeta          = document.getElementById('age-meta');
  var stageBadgeWrap   = document.getElementById('stage-badge-wrap');
  var regTimelineCard  = document.getElementById('regression-timeline-card');
  var regTimelineWrap  = document.getElementById('reg-timeline-wrap');
  var regDetailCard    = document.getElementById('reg-detail-card');
  var regDetailHeader  = document.getElementById('reg-detail-header');
  var regDetailIcon    = document.getElementById('reg-detail-icon');
  var regDetailTitle   = document.getElementById('reg-detail-title');
  var regDetailSubtitle = document.getElementById('reg-detail-subtitle');
  var regStatDuration  = document.getElementById('reg-stat-duration');
  var regStatCause     = document.getElementById('reg-stat-cause');
  var regStrategyList  = document.getElementById('reg-strategy-list');
  var regWhenWorry     = document.getElementById('reg-when-worry');

  var selectedRegId = null;

  /* =============================================
     HELPERS
     ============================================= */
  function getAgeMonths(birthDate) {
    var now = new Date();
    var bd  = new Date(birthDate);
    var diffMs = now - bd;
    return diffMs / (1000 * 60 * 60 * 24 * 30.44);
  }

  function fmtAge(mo) {
    if (mo < 1) return Math.round(mo * 4) + ' weeks';
    if (mo < 12) {
      var w = Math.round((mo % 1) * 4.33);
      var m = Math.floor(mo);
      return m + ' month' + (m !== 1 ? 's' : '') + (w > 0 ? ' ' + w + 'w' : '');
    }
    var yr = Math.floor(mo / 12);
    var rem = Math.round(mo % 12);
    var yStr = yr + ' year' + (yr !== 1 ? 's' : '');
    return rem > 0 ? yStr + ' ' + rem + 'mo' : yStr;
  }

  function classifyRegression(reg, ageMo) {
    var center = reg.ageMo;
    var lo = reg.windowMo[0];
    var hi = reg.windowMo[1];
    if (ageMo >= lo && ageMo <= hi) return 'current';
    if (ageMo > hi) return 'past';
    if (ageMo < lo && (lo - ageMo) <= 3) return 'upcoming';
    return 'future';
  }

  function getIssueCount() {
    var boxes = issuesWrap.querySelectorAll('input[type="checkbox"]');
    var count = 0;
    boxes.forEach(function(b) { if (b.checked) count++; });
    return count;
  }

  /* =============================================
     RENDER TIMELINE
     ============================================= */
  function renderTimeline(ageMo) {
    /* Timeline spans 0–30 months for visibility */
    var MAX_MO = 30;

    /* Build track */
    var html = '<div class="reg-track">';

    /* Age marker */
    var agePct = Math.min(Math.max(ageMo / MAX_MO * 100, 0), 100).toFixed(2);
    html += '<div class="age-marker" style="left:' + agePct + '%;"></div>';

    /* Regression segments */
    REGRESSIONS.forEach(function(reg) {
      var loP = (reg.windowMo[0] / MAX_MO * 100).toFixed(2);
      var hiP = (reg.windowMo[1] / MAX_MO * 100).toFixed(2);
      var wP  = (hiP - loP).toFixed(2);
      var cls = classifyRegression(reg, ageMo);
      html += '<div class="reg-seg ' + cls + '"';
      html += ' style="left:' + loP + '%;width:' + wP + '%;"';
      html += ' data-reg-id="' + reg.id + '" title="' + reg.label + ' regression">';
      html += '</div>';
    });

    html += '</div>'; /* end .reg-track */

    /* Labels row */
    html += '<div class="reg-labels-row">';
    REGRESSIONS.forEach(function(reg) {
      var centerP = (reg.ageMo / MAX_MO * 100).toFixed(2);
      var cls = classifyRegression(reg, ageMo);
      html += '<div class="reg-label ' + cls + '" style="left:' + centerP + '%;" data-reg-id="' + reg.id + '">';
      html += '<div class="reg-label-tick"></div>';
      html += '<div class="reg-label-age">' + reg.label + '</div>';
      html += '</div>';
    });
    html += '</div>'; /* end .reg-labels-row */

    regTimelineWrap.innerHTML = html;

    /* Attach click handlers */
    regTimelineWrap.querySelectorAll('[data-reg-id]').forEach(function(el) {
      el.addEventListener('click', function() {
        var id = el.getAttribute('data-reg-id');
        openRegDetail(id, ageMo);
      });
    });
  }

  /* =============================================
     RENDER DETAIL CARD
     ============================================= */
  function openRegDetail(id, ageMo) {
    var reg = REGRESSIONS.find(function(r) { return r.id === id; });
    if (!reg) return;

    selectedRegId = id;
    var cls = classifyRegression(reg, ageMo);

    /* Header */
    regDetailIcon.style.background = reg.bgColor;
    regDetailIcon.textContent = reg.emoji;
    regDetailTitle.textContent = reg.label.charAt(0).toUpperCase() + reg.label.slice(1) + ' sleep regression';
    var statusLabel = cls === 'current' ? 'Currently active' : cls === 'past' ? 'Already passed' : cls === 'upcoming' ? 'Coming up soon' : 'Future window';
    regDetailSubtitle.textContent = statusLabel + ' · Window: ' + reg.windowMo[0] + '–' + reg.windowMo[1] + ' months';

    /* Stats */
    regStatDuration.textContent = reg.duration;
    regStatCause.textContent = reg.cause;

    /* Strategies */
    var stratHtml = '';
    reg.strategies.forEach(function(s) {
      stratHtml += '<li>' + s + '</li>';
    });
    regStrategyList.innerHTML = stratHtml;

    /* When to worry */
    regWhenWorry.textContent = reg.whenToWorry;

    /* Show card */
    regDetailCard.style.display = 'block';

    /* Scroll into view smoothly */
    regDetailCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  /* =============================================
     RENDER AGE SUMMARY
     ============================================= */
  function renderAgeSummary(ageMo) {
    ageChip.textContent = fmtAge(ageMo) + ' old';

    /* Find current and next regressions */
    var currentReg = null;
    var nextReg    = null;
    var minFutureDiff = Infinity;

    REGRESSIONS.forEach(function(reg) {
      var cls = classifyRegression(reg, ageMo);
      if (cls === 'current' && !currentReg) currentReg = reg;
      if ((cls === 'upcoming' || cls === 'future') && reg.ageMo > ageMo) {
        var diff = reg.ageMo - ageMo;
        if (diff < minFutureDiff) {
          minFutureDiff = diff;
          nextReg = reg;
        }
      }
    });

    if (currentReg) {
      ageMeta.textContent = 'Currently in the ' + currentReg.label + ' regression window';
    } else if (nextReg) {
      var moUntil = (nextReg.windowMo[0] - ageMo).toFixed(1);
      ageMeta.textContent = 'Next regression (~' + nextReg.label + ') in about ' + moUntil + ' months';
    } else {
      ageMeta.textContent = 'All major regression windows are in the past — well done!';
    }

    /* Badges */
    var badgeHtml = '';
    if (currentReg) {
      badgeHtml += '<span style="font-size:0.68rem;font-weight:700;padding:0.2rem 0.55rem;border-radius:99px;background:#fff0ed;color:#ff6b52;">Active regression</span>';
    }
    var issueCount = getIssueCount();
    if (issueCount >= 3) {
      badgeHtml += '<span style="font-size:0.68rem;font-weight:700;padding:0.2rem 0.55rem;border-radius:99px;background:#fffbeb;color:#f59e0b;">' + issueCount + '/5 signs present</span>';
    }
    stageBadgeWrap.innerHTML = badgeHtml;
  }

  /* =============================================
     RENDER SYMPTOM SCORE
     ============================================= */
  function renderSymptomScore(ageMo) {
    var count = getIssueCount();
    if (count === 0) {
      symptomWrap.style.display = 'none';
      return;
    }
    symptomWrap.style.display = 'block';

    /* Find if near a regression */
    var nearReg = REGRESSIONS.find(function(r) {
      return classifyRegression(r, ageMo) === 'current';
    });

    var baseScore = count / 5;
    var nearBoost = nearReg ? 0.15 : 0;
    var score = Math.min(baseScore + nearBoost, 1);
    var pctVal = Math.round(score * 100);

    symptomBarFill.style.width = pctVal + '%';
    symptomPct.textContent = pctVal + '%';

    if (pctVal >= 75) {
      symptomNote.textContent = 'Strong match with regression pattern — ' + (nearReg ? 'aligns with the ' + nearReg.label + ' window' : 'consider tracking for a week');
    } else if (pctVal >= 40) {
      symptomNote.textContent = 'Moderate regression likelihood — check the timeline for nearby windows';
    } else {
      symptomNote.textContent = 'A few signs present — could be developmental or environmental disruption';
    }
  }

  /* =============================================
     MAIN UPDATE FUNCTION
     ============================================= */
  function update() {
    var val = birthInput.value;
    if (!val) {
      placeholderCard.style.display = 'flex';
      ageSummaryCard.style.display = 'none';
      regTimelineCard.style.display = 'none';
      regDetailCard.style.display = 'none';
      symptomWrap.style.display = 'none';
      return;
    }

    var ageMo = getAgeMonths(val);

    if (ageMo < 0 || ageMo > 60) {
      placeholderCard.style.display = 'flex';
      ageSummaryCard.style.display = 'none';
      regTimelineCard.style.display = 'none';
      regDetailCard.style.display = 'none';
      return;
    }

    placeholderCard.style.display = 'none';
    ageSummaryCard.style.display = 'flex';
    regTimelineCard.style.display = 'block';

    renderAgeSummary(ageMo);
    renderTimeline(ageMo);
    renderSymptomScore(ageMo);

    /* Auto-open current or next regression detail */
    if (!selectedRegId) {
      var autoReg = REGRESSIONS.find(function(r) { return classifyRegression(r, ageMo) === 'current'; });
      if (!autoReg) {
        var minDiff = Infinity;
        REGRESSIONS.forEach(function(r) {
          var d = r.ageMo - ageMo;
          if (d > 0 && d < minDiff) { minDiff = d; autoReg = r; }
        });
      }
      if (autoReg) openRegDetail(autoReg.id, ageMo);
    } else {
      openRegDetail(selectedRegId, ageMo);
    }
  }

  /* =============================================
     SET DEFAULT DATE (today minus 4 months for demo)
     ============================================= */
  (function setDefaultDate() {
    var d = new Date();
    d.setMonth(d.getMonth() - 4);
    var yyyy = d.getFullYear();
    var mm   = String(d.getMonth() + 1).padStart(2, '0');
    var dd   = String(d.getDate()).padStart(2, '0');
    birthInput.value = yyyy + '-' + mm + '-' + dd;
  })();

  /* =============================================
     EVENT LISTENERS
     ============================================= */
  birthInput.addEventListener('input', function() {
    selectedRegId = null;
    update();
  });

  issuesWrap.addEventListener('change', function() {
    var ageMo = birthInput.value ? getAgeMonths(birthInput.value) : null;
    if (ageMo !== null) {
      renderAgeSummary(ageMo);
      renderSymptomScore(ageMo);
    }
  });

  /* =============================================
     INIT
     ============================================= */
  update();

})();
</script>

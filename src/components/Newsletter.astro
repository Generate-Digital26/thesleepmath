---
---

<section class="news-section">
  <div class="news-inner">
    <h2>One email a week on sleep</h2>
    <p>New tools, research breakdowns, product reviews. No spam, unsubscribe anytime.</p>
    <form class="news-form" data-newsletter>
      <input type="email" placeholder="you@email.com" required />
      <button type="submit">Subscribe</button>
    </form>
  </div>
</section>

<style>
  .news-section {
    padding: 4rem 0;
    background: var(--bg-tint);
    border-top: 1px solid var(--border);
  }

  .news-inner {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
  }

  h2 {
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.45rem;
  }

  p {
    font-size: 0.92rem;
    color: var(--text-mid);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .news-form {
    display: flex;
    gap: 0.5rem;
  }

  .news-form input {
    flex: 1;
    padding: 0.7rem 1rem;
    background: var(--card);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
  }

  .news-form input:focus {
    border-color: var(--primary);
  }

  .news-form input::placeholder {
    color: var(--text-soft);
  }

  .news-form button {
    padding: 0.7rem 1.25rem;
    background: var(--primary);
    color: #fff;
    font-weight: 700;
    font-size: 0.88rem;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
    transition: background 0.15s;
  }

  .news-form button:hover {
    background: var(--primary-hover);
  }

  @media (max-width: 768px) {
    .news-form {
      flex-direction: column;
    }
  }
</style>

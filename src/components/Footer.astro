---
const year = new Date().getFullYear();
---

<footer>
  <div class="foot-inner">
    <div class="foot-left">The Sleep Math &middot; {year}</div>
    <div class="foot-links">
      <a href="/#calcs">Calculators</a>
      <a href="/guides">Guides</a>
      <a href="/blog">Blog</a>
      <a href="/about">About</a>
      <a href="/privacy">Privacy</a>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 1.75rem 2rem;
  }

  .foot-inner {
    max-width: 1060px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .foot-left {
    font-size: 0.82rem;
    color: var(--text-soft);
    font-weight: 500;
  }

  .foot-links {
    display: flex;
    gap: 1.25rem;
  }

  .foot-links a {
    color: var(--text-soft);
    font-size: 0.82rem;
    font-weight: 500;
    transition: color 0.15s;
  }

  .foot-links a:hover {
    color: var(--text-mid);
  }

  @media (max-width: 768px) {
    .foot-inner {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }
</style>

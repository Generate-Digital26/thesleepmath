---
const year = new Date().getFullYear();
---

<footer>
  <div class="foot-inner">
    <div class="foot-left">The Sleep Math &middot; {year}</div>
    <div class="foot-links">
      <a href="/#calcs">Calculators</a>
      <a href="/guides">Guides</a>
      <a href="/blog">Blog</a>
      <a href="/about">About</a>
      <a href="/privacy">Privacy</a>
      <a href="https://www.youtube.com/@TheSleepMath" target="_blank" rel="noopener noreferrer" class="foot-yt" aria-label="YouTube">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.9 31.9 0 0 0 0 12a31.9 31.9 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.9 31.9 0 0 0 24 12a31.9 31.9 0 0 0-.5-5.8zM9.5 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg>
      </a>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 1.75rem 2rem;
  }

  .foot-inner {
    max-width: 1060px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .foot-left {
    font-size: 0.82rem;
    color: var(--text-soft);
    font-weight: 500;
  }

  .foot-links {
    display: flex;
    gap: 1.25rem;
  }

  .foot-links a {
    color: var(--text-soft);
    font-size: 0.82rem;
    font-weight: 500;
    transition: color 0.15s;
  }

  .foot-links a:hover {
    color: var(--text-mid);
  }

  .foot-yt {
    display: inline-flex;
    align-items: center;
  }

  @media (max-width: 768px) {
    .foot-inner {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }
</style>

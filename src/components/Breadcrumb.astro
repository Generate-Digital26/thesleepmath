---
interface Props {
  /** Display name of the current page */
  current: string;
  /** Full URL path of the current page, e.g. /caffeine-cutoff-calculator */
  currentPath?: string;
}

const { current, currentPath } = Astro.props;
const siteUrl = 'https://thesleepmath.com';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Calculators',
      item: `${siteUrl}/#calcs`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: current,
      ...(currentPath ? { item: `${siteUrl}${currentPath}` } : {}),
    },
  ],
};
---

<div class="breadcrumb">
  <a href="/">Home</a>
  <span class="sep">/</span>
  <a href="/#calcs">Calculators</a>
  <span class="sep">/</span>
  {current}
</div>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<style>
  .breadcrumb {
    max-width: 920px;
    margin: 0 auto;
    padding: 1.5rem 2rem 0;
    font-size: 0.78rem;
    color: var(--text-soft);
    font-weight: 500;
  }

  .breadcrumb a {
    color: var(--text-soft);
    transition: color 0.15s;
  }

  .breadcrumb a:hover {
    color: var(--primary);
  }

  .sep {
    margin: 0 0.35rem;
    opacity: 0.4;
  }

  @media (max-width: 768px) {
    .breadcrumb {
      padding: 1.25rem 1.25rem 0;
    }
  }
</style>

---
export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.replace(/<[^>]*>/g, ''),
    },
  })),
};
---

<section class="faq-section">
  <div class="container">
    <h2 class="faq-heading">Frequently asked questions</h2>
    <div class="faq-list">
      {items.map((item, i) => (
        <details class="faq-item">
          <summary class="faq-question">
            <span>{item.question}</span>
            <svg class="faq-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="faq-answer" set:html={item.answer} />
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-section {
    padding: 4rem 2rem;
    background: var(--bg-warm, #f5f4f1);
  }

  .faq-heading {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text, #1e1b2e);
    margin-bottom: 2rem;
    text-align: center;
  }

  .faq-list {
    max-width: 740px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: var(--card, #ffffff);
    border: 1px solid var(--border, #e4e1ec);
    border-radius: var(--radius-sm, 10px);
    overflow: hidden;
    transition: border-color 0.15s;
  }

  .faq-item:hover {
    border-color: var(--border-hover, #d0cce0);
  }

  .faq-item[open] {
    border-color: var(--border-hover, #d0cce0);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.35rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text, #1e1b2e);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color 0.15s;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::marker {
    display: none;
    content: '';
  }

  .faq-question:hover {
    color: var(--primary, #7c6aff);
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--text-soft, #7c778e);
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 1.35rem 1.25rem;
    font-size: 0.88rem;
    line-height: 1.72;
    color: var(--text-mid, #4a4560);
  }

  .faq-answer :global(p) {
    margin-bottom: 0.85rem;
  }

  .faq-answer :global(p:last-child) {
    margin-bottom: 0;
  }

  .faq-answer :global(strong) {
    color: var(--text, #1e1b2e);
    font-weight: 600;
  }

  .faq-answer :global(a) {
    color: var(--primary, #7c6aff);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .faq-answer :global(a:hover) {
    color: var(--primary-hover, #6858e8);
  }

  @media (max-width: 768px) {
    .faq-section {
      padding: 3rem 1.25rem;
    }

    .faq-heading {
      font-size: 1.4rem;
    }

    .faq-question {
      font-size: 0.9rem;
      padding: 1rem 1.1rem;
    }

    .faq-answer {
      padding: 0 1.1rem 1.1rem;
      font-size: 0.84rem;
    }
  }
</style>

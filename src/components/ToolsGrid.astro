---
/**
 * ToolsGrid — the "Tools Mentioned in This Guide / Article" card grid used at
 * the foot of long-form pages.
 *
 * Single source of truth: pulls icon, iconColor, and pageTitle from
 * src/data/calculators.ts. To change a card's label, edit the calculator's
 * `pageTitle` field there — every guide and blog post that mentions it picks
 * up the change automatically.
 *
 * Usage:
 *   <ToolsGrid
 *     slugs={['circadian-rhythm-calculator', 'chronotype-quiz', 'light-exposure-calculator']}
 *     heading="Tools Mentioned in This Guide"
 *   />
 *
 * Defaults: heading = "Tools Mentioned in This Guide". Pass "...This Article"
 * (or anything else) for blog posts.
 *
 * Unknown slugs are skipped silently in production; a console warning is
 * emitted during build so missing references are surfaced.
 */
import { calculators, iconStrokeColors } from '@/data/calculators';

export interface Props {
  slugs: string[];
  heading?: string;
}

const { slugs, heading = 'Tools Mentioned in This Guide' } = Astro.props;

// Build an ordered list of resolved calc entries, skipping unknown slugs.
const lookup = new Map(calculators.map((c) => [c.slug, c]));
const resolved = slugs
  .map((slug) => {
    const calc = lookup.get(slug);
    if (!calc) {
      // eslint-disable-next-line no-console
      console.warn(`[ToolsGrid] Unknown calculator slug: "${slug}"`);
      return null;
    }
    return calc;
  })
  .filter((c): c is NonNullable<typeof c> => c !== null);
---

{resolved.length > 0 && (
  <div class="calc-cta">
    <h3>{heading}</h3>
    <div class="calc-cta-grid">
      {resolved.map((calc) => (
        <a href={`/${calc.slug}`} class="calc-cta-card">
          <span class={`calc-cta-icon iconColor-${calc.iconColor}`}>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke={iconStrokeColors[calc.iconColor]}
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={calc.iconPath}
            />
          </span>
          <span class="calc-cta-name">{calc.pageTitle}</span>
        </a>
      ))}
    </div>
  </div>
)}

<style is:global>
  /* ── Tools Mentioned grid (shared across guides and blog posts) ── */
  .calc-cta {
    margin: 3rem 0 2rem;
    padding: 1.75rem;
    background: var(--bg-alt, #f8f9fb);
    border: 1px solid var(--border);
    border-radius: 14px;
  }
  .calc-cta h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 1rem !important;
    color: var(--text);
  }
  .calc-cta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 10px;
  }
  .calc-cta-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 0.85rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none !important;
    color: var(--text) !important;
    font-size: 0.82rem;
    font-weight: 600;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .calc-cta-card:hover {
    border-color: var(--primary);
    box-shadow: 0 2px 8px rgba(124, 106, 255, 0.1);
  }
  .calc-cta-icon {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: rgba(124, 106, 255, 0.12);
  }
  .calc-cta-icon svg {
    width: 16px;
    height: 16px;
  }
  .calc-cta-icon.iconColor-primary { background: rgba(124, 106, 255, 0.12); }
  .calc-cta-icon.iconColor-coral   { background: rgba(255, 107, 82, 0.12); }
  .calc-cta-icon.iconColor-rose    { background: rgba(236, 72, 153, 0.12); }
  .calc-cta-icon.iconColor-mint    { background: rgba(16, 185, 129, 0.12); }
  .calc-cta-icon.iconColor-sky     { background: rgba(56, 182, 255, 0.12); }
  .calc-cta-icon.iconColor-amber   { background: rgba(245, 158, 11, 0.12); }

  @media (max-width: 768px) {
    .calc-cta-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .calc-cta-grid { grid-template-columns: 1fr; }
  }
</style>

---
const steps = [
  {
    num: 1,
    numClass: 's1',
    title: 'Pick your problem',
    desc: "Each calculator tackles one specific sleep question. Start wherever you're curious.",
  },
  {
    num: 2,
    numClass: 's2',
    title: 'Enter a few things',
    desc: 'Bedtime, wake time, coffee intake — quick inputs. Most take 30–60 seconds.',
  },
  {
    num: 3,
    numClass: 's3',
    title: 'Get a real answer',
    desc: 'Not generic tips. A specific, personalized result backed by the actual study.',
  },
];
---

<section class="how-section">
  <div class="container">
    <h2>How it works</h2>
    <div class="how-steps">
      {steps.map((step) => (
        <div class="step-card">
          <div class={`step-num ${step.numClass}`}>{step.num}</div>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how-section {
    padding: 4rem 0;
    background: var(--bg-tint);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  h2 {
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
    text-align: center;
  }

  .how-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .step-card {
    background: var(--card);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-align: center;
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-weight: 800;
    font-size: 0.88rem;
    margin-bottom: 0.85rem;
  }

  .step-card h3 {
    font-size: 1.02rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .step-card p {
    font-size: 0.88rem;
    color: var(--text-mid);
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .how-steps {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
